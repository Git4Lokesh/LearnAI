<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join as Teacher — Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .form-floating { margin-bottom: 0.75rem; }
        .form-control { background: rgba(10,15,30,0.8); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 0.95rem; }
        .form-control:focus { background: rgba(10,15,30,0.9); border-color: var(--gold); box-shadow: 0 0 0 3px rgba(245,158,11,0.15); color: var(--text); }
        .welcome-badge {
            background: var(--glass-bg); backdrop-filter: blur(12px);
            border: 1px solid rgba(245,158,11,0.25); border-radius: var(--radius-lg);
            padding: 1.25rem; text-align: center; margin-bottom: 1.5rem;
        }
        .welcome-badge .icon { font-size: 2rem; color: var(--purple-light); margin-bottom: 0.5rem; }
        .welcome-badge .institute { color: var(--gold); font-weight: 700; font-size: 1.1rem; }
        .welcome-badge .role { color: var(--purple-light); font-size: 0.85rem; margin-top: 4px; }
        .email-display { background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.2); border-radius: var(--radius); padding: 10px 14px; color: var(--gold); font-size: 0.9rem; margin-bottom: 1rem; text-align: center; }
    </style>
</head>
<body>
<div class="auth-wrap">
    <div class="auth-left">
        <div class="auth-card auth-card--bordered">
            <div class="auth-brand"><i class="bi bi-diagram-3-fill"></i><span>Learn.ai</span></div>

            <div class="welcome-badge">
                <div class="icon"><i class="bi bi-person-workspace"></i></div>
                <div class="institute"><%= invite.institute_name %></div>
                <div class="role"><i class="bi bi-shield-check"></i> Teacher Account</div>
            </div>

            <div class="email-display"><i class="bi bi-envelope me-2"></i><%= invite.email %></div>

            <% if (error) { %>
                <div class="error-msg"><i class="bi bi-exclamation-circle me-1"></i><%= error %></div>
            <% } %>

            <form method="POST" action="/invite/teacher/<%= invite.token %>">
                <div class="form-floating">
                    <input type="text" class="form-control" id="fullName" name="fullName" placeholder="Your Name" required>
                    <label for="fullName">Full Name</label>
                </div>
                <div class="form-floating">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Password" required minlength="6">
                    <label for="password">Create Password</label>
                </div>
                <button type="submit" class="btn-auth btn-auth--gold-border mt-2">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Create Teacher Account
                </button>
            </form>

            <div class="auth-footer">
                <p>Already have an account? <a href="/login">Sign in</a></p>
            </div>
        </div>
    </div>

    <div class="auth-right">
        <div class="journey">
            <div class="journey-title text-gradient">Welcome, Teacher</div>
            <p class="journey-sub">You've been invited to join <strong style="color:var(--gold);"><%= invite.institute_name %></strong> on Learn.ai. Set up your account to start creating assignments and tracking student mastery.</p>
            <div class="timeline">
                <div class="tl-step">
                    <div class="tl-dot"><i class="bi bi-person-check"></i></div>
                    <div class="tl-label">Set Up Account</div>
                    <div class="tl-desc">Enter your name and create a password</div>
                </div>
                <div class="tl-step">
                    <div class="tl-dot"><i class="bi bi-collection"></i></div>
                    <div class="tl-label">Create Batches</div>
                    <div class="tl-desc">Organize students into batches and share invite links</div>
                </div>
                <div class="tl-step">
                    <div class="tl-dot"><i class="bi bi-clipboard-data"></i></div>
                    <div class="tl-label">Assign Work</div>
                    <div class="tl-desc">Create assignments from the question bank in seconds</div>
                </div>
                <div class="tl-step">
                    <div class="tl-dot"><i class="bi bi-graph-up"></i></div>
                    <div class="tl-label">Track Mastery</div>
                    <div class="tl-desc">See real-time concept-wise analytics for every student</div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
