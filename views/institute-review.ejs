<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review Questions - Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Page-specific: question card, edit form */
        .question-text { font-size: 1.05rem; color: var(--text); margin-bottom: 1rem; line-height: 1.6; }
        .meta-badges { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
        .btn-save-edit { background: var(--gradient-purple); border: 2px solid var(--gold); color: white; font-weight: 600; padding: 0.5rem 1.25rem; border-radius: 10px; transition: var(--transition-slow); }
        .btn-save-edit:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 4px 16px rgba(124,58,237,0.4); color: white; }
        .form-control, .form-select { background: rgba(10,15,30,0.8); border: 2px solid var(--border-light); border-radius: 12px; color: var(--text); padding: 0.75rem 1rem; transition: var(--transition-slow); }
        .form-control:focus, .form-select:focus { background: rgba(10,15,30,0.9); border-color: var(--gold); box-shadow: 0 0 0 0.25rem rgba(245,158,11,0.25); color: var(--text); }
        .form-select option { background: var(--card); color: var(--text); }
    </style>
</head>
<body class="bg-alt">
    <div class="page-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <h1><i class="bi bi-clipboard-check me-2"></i>Review Questions</h1>
                <a href="/" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-dark-danger p-3 mb-3" role="alert"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert-dark-success p-3 mb-3" role="alert"><i class="bi bi-check-circle me-2"></i><%= success %></div>
        <% } %>

        <!-- Stats Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="stat-card stat-card--sm stat-pending animate-in"><div class="stat-value"><%= stats.pending %></div><div class="stat-label">Pending Review</div></div></div>
            <div class="col-md-4"><div class="stat-card stat-card--sm stat-approved animate-in" style="animation-delay:0.05s"><div class="stat-value"><%= stats.approved %></div><div class="stat-label">Approved</div></div></div>
            <div class="col-md-4"><div class="stat-card stat-card--sm stat-rejected animate-in" style="animation-delay:0.1s"><div class="stat-value"><%= stats.rejected %></div><div class="stat-label">Rejected</div></div></div>
        </div>

        <div class="section-label" style="font-size: 1rem;">Pending Questions (<%= questions.length %>)</div>

        <% if (questions.length === 0) { %>
            <div class="empty-state empty-state--card">
                <i class="bi bi-inbox"></i>
                <h5>No pending questions</h5>
                <p>All questions have been reviewed. Upload more questions to get started.</p>
                <a href="/institute/questions/upload" class="btn-edit-toggle mt-2" style="display:inline-block;padding:8px 16px;text-decoration:none;"><i class="bi bi-cloud-upload me-1"></i> Upload Questions</a>
            </div>
        <% } else { %>
            <% questions.forEach(function(q, index) { %>
            <div class="question-card-review">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span style="color: var(--text-muted); font-size: 0.8rem;">#<%= q.id %></span>
                    <span style="color: var(--text-muted); font-size: 0.8rem;"><%= new Date(q.created_at).toLocaleDateString() %></span>
                </div>
                <div class="question-text"><%= q.question_text %></div>
                <div class="options-grid">
                    <div class="option-item <%= q.correct_answer == 1 ? 'correct' : '' %>"><strong>A.</strong> <%= q.option1 %><% if (q.correct_answer == 1) { %> <i class="bi bi-check-circle-fill"></i><% } %></div>
                    <div class="option-item <%= q.correct_answer == 2 ? 'correct' : '' %>"><strong>B.</strong> <%= q.option2 %><% if (q.correct_answer == 2) { %> <i class="bi bi-check-circle-fill"></i><% } %></div>
                    <div class="option-item <%= q.correct_answer == 3 ? 'correct' : '' %>"><strong>C.</strong> <%= q.option3 %><% if (q.correct_answer == 3) { %> <i class="bi bi-check-circle-fill"></i><% } %></div>
                    <div class="option-item <%= q.correct_answer == 4 ? 'correct' : '' %>"><strong>D.</strong> <%= q.option4 %><% if (q.correct_answer == 4) { %> <i class="bi bi-check-circle-fill"></i><% } %></div>
                </div>
                <% if (q.solution) { %>
                    <div class="solution-text"><strong style="color: var(--gold);">Solution:</strong> <%= q.solution %></div>
                <% } %>
                <div class="meta-badges">
                    <% if (q.concept_name) { %>
                        <span class="meta-badge"><i class="bi bi-tag"></i> <%= q.concept_name %>
                            <% if (q.concept_confidence != null) { %>
                                <span class="confidence-bar"><span class="confidence-fill" style="width: <%= (q.concept_confidence * 100) %>%; background: <%= q.concept_confidence >= 0.6 ? 'var(--green-light)' : 'var(--red-light)' %>;"></span></span>
                                <%= (q.concept_confidence * 100).toFixed(0) %>%
                            <% } %>
                        </span>
                    <% } else { %>
                        <span class="meta-badge review-flag"><i class="bi bi-tag"></i> No concept assigned</span>
                    <% } %>
                    <span class="meta-badge"><i class="bi bi-speedometer2"></i> Tier <%= q.difficulty_tier || 2 %></span>
                    <% if (q.needs_review_tag) { %>
                        <span class="meta-badge review-flag"><i class="bi bi-exclamation-triangle"></i> Needs Review</span>
                    <% } %>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <form method="POST" action="/institute/questions/review/<%= q.id %>" style="display:inline;"><input type="hidden" name="action" value="approve"><button type="submit" class="btn-approve"><i class="bi bi-check-lg me-1"></i> Approve</button></form>
                    <form method="POST" action="/institute/questions/review/<%= q.id %>" style="display:inline;"><input type="hidden" name="action" value="reject"><button type="submit" class="btn-reject"><i class="bi bi-x-lg me-1"></i> Reject</button></form>
                    <button type="button" class="btn-edit-toggle" onclick="toggleEdit(<%= q.id %>)"><i class="bi bi-pencil me-1"></i> Edit & Approve</button>
                </div>
                <div class="edit-panel" id="edit-panel-<%= q.id %>">
                    <form method="POST" action="/institute/questions/review/<%= q.id %>">
                        <input type="hidden" name="action" value="edit">
                        <div class="mb-3">
                            <label class="form-label" style="color: var(--text-secondary); font-size: 0.85rem;">Question Text</label>
                            <textarea class="form-control" name="question_text" rows="3"><%= q.question_text %></textarea>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label" style="color: var(--text-secondary); font-size: 0.85rem;">Concept</label>
                                <select class="form-select" name="concept_id">
                                    <option value="">-- Select Concept --</option>
                                    <% concepts.forEach(function(c) { %><option value="<%= c.id %>" <%= q.concept_id == c.id ? 'selected' : '' %>><%= c.name %></option><% }); %>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" style="color: var(--text-secondary); font-size: 0.85rem;">Difficulty Tier</label>
                                <select class="form-select" name="difficulty_tier">
                                    <option value="1" <%= q.difficulty_tier == 1 ? 'selected' : '' %>>1 — Easy</option>
                                    <option value="2" <%= (q.difficulty_tier == 2 || !q.difficulty_tier) ? 'selected' : '' %>>2 — Medium</option>
                                    <option value="3" <%= q.difficulty_tier == 3 ? 'selected' : '' %>>3 — Hard</option>
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-save-edit"><i class="bi bi-check2-circle me-1"></i> Save & Approve</button>
                    </form>
                </div>
            </div>
            <% }); %>
        <% } %>
    </div>

    <script>
    function toggleEdit(questionId) {
        const panel = document.getElementById('edit-panel-' + questionId);
        panel.classList.toggle('active');
    }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
