<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submissions — <%= assignment.title %> — Learn.ai</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        .page-wrap { max-width: 1100px; margin: 0 auto; padding: 2rem 1rem; }

        .top-bar {
            background: var(--gradient-header); border-bottom: 2px solid var(--gold);
            padding: 1.25rem 2rem; display: flex; justify-content: space-between; align-items: center;
            position: relative; overflow: hidden;
        }
        .top-bar::after {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(ellipse at 80% 50%, rgba(245,158,11,0.08) 0%, transparent 60%);
            pointer-events: none;
        }
        .top-bar .title { font-size: 1.4rem; font-weight: 700; color: var(--gold); display: flex; align-items: center; gap: 10px; position: relative; z-index: 1; }
        .top-bar .actions { position: relative; z-index: 1; }

        .page-title { font-size: 1.4rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem; }
        .page-subtitle { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem; }

        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
        .stat-card {
            background: var(--glass-bg); backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur));
            border: 1px solid var(--glass-border); border-radius: var(--radius-lg);
            padding: 1.25rem; text-align: center; box-shadow: var(--shadow-sm);
            transition: var(--transition-slow); position: relative; overflow: hidden;
        }
        .stat-card::before {
            content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
            background: radial-gradient(circle, rgba(245,158,11,0.05) 0%, transparent 70%);
            opacity: 0; transition: opacity 0.4s ease; pointer-events: none;
        }
        .stat-card:hover::before { opacity: 1; }
        .stat-card:hover { border-color: rgba(245,158,11,0.3); box-shadow: var(--shadow-lg), var(--shadow-glow-gold); transform: translateY(-3px); }
        .stat-card .val { font-size: 1.6rem; font-weight: 700; }
        .stat-card .val.green { color: var(--green); }
        .stat-card .val.gold { color: var(--gold); }
        .stat-card .val.red { color: var(--red); }
        .stat-card .val.purple { color: var(--purple-light); }
        .stat-card .label { font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.5px; margin-top: 4px; }

        .section-title { font-size: 1.05rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1rem; display: flex; align-items: center; gap: 8px; }

        .table-wrap {
            overflow-x: auto; margin-bottom: 2rem;
            background: var(--glass-bg); backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur));
            border: 1px solid var(--glass-border); border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm); padding: 0;
        }
        table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
        th { text-align: left; padding: 12px 14px; color: var(--gold); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid rgba(245,158,11,0.15); font-weight: 600; background: rgba(245,158,11,0.04); }
        td { padding: 10px 14px; border-bottom: 1px solid var(--glass-border); color: var(--text); }
        tr { transition: var(--transition); }
        tr:hover td { background: rgba(245,158,11,0.03); }

        .status-pill { font-size: 0.7rem; font-weight: 600; padding: 3px 8px; border-radius: var(--radius-pill); }
        .status-pill.completed { background: rgba(16,185,129,0.15); color: var(--green); }
        .status-pill.pending { background: rgba(245,158,11,0.15); color: var(--gold); }
        .status-pill.missed { background: rgba(239,68,68,0.15); color: var(--red); }

        .concept-breakdown { margin-top: 0.5rem; }
        .concept-row { display: flex; align-items: center; gap: 8px; font-size: 0.78rem; padding: 3px 0; }
        .concept-bar-bg { flex: 1; height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; max-width: 100px; }
        .concept-bar { height: 100%; border-radius: 3px; }
        .concept-pct { font-size: 0.72rem; color: var(--text-muted); width: 36px; text-align: right; }

        .btn-back { color: var(--text-muted); text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 1rem; }
        .btn-back:hover { color: var(--text-secondary); }

        .expand-btn { background: none; border: none; color: var(--purple-light); cursor: pointer; font-size: 0.78rem; padding: 2px 6px; }
        .expand-btn:hover { text-decoration: underline; }
        .concept-detail { display: none; padding: 8px 12px; }
        .concept-detail.open { display: block; }

        .time-fmt { color: var(--text-muted); }
    </style>
</head>
<body>
<div class="top-bar">
    <div class="title"><i class="bi bi-bar-chart-line"></i> Submissions</div>
    <div class="actions">
        <div style="display:flex;gap:8px;align-items:center;">
            <a href="/assignments/<%= assignment.id %>/export-csv" style="color:var(--green-light);text-decoration:none;font-size:0.82rem;display:flex;align-items:center;gap:4px;background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:var(--radius-sm);padding:6px 14px;font-weight:600;transition:var(--transition);" onmouseenter="this.style.background='rgba(16,185,129,0.2)'" onmouseleave="this.style.background='rgba(16,185,129,0.1)'">
                <i class="bi bi-download"></i> Download CSV
            </a>
            <a href="/assignments/<%= assignment.id %>/remedial" style="color:var(--gold);text-decoration:none;font-size:0.82rem;display:flex;align-items:center;gap:4px;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.3);border-radius:var(--radius-sm);padding:6px 14px;font-weight:600;transition:var(--transition);" onmouseenter="this.style.background='rgba(245,158,11,0.2)'" onmouseleave="this.style.background='rgba(245,158,11,0.1)'">
                <i class="bi bi-bandaid"></i> Create Remedial
            </a>
            <a href="/assignments" style="color:var(--text-muted);text-decoration:none;font-size:0.85rem;display:flex;align-items:center;gap:4px;"><i class="bi bi-arrow-left"></i> Back to Assignments</a>
        </div>
    </div>
</div>
<div class="page-wrap">
    <a href="/assignments" class="btn-back" style="display:none;"></a>
    <h1 class="page-title"><%= assignment.title %></h1>
    <p class="page-subtitle">
        <i class="bi bi-people"></i> <%= assignment.batch_name %> ·
        <i class="bi bi-question-circle"></i> <%= questionCount %> questions ·
        <i class="bi bi-calendar-event"></i> Due: <%= new Date(assignment.deadline).toLocaleString() %>
    </p>

    <!-- Aggregate Stats -->
    <div class="stats-grid">
        <div class="stat-card"><div class="val purple"><%= aggregates.submittedCount %>/<%= aggregates.totalStudents %></div><div class="label">Submitted</div></div>
        <div class="stat-card"><div class="val gold"><%= aggregates.avgScore %></div><div class="label">Avg Score</div></div>
        <div class="stat-card"><div class="val green"><%= aggregates.highestScore %></div><div class="label">Highest</div></div>
        <div class="stat-card"><div class="val red"><%= aggregates.lowestScore %></div><div class="label">Lowest</div></div>
        <div class="stat-card">
            <div class="val" style="color:var(--text-secondary);">
                <% const avgMin = Math.floor(aggregates.avgTime / 60); const avgSec = aggregates.avgTime % 60; %>
                <%= avgMin %>m <%= avgSec %>s
            </div>
            <div class="label">Avg Time</div>
        </div>
    </div>

    <!-- Student Table -->
    <div class="section-title"><i class="bi bi-table"></i> Student Submissions</div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Student</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>%</th>
                    <th>Time</th>
                    <th>Review</th>
                    <th>Concepts</th>
                </tr>
            </thead>
            <tbody>
                <% students.forEach((s, i) => { %>
                <tr>
                    <td><%= i + 1 %></td>
                    <td><%= s.name %></td>
                    <td><span class="status-pill <%= s.status.toLowerCase() %>"><%= s.status %></span></td>
                    <td><%= s.score !== null ? s.score + '/' + s.max_score : '—' %></td>
                    <td><%= s.percentage !== null ? s.percentage + '%' : '—' %></td>
                    <td class="time-fmt">
                        <% if (s.time_taken_seconds !== null) { %>
                            <%= Math.floor(s.time_taken_seconds / 60) %>m <%= s.time_taken_seconds % 60 %>s
                        <% } else { %>—<% } %>
                    </td>
                    <td>
                        <% if (s.status === 'Completed') { %>
                            <a href="/assignments/<%= assignment.id %>/submissions/<%= s.id %>" style="font-size:0.78rem;color:var(--purple-light);text-decoration:none;font-weight:600;" onmouseenter="this.style.textDecoration='underline'" onmouseleave="this.style.textDecoration='none'"><i class="bi bi-eye"></i> View</a>
                        <% } else { %>—<% } %>
                    </td>
                    <td>
                        <% if (conceptBreakdown[s.id]) { %>
                            <button class="expand-btn" onclick="this.nextElementSibling.classList.toggle('open')">
                                <i class="bi bi-chevron-down"></i> Details
                            </button>
                            <div class="concept-detail">
                                <% Object.entries(conceptBreakdown[s.id]).forEach(([cid, cd]) => {
                                    const pct = cd.total > 0 ? Math.round((cd.correct / cd.total) * 100) : 0;
                                    const barColor = pct >= 80 ? 'var(--green)' : pct >= 50 ? 'var(--gold)' : 'var(--red)';
                                %>
                                    <div class="concept-row">
                                        <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= cd.concept_name %></span>
                                        <span style="font-size:0.72rem;color:var(--text-dim);"><%= cd.correct %>/<%= cd.total %></span>
                                        <div class="concept-bar-bg"><div class="concept-bar" style="width:<%= pct %>%;background:<%= barColor %>;"></div></div>
                                        <span class="concept-pct"><%= pct %>%</span>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>—<% } %>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <!-- Question Analytics (Feature 7) -->
    <% if (typeof questionAnalytics !== 'undefined' && questionAnalytics.length > 0) { %>
    <div class="section-title" style="margin-top:2rem;"><i class="bi bi-graph-up"></i> Question Analytics <span style="font-size:0.72rem;color:var(--text-dim);font-weight:400;margin-left:6px;">(hardest first)</span></div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Q#</th>
                    <th>Question</th>
                    <th>Correct</th>
                    <th>Total</th>
                    <th>Accuracy</th>
                    <th style="min-width:100px;"></th>
                </tr>
            </thead>
            <tbody>
                <% questionAnalytics.forEach(qa => {
                    const barColor = qa.accuracy >= 80 ? 'var(--green)' : qa.accuracy >= 50 ? 'var(--gold)' : 'var(--red)';
                %>
                <tr>
                    <td style="font-weight:600;">Q.<%= qa.question_order %></td>
                    <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= qa.question_text.substring(0, 80) %><%= qa.question_text.length > 80 ? '...' : '' %></td>
                    <td><%= qa.correct_count %></td>
                    <td><%= qa.total_attempts %></td>
                    <td style="font-weight:600;color:<%= barColor %>;"><%= qa.accuracy %>%</td>
                    <td>
                        <div style="width:100%;height:6px;background:var(--border);border-radius:3px;overflow:hidden;">
                            <div style="width:<%= qa.accuracy %>%;height:100%;background:<%= barColor %>;border-radius:3px;"></div>
                        </div>
                    </td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>
</body>
</html>
