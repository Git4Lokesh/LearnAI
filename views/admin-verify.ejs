<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Verify Questions</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <style>
        body { background: #0F172A; color: #e2e8f0; }
        .panel { background: #1E293B; border: 1px solid #334155; border-radius: 8px; padding: 1.5rem; height: calc(100vh - 120px); overflow-y: auto; }
        .option-label { display: block; padding: 0.5rem; border-radius: 4px; margin-bottom: 0.5rem; border: 1px solid #334155; cursor: pointer; }
        .option-label:has(input:checked) { border-color: #7C3AED; background: #2d1f5e; }
        textarea, select, input[type=text] { background: #0F172A; color: #e2e8f0; border: 1px solid #334155; border-radius: 4px; width: 100%; padding: 0.5rem; }
        .badge-pending { background: #F59E0B; }
        .stat { font-size: 0.85rem; color: #94a3b8; }
    </style>
</head>
<body>
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">🔍 Question Verification Queue</h5>
        <div class="stat">
            Pending: <strong><%= stats.pending %></strong> &nbsp;|&nbsp;
            Approved: <strong><%= stats.approved %></strong> &nbsp;|&nbsp;
            Rejected: <strong><%= stats.rejected %></strong>
        </div>
    </div>

    <% if (!question) { %>
        <div class="text-center mt-5">
            <h4>✅ No pending questions!</h4>
            <p class="text-muted">All questions have been verified.</p>
            <a href="/admin/payouts" class="btn btn-outline-light mt-2">View Payouts</a>
        </div>
    <% } else { %>
    <form method="POST" action="/admin/verify/<%= question.id %>">
        <div class="row g-3">
            <!-- LEFT: Rendered Preview -->
            <div class="col-md-6">
                <div class="panel">
                    <p class="text-muted small mb-2">PREVIEW (rendered)</p>
                    <div class="mb-3">
                        <strong>Q:</strong>
                        <div class="mt-1"><%- question.question_text %></div>
                    </div>
                    <% ['option1','option2','option3','option4'].forEach((opt, i) => { %>
                    <div class="p-2 mb-2 rounded border <%= question.correct_answer === opt ? 'border-success' : 'border-secondary' %>">
                        <span class="text-muted me-2"><%= String.fromCharCode(65+i) %>.</span>
                        <%- question[opt] %>
                        <% if (question.correct_answer === opt) { %><span class="badge bg-success ms-2">✓</span><% } %>
                    </div>
                    <% }) %>
                    <% if (question.solution_text) { %>
                    <hr>
                    <p class="text-muted small">SOLUTION</p>
                    <div><%- question.solution_text %></div>
                    <% } %>
                    <hr>
                    <p class="text-muted small mb-1">Source: <%= question.source || 'Unknown' %></p>
                    <p class="text-muted small">AI-extracted: <%= new Date(question.extracted_by_ai_at).toLocaleDateString() %></p>
                </div>
            </div>

            <!-- RIGHT: Edit Form -->
            <div class="col-md-6">
                <div class="panel">
                    <p class="text-muted small mb-2">EDIT FORM</p>

                    <div class="mb-3">
                        <label class="form-label small">Question Text</label>
                        <textarea name="question_text" rows="3"><%= question.question_text %></textarea>
                    </div>

                    <% ['option1','option2','option3','option4'].forEach((opt, i) => { %>
                    <div class="mb-2">
                        <label class="form-label small">Option <%= String.fromCharCode(65+i) %></label>
                        <input type="text" name="<%= opt %>" value="<%= question[opt] %>">
                    </div>
                    <% }) %>

                    <div class="mb-3">
                        <label class="form-label small">Correct Answer</label>
                        <div class="d-flex gap-3 mt-1">
                            <% ['option1','option2','option3','option4'].forEach((opt, i) => { %>
                            <label class="option-label">
                                <input type="radio" name="correct_answer" value="<%= opt %>" <%= question.correct_answer === opt ? 'checked' : '' %>>
                                <%= String.fromCharCode(65+i) %>
                            </label>
                            <% }) %>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Concept Node</label>
                        <select name="concept_id">
                            <% concepts.forEach(c => { %>
                            <option value="<%= c.id %>" <%= question.concept_id === c.id ? 'selected' : '' %>>
                                <%= c.subject %> — <%= c.name %>
                            </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Difficulty Tier</label>
                        <div class="d-flex gap-3 mt-1">
                            <% [1,2,3].forEach(t => { %>
                            <label class="option-label">
                                <input type="radio" name="difficulty_tier" value="<%= t %>" <%= question.difficulty_tier === t ? 'checked' : '' %>>
                                Tier <%= t %>
                            </label>
                            <% }) %>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small">Solution (optional fix)</label>
                        <textarea name="solution_text" rows="3"><%= question.solution_text || '' %></textarea>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" name="action" value="approve" class="btn btn-success flex-fill">
                            ✅ Approve <small>(Alt+A)</small>
                        </button>
                        <button type="submit" name="action" value="save_approve" class="btn btn-primary flex-fill">
                            💾 Save & Approve <small>(Alt+S)</small>
                        </button>
                        <button type="submit" name="action" value="reject" class="btn btn-danger flex-fill">
                            ❌ Reject <small>(Alt+R)</small>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <% } %>
</div>

<script>
document.addEventListener('keydown', e => {
    if (!e.altKey) return;
    if (e.key === 'a') document.querySelector('[value="approve"]')?.click();
    if (e.key === 's') document.querySelector('[value="save_approve"]')?.click();
    if (e.key === 'r') document.querySelector('[value="reject"]')?.click();
});
// Re-render MathJax after page load
window.addEventListener('load', () => MathJax.typesetPromise());
</script>
</body>
</html>
