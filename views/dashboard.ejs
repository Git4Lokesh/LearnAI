function initGraph(subject) {
    // Check if vis-network loaded successfully
    if (typeof vis === 'undefined' || typeof vis.Network === 'undefined') {
        const container = document.getElementById('graph');
        container.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Graph visualization unavailable. Please refresh the page or check your internet connection.</p></div>';
        return;
    }
    
    const { nodes, edges } = buildGraph(subject);
    const container = document.getElementById('graph');

    if (network) network.destroy();

    // Topological level assignment (Kahn's algorithm)
    const inDegree = {};
    const adjList = {};
    nodes.forEach(n => { inDegree[n.id] = 0; adjList[n.id] = []; });
    edges.forEach(e => { inDegree[e.to] = (inDegree[e.to] || 0) + 1; adjList[e.from].push(e.to); });
    const levelMap = {};
    const queue = nodes.filter(n => inDegree[n.id] === 0).map(n => n.id);
    queue.forEach(id => { levelMap[id] = 0; });
    let head = 0;
    while (head < queue.length) {
        const cur = queue[head++];
        (adjList[cur] || []).forEach(next => {
            levelMap[next] = Math.max(levelMap[next] || 0, levelMap[cur] + 1);
            inDegree[next]--;
            if (inDegree[next] === 0) queue.push(next);
        });
    }
    const leveledNodes = nodes.map(n => ({ ...n, level: levelMap[n.id] ?? 0 }));

    network = new vis.Network(container, {
        nodes: new vis.DataSet(leveledNodes),
        edges: new vis.DataSet(edges)
    }, {
        layout: {
            hierarchical: {
                enabled: true,
                direction: 'LR',
                sortMethod: 'directed',
                levelSeparation: 220,
                nodeSpacing: 90,
                treeSpacing: 140,
                blockShifting: true,
                edgeMinimization: true
            }
        },
        physics: false,
        interaction: { hover: true, tooltipDelay: 200 },
        nodes: { borderWidth: 2 },
        edges: { smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 } }
    });

    network.on('click', params => {
        if (params.nodes.length > 0) selectConcept(params.nodes[0]);
    });
}

function selectConcept(id) {
    selectedConcept = id;
    const masteryMap = {};
    graphData.mastery.forEach(m => { masteryMap[m.concept_id] = m; });
    const prereqMap = {};
    graphData.prereqs.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        prereqMap[p.concept_id].push(p.prereq_id);
    });
    // Also include drilldown prerequisites
    drilldownPrereqs.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        if (!prereqMap[p.concept_id].includes(p.prereq_id)) {
            prereqMap[p.concept_id].push(p.prereq_id);
        }
    });
    const conceptMap = {};
    graphData.concepts.forEach(c => { conceptMap[c.id] = c; });
    // Also include drilldown concepts
    drilldownConcepts.forEach(c => { if (!conceptMap[c.id]) conceptMap[c.id] = c; });

    const c = conceptMap[id];
    if (!c) return; // Concept not found, bail out
    const mData = masteryMap[id] || { mastery: 0.2, questions_answered: 0, correct_answers: 0 };
    const hasStarted = !!masteryMap[id];
    const prereqs = prereqMap[id] || [];
    const unlocked = prereqs.every(pid => (masteryMap[pid]?.mastery || 0.2) >= 0.8);

    document.getElementById('infoName').textContent = c.name;
    document.getElementById('infoSubject').textContent = c.subject || currentSubject;
    document.getElementById('infoMastery').textContent = Math.round(mData.mastery * 100) + '%';
    document.getElementById('infoMastery').style.color = masteryColor(mData.mastery, unlocked, hasStarted);
    document.getElementById('infoQA').textContent = mData.questions_answered || 0;
    document.getElementById('infoCorrect').textContent = mData.correct_answers || 0;
    document.getElementById('infoStatus').textContent = !unlocked ? '🔒 Locked' : !hasStarted ? '🆕 Not Started' : mData.mastery >= 0.8 ? '✅ Mastered' : '📖 In Progress';

    // Prerequisites
    const prereqListEl = document.getElementById('prereqList');
    if (prereqs.length > 0) {
        prereqListEl.innerHTML = '<h6>Prerequisites</h6>' + prereqs.map(pid => {
            const pm = masteryMap[pid]?.mastery || 0.2;
            const done = pm >= 0.8;
            const weak = pm < 0.5;
            const className = done ? 'done' : weak ? 'weak' : '';
            return `<span class="prereq-tag ${className}" onclick="selectConcept('${pid}')" title="${Math.round(pm*100)}% mastery">${conceptMap[pid]?.name || pid}</span>`;
        }).join('');
    } else {
        prereqListEl.innerHTML = '';
    }

    // Show learning path if concept is locked or struggling
    const learningPathEl = document.getElementById('learningPath');
    const pathStepsEl = document.getElementById('pathSteps');
    if (!unlocked || (mData.questions_answered >= 5 && mData.mastery < 0.5)) {
        // Get optimal path (weak prerequisites + target)
        const weakPrereqs = prereqs.filter(pid => (masteryMap[pid]?.mastery || 0.2) < 0.7)
            .sort((a, b) => (masteryMap[a]?.mastery || 0.2) - (masteryMap[b]?.mastery || 0.2));
        const path = [...weakPrereqs, id];
        
        pathStepsEl.innerHTML = path.map((cid, i) => {
            const cm = masteryMap[cid]?.mastery || 0.2;
            const isDone = cm >= 0.8;
            const isCurrent = cid === id || (!isDone && i === path.findIndex(p => (masteryMap[p]?.mastery || 0.2) < 0.8));
            const stepClass = isDone ? 'done' : isCurrent ? 'current' : '';
            return `<div class="path-step ${isCurrent ? 'current' : ''}" onclick="selectConcept('${cid}')">
                <div class="step-num ${stepClass}">${isDone ? '✓' : i + 1}</div>
                <span>${conceptMap[cid]?.name || cid}</span>
                <span style="margin-left:auto;font-size:0.65rem;color:var(--muted)">${Math.round(cm*100)}%</span>
            </div>`;
        }).join('');
        learningPathEl.style.display = 'block';
    } else {
        learningPathEl.style.display = 'none';
    }

    document.getElementById('lockedMsg').style.display = unlocked ? 'none' : 'block';
    document.getElementById('btnPractice').disabled = !unlocked;

    document.getElementById('infoPanel').classList.remove('hidden');

    // Load async stats (sparkline, unsolved count, accuracy, etc.)
    loadConceptStats(id);

    // Highlight in sidebar
    document.querySelectorAll('.concept-item').forEach(el => el.classList.remove('selected'));
    const sidebarItem = document.querySelector(`.concept-item[data-id="${id}"]`);
    if (sidebarItem) sidebarItem.classList.add('selected');

    // Focus node in graph
    if (network) network.focus(id, { scale: 1.2, animation: { duration: 400 } });
}

function startPractice() {
    if (selectedConcept) window.location.href = `/practice/${selectedConcept}`;
}

let diagnosisRunning = false;

function closeDiagnosis() {
    document.getElementById('diagBackdrop').classList.remove('show');
    document.getElementById('diagPanel').classList.remove('show');
}

function openDiagnosis() {
    document.getElementById('diagBackdrop').classList.add('show');
    document.getElementById('diagPanel').classList.add('show');
}

function diagNodeClick(conceptId) {
    closeDiagnosis();
    // Navigate to the concept on the graph
    if (network && currentView !== 'chapters') {
        network.selectNodes([conceptId]);
        network.focus(conceptId, { scale: 1.5, animation: { duration: 400, easingFunction: 'easeInOutQuad' } });
        selectConcept(conceptId);
    }
}

function renderDiagnosisNodes(nodes, dotColor, masteryColor) {
    return nodes.map(n => renderRichNode(n, dotColor, masteryColor)).join('');
}

function renderRichNode(n, dotColor, masteryColor) {
    const trend = n.recentTrend != null
        ? `<span style="font-size:0.6rem;color:${n.recentTrend > 0 ? 'var(--green)' : n.recentTrend < 0 ? 'var(--red)' : 'var(--muted)'}">${n.recentTrend > 0 ? '↑' + n.recentTrend : n.recentTrend < 0 ? '↓' + Math.abs(n.recentTrend) : '→'}</span>`
        : '';
    // Signal bars
    const readinessVal = n.readiness ?? 0;
    const confVal = n.confidence ?? 0;
    const recVal = n.recency ?? 0;
    const accVal = n.accuracy ?? 0;
    const calVal = n.calibration ?? 50;
    const rColor = readinessVal >= 80 ? 'var(--green)' : readinessVal >= 50 ? 'var(--gold)' : 'var(--red)';

    function miniBar(val, color, label) {
        return `<div style="display:flex;align-items:center;gap:4px;min-width:0">
            <span style="font-size:0.55rem;color:var(--muted);width:28px;text-align:right;flex-shrink:0">${label}</span>
            <div style="flex:1;height:3px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden;min-width:20px">
                <div style="width:${val}%;height:100%;background:${color};border-radius:2px"></div>
            </div>
            <span style="font-size:0.55rem;color:var(--muted);width:22px;flex-shrink:0">${val}%</span>
        </div>`;
    }

    // Context tags
    const tags = [];
    if (n.blocksCount > 0) tags.push(`<span style="background:rgba(239,68,68,0.15);color:var(--red);border-radius:4px;padding:1px 5px;font-size:0.55rem">blocks ${n.blocksCount}</span>`);
    if (n.questionsAnswered === 0) tags.push(`<span style="background:rgba(255,255,255,0.06);color:var(--muted);border-radius:4px;padding:1px 5px;font-size:0.55rem">not attempted</span>`);
    else tags.push(`<span style="background:rgba(255,255,255,0.06);color:var(--muted);border-radius:4px;padding:1px 5px;font-size:0.55rem">${n.questionsAnswered}q</span>`);
    if (n.daysSinceLastPractice != null && n.daysSinceLastPractice > 0) tags.push(`<span style="background:rgba(255,255,255,0.06);color:var(--muted);border-radius:4px;padding:1px 5px;font-size:0.55rem">${n.daysSinceLastPractice}d ago</span>`);
    if (n.hasLearnedParams) tags.push(`<span style="background:rgba(124,58,237,0.15);color:var(--purple-light);border-radius:4px;padding:1px 5px;font-size:0.55rem">EM fitted</span>`);
    if (n.divergenceType && n.divergenceType !== 'calibrated') tags.push(`<span style="background:rgba(245,158,11,0.15);color:var(--gold);border-radius:4px;padding:1px 5px;font-size:0.55rem">${n.divergenceType === 'underestimated' ? '📈' : '📉'} ${n.divergenceMagnitude}% div</span>`);
    if (n.depth > 1) tags.push(`<span style="background:rgba(255,255,255,0.06);color:var(--muted);border-radius:4px;padding:1px 5px;font-size:0.55rem">depth ${n.depth}</span>`);

    return `<div class="diag-node" onclick="diagNodeClick('${n.id}')" style="flex-direction:column;align-items:stretch;padding:10px 12px;border:1px solid rgba(255,255,255,0.04)">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
            <div class="diag-node-dot" style="background:${dotColor}"></div>
            <div style="flex:1;font-size:0.82rem;color:var(--text);font-weight:500">${n.name}</div>
            <div style="font-size:0.85rem;font-weight:700;color:${masteryColor}">${n.mastery}% ${trend}</div>
        </div>
        <div style="display:flex;gap:8px;margin-bottom:4px">
            <div style="flex:1;display:flex;flex-direction:column;gap:2px">
                ${miniBar(readinessVal, rColor, 'RDY')}
                ${miniBar(confVal, confVal >= 70 ? 'var(--green)' : confVal >= 40 ? 'var(--gold)' : 'var(--red)', 'CNF')}
                ${miniBar(recVal, recVal >= 70 ? 'var(--green)' : recVal >= 40 ? 'var(--gold)' : 'var(--red)', 'RCN')}
            </div>
            <div style="flex:1;display:flex;flex-direction:column;gap:2px">
                ${miniBar(accVal, accVal >= 70 ? 'var(--green)' : accVal >= 40 ? 'var(--gold)' : 'var(--red)', 'ACC')}
                ${miniBar(calVal, calVal >= 70 ? 'var(--green)' : calVal >= 40 ? 'var(--gold)' : 'var(--red)', 'CAL')}
                ${miniBar(n.impactScore ? Math.min(100, Math.round(n.impactScore * 20)) : 0, 'var(--purple-light)', 'IMP')}
            </div>
        </div>
        ${tags.length ? `<div style="display:flex;flex-wrap:wrap;gap:3px;margin-top:2px">${tags.join('')}</div>` : ''}
    </div>`;
}

function renderReadinessArc(pct) {
    // SVG arc for the readiness gauge
    const r = 54, cx = 60, cy = 60, sw = 8;
    const circumference = 2 * Math.PI * r;
    const dashLen = (pct / 100) * circumference;
    const color = pct >= 80 ? '#10B981' : pct >= 50 ? '#F59E0B' : '#EF4444';
    const glow = pct >= 80 ? 'rgba(16,185,129,0.3)' : pct >= 50 ? 'rgba(245,158,11,0.3)' : 'rgba(239,68,68,0.3)';
    return `<svg width="120" height="120" viewBox="0 0 120 120" style="display:block;margin:0 auto">
        <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="${sw}" />
        <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${color}" stroke-width="${sw}"
            stroke-dasharray="${dashLen} ${circumference}" stroke-dashoffset="0"
            stroke-linecap="round" transform="rotate(-90 ${cx} ${cy})"
            style="filter:drop-shadow(0 0 6px ${glow});transition:stroke-dasharray 0.6s ease" />
        <text x="${cx}" y="${cy - 4}" text-anchor="middle" fill="${color}" font-size="22" font-weight="700">${pct}%</text>
        <text x="${cx}" y="${cy + 14}" text-anchor="middle" fill="rgba(255,255,255,0.4)" font-size="8" letter-spacing="0.08em" text-transform="uppercase">READINESS</text>
    </svg>`;
}

function renderSignalLegend() {
    return `<div style="display:flex;flex-wrap:wrap;gap:6px 12px;padding:8px 12px;background:rgba(255,255,255,0.02);border-radius:8px;border:1px solid rgba(255,255,255,0.04);margin-top:8px">
        <div style="font-size:0.6rem;color:var(--muted);width:100%;margin-bottom:2px;text-transform:uppercase;letter-spacing:0.06em">5-Signal Analysis</div>
        <span style="font-size:0.6rem;color:var(--muted)"><b style="color:var(--text)">RDY</b> Readiness (composite)</span>
        <span style="font-size:0.6rem;color:var(--muted)"><b style="color:var(--text)">CNF</b> Confidence (sample size)</span>
        <span style="font-size:0.6rem;color:var(--muted)"><b style="color:var(--text)">RCN</b> Recency (time decay)</span>
        <span style="font-size:0.6rem;color:var(--muted)"><b style="color:var(--text)">ACC</b> Accuracy (correct/total)</span>
        <span style="font-size:0.6rem;color:var(--muted)"><b style="color:var(--text)">CAL</b> Calibration (BKT vs actual)</span>
        <span style="font-size:0.6rem;color:var(--muted)"><b style="color:var(--text)">IMP</b> Impact (downstream weight)</span>
    </div>`;
}

async function diagnoseConcept() {
    if (!selectedConcept || diagnosisRunning) return;
    diagnosisRunning = true;
    const btn = document.getElementById('btnDiagnose');
    btn.disabled = true;
    btn.textContent = '\u{1F50D} Analyzing...';
    document.getElementById('diagBody').innerHTML = '<div style="padding:2rem;text-align:center"><div class="loading-spinner"></div><div style="color:var(--text-muted);font-size:0.85rem;margin-top:12px">Analyzing prerequisites...</div></div>';
    openDiagnosis();
    try {
        const [metricsRes, aiRes] = await Promise.all([
            fetch('/api/diagnose-concept', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ conceptId: selectedConcept }) }),
            fetch('/api/ai/diagnose', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ conceptId: selectedConcept }) }).catch(() => null)
        ]);
        if (!metricsRes.ok) throw new Error('Diagnosis failed');
        const data = await metricsRes.json();
        const aiData = aiRes && aiRes.ok ? await aiRes.json() : null;
        let html = '';
        const tColor = data.target.mastery >= 80 ? 'var(--green)' : data.target.mastery >= 50 ? 'var(--gold)' : 'var(--red)';
        html += `<div style="text-align:center;padding-bottom:12px;border-bottom:1px solid rgba(255,255,255,0.06)">
            <div style="font-size:1.1rem;font-weight:700;color:var(--text)">${data.target.name}</div>
            <div style="font-size:0.8rem;color:var(--muted);margin-top:4px">Mastery: <span style="color:${tColor};font-weight:700;font-size:1rem">${data.target.mastery}%</span></div>
            <div style="display:flex;justify-content:center;gap:1.5rem;margin-top:10px">
                <div style="text-align:center"><div style="font-size:1.1rem;font-weight:700;color:var(--text)">${data.totalPrereqs}</div><div style="font-size:0.55rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted)">Prerequisites</div></div>
                <div style="text-align:center"><div style="font-size:1.1rem;font-weight:700;color:var(--purple-light)">~${data.estimatedEffort || 0}</div><div style="font-size:0.55rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted)">Questions to ready</div></div>
                <div style="text-align:center"><div style="font-size:1.1rem;font-weight:700;color:${data.overallReadiness >= 80 ? 'var(--green)' : data.overallReadiness >= 50 ? 'var(--gold)' : 'var(--red)'}">${data.overallReadiness}%</div><div style="font-size:0.55rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--muted)">Readiness</div></div>
            </div></div>`;
        if (data.totalPrereqs > 0) {
            const s = data.summary;
            const segments = [
                { count: s.rootCauses, color: '#EF4444', label: 'Root cause' },
                { count: s.critical, color: '#F59E0B', label: 'Critical' },
                { count: s.stale || 0, color: '#A855F7', label: 'Stale' },
                { count: s.weak, color: '#22D3EE', label: 'Weak' },
                { count: s.mastered, color: '#10B981', label: 'Mastered' }
            ].filter(seg => seg.count > 0);
            html += `<div style="padding:12px 0">
                <div style="display:flex;height:8px;border-radius:4px;overflow:hidden;gap:1px">
                    ${segments.map(seg => `<div style="flex:${seg.count};background:${seg.color};min-width:4px" title="${seg.label}: ${seg.count}"></div>`).join('')}
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:6px 14px;margin-top:8px;justify-content:center">
                    ${segments.map(seg => `<span style="font-size:0.65rem;color:var(--muted);display:flex;align-items:center;gap:4px"><span style="width:8px;height:8px;border-radius:50%;background:${seg.color}"></span>${seg.count} ${seg.label}</span>`).join('')}
                </div></div>`;
        }
        if (data.totalPrereqs === 0) {
            html += `<div style="text-align:center;padding:1rem 0"><span style="font-size:1.2rem">&#x2705;</span> <span style="color:var(--green);font-weight:600">No prerequisites</span></div>`;
        }
        if (data.totalPrereqs > 0 && (data.summary.rootCauses + data.summary.critical + (data.summary.stale||0) + data.summary.weak) === 0) {
            html += `<div style="text-align:center;padding:1rem 0"><span style="font-size:1.2rem">&#x2705;</span> <span style="color:var(--green);font-weight:600">All prerequisites mastered</span></div>`;
        }
        if (data.suggestedPath && data.suggestedPath.length > 0) {
            html += `<div style="border-top:1px solid rgba(255,255,255,0.06);padding-top:12px;margin-top:4px">
                <div style="font-size:0.72rem;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px">\u{1F4CD} Study Path</div>`;
            data.suggestedPath.forEach((s, i) => {
                const sColor = s.mastery >= 50 ? 'var(--gold)' : 'var(--red-light)';
                html += `<div onclick="diagNodeClick('${s.id}')" style="display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;margin-bottom:4px;cursor:pointer;transition:all 0.2s">
                    <div style="width:20px;height:20px;border-radius:50%;background:var(--gradient-purple);display:flex;align-items:center;justify-content:center;font-size:0.6rem;font-weight:700;flex-shrink:0">${i+1}</div>
                    <div style="flex:1;font-size:0.82rem;color:var(--text)">${s.name}</div>
                    <div style="font-size:0.82rem;font-weight:700;color:${sColor}">${s.mastery}%</div>
                </div>`;
            });
            html += `</div>`;
        }
        html += `<div style="border-top:1px solid rgba(124,58,237,0.2);padding-top:12px;margin-top:12px">
            <div style="font-size:0.72rem;font-weight:600;color:var(--purple-light);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:8px">\u{1F916} AI Analysis</div>
            <div id="aiAdviceContent" style="font-size:0.82rem;color:var(--text-secondary);line-height:1.6"></div>
        </div>`;
        document.getElementById('diagBody').innerHTML = html;
        const aiContainer = document.getElementById('aiAdviceContent');
        if (aiData && aiData.explanation) {
            const text = aiData.explanation;
            let idx = 0;
            function typeAi() {
                if (idx < text.length) {
                    idx = Math.min(idx + 15, text.length);
                    aiContainer.innerHTML = marked.parse(text.substring(0, idx));
                    requestAnimationFrame(typeAi);
                } else {
                    aiContainer.innerHTML = marked.parse(text);
                }
            }
            requestAnimationFrame(typeAi);
        } else {
            aiContainer.innerHTML = '<span style="color:var(--text-muted);font-style:italic">AI analysis unavailable.</span>';
        }
    } catch (error) {
        document.getElementById('diagBody').innerHTML = `<div style="padding:2rem;text-align:center;color:var(--red)"><i class="bi bi-exclamation-triangle"></i> ${error.message}</div>`;
    } finally {
        diagnosisRunning = false;
        btn.disabled = false;
        btn.textContent = '\u{1F50D} Diagnose Prerequisites';
    }
}

function renderDivergenceSection(insights) {
    return `<div class="diag-section" style="border-top:1px solid rgba(255,255,255,0.06);padding-top:12px;margin-top:8px">
        <div class="diag-section-title"><span style="color:var(--gold)">🔬 Model Divergence Insights</span><span class="diag-section-count">${insights.length}</span></div>
        <div style="font-size:0.62rem;color:var(--muted);padding:0 10px 8px">Concepts where BKT mastery estimate significantly disagrees with raw accuracy. May indicate guessing, model lag, or concept difficulty mismatch.</div>
        <div style="display:flex;flex-direction:column;gap:4px">
            ${insights.map(d => {
                const isUnder = d.type === 'underestimated';
                const icon = isUnder ? '📈' : '📉';
                const label = isUnder ? 'Underestimated' : 'Overestimated';
                const labelColor = isUnder ? 'var(--cyan)' : 'var(--gold)';
                const desc = isUnder
                    ? 'Student performs better than model predicts — BKT may need recalibration'
                    : 'Model rates higher than actual performance — possible guessing or concept gap';
                return `<div class="diag-node" onclick="diagNodeClick('${d.id}')" style="border:1px solid rgba(255,255,255,0.06);flex-direction:column;align-items:stretch;padding:10px 12px">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
                        <span style="font-size:0.9rem">${icon}</span>
                        <span style="flex:1;font-size:0.82rem;color:var(--text);font-weight:500">${d.name}</span>
                        <span style="font-size:0.7rem;font-weight:600;color:${labelColor}">${label}</span>
                    </div>
                    <div style="display:flex;gap:12px;align-items:center;padding:4px 0">
                        <div style="flex:1">
                            <div style="display:flex;justify-content:space-between;font-size:0.6rem;color:var(--muted);margin-bottom:2px">
                                <span>BKT Mastery</span><span style="color:var(--text)">${d.mastery}%</span>
                            </div>
                            <div style="height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden">
                                <div style="width:${d.mastery}%;height:100%;background:var(--purple);border-radius:2px"></div>
                            </div>
                        </div>
                        <div style="font-size:0.7rem;color:var(--gold);font-weight:700;flex-shrink:0">${d.magnitude}%<br><span style="font-size:0.5rem;font-weight:400;color:var(--muted)">gap</span></div>
                        <div style="flex:1">
                            <div style="display:flex;justify-content:space-between;font-size:0.6rem;color:var(--muted);margin-bottom:2px">
                                <span>Raw Accuracy</span><span style="color:var(--text)">${d.accuracy}%</span>
                            </div>
                            <div style="height:4px;background:rgba(255,255,255,0.06);border-radius:2px;overflow:hidden">
                                <div style="width:${d.accuracy}%;height:100%;background:var(--cyan);border-radius:2px"></div>
                            </div>
                        </div>
                    </div>
                    <div style="font-size:0.58rem;color:var(--muted);margin-top:2px">${desc} · ${d.questionsAnswered} questions analyzed</div>
                </div>`;
            }).join('')}
        </div>
    </div>`;
}

function switchSubject(subject) {
    currentSubject = subject;
    document.querySelectorAll('.subject-tab').forEach(t => t.classList.toggle('active', t.dataset.subject === subject));
    document.getElementById('infoPanel').classList.add('hidden');
    document.getElementById('chapterInfoPanel').classList.add('hidden');
    selectedConcept = null;
    selectedChapterId = null;
    currentChapter = null;
    
    // Always reset to macro chapter view when switching subjects
    if (currentView === 'drilldown') {
        currentView = 'chapters';
        document.getElementById('graph').style.display = 'none';
        document.getElementById('macroGraph').style.display = 'block';
        document.getElementById('breadcrumb').classList.remove('show');
        document.querySelectorAll('.view-mode-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.view === 'chapters');
        });
    }
    
    if (currentView === 'chapters') {
        renderMacroGraph(subject);
    } else {
        renderSidebar(subject);
        initGraph(subject);
    }
}

