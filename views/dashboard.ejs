<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Knowledge Graph — Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/vis-network@9.1.9/dist/vis-network.min.js"></script>
    <style>
        :root {
            --bg: #0A0F1E;
            --surface: #111827;
            --border: #1F2937;
            --purple: #7C3AED;
            --blue: #2563EB;
            --gold: #F59E0B;
            --text: #F1F5F9;
            --muted: #64748B;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif; height: 100vh; display: flex; flex-direction: column; overflow: hidden; }

        nav {
            background: rgba(17,24,39,0.95);
            border-bottom: 1px solid var(--border);
            padding: 0 1.5rem;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            backdrop-filter: blur(12px);
        }
        .brand { color: var(--gold); font-weight: 700; font-size: 1.2rem; text-decoration: none; display: flex; align-items: center; gap: 8px; }
        .nav-right { display: flex; align-items: center; gap: 12px; }
        .user-chip { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 4px 14px 4px 6px; display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }
        .avatar { width: 28px; height: 28px; background: linear-gradient(135deg, var(--purple), var(--blue)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.75rem; }
        .btn-sm-ghost { background: none; border: 1px solid var(--border); color: var(--muted); border-radius: 8px; padding: 4px 12px; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
        .btn-sm-ghost:hover { border-color: var(--purple); color: var(--text); }

        .main { display: flex; flex: 1; overflow: hidden; }

        /* Sidebar */
        .sidebar {
            width: 280px;
            background: var(--surface);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            overflow: hidden;
        }
        .sidebar-header { padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); }
        .sidebar-header h6 { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 0.75rem; }
        .subject-tabs { display: flex; gap: 4px; }
        .subject-tab { flex: 1; padding: 5px 0; font-size: 0.75rem; border: 1px solid var(--border); background: none; color: var(--muted); border-radius: 6px; cursor: pointer; transition: all 0.2s; }
        .subject-tab.active { background: var(--purple); border-color: var(--purple); color: white; }

        .legend { padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 6px; }
        .legend-item { display: flex; align-items: center; gap: 8px; font-size: 0.78rem; color: var(--muted); }
        .legend-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }

        .concept-list { flex: 1; overflow-y: auto; padding: 0.5rem; }
        .concept-item { padding: 8px 10px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 10px; transition: background 0.15s; margin-bottom: 2px; }
        .concept-item:hover { background: rgba(124,58,237,0.1); }
        .concept-item.selected { background: rgba(124,58,237,0.2); border: 1px solid var(--purple); }
        .concept-item.locked { opacity: 0.4; cursor: not-allowed; }
        .concept-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
        .concept-name { font-size: 0.8rem; flex: 1; line-height: 1.3; }
        .concept-pct { font-size: 0.7rem; color: var(--muted); }

        /* Graph area */
        .graph-area { flex: 1; position: relative; overflow: hidden; }
        #graph { width: 100%; height: 100%; }

        /* Info panel */
        .info-panel {
            width: 300px;
            background: var(--surface);
            border-left: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            transition: transform 0.3s;
        }
        .info-panel.hidden { transform: translateX(300px); }
        .info-header { padding: 1.25rem; border-bottom: 1px solid var(--border); }
        .info-header h5 { font-size: 0.95rem; font-weight: 600; margin-bottom: 4px; }
        .info-header small { color: var(--muted); font-size: 0.75rem; }
        .info-body { padding: 1.25rem; flex: 1; overflow-y: auto; }
        .mastery-ring { text-align: center; margin-bottom: 1.25rem; }
        .mastery-pct { font-size: 2rem; font-weight: 700; }
        .mastery-label { font-size: 0.75rem; color: var(--muted); }
        .stat-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 0.82rem; }
        .stat-row:last-child { border-bottom: none; }
        .stat-label { color: var(--muted); }
        .prereq-list { margin-top: 1rem; }
        .prereq-list h6 { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.5rem; }
        .prereq-tag { display: inline-block; background: var(--border); border-radius: 4px; padding: 2px 8px; font-size: 0.72rem; margin: 2px; cursor: pointer; transition: all 0.2s; }
        .prereq-tag.done { background: rgba(16,185,129,0.2); color: #10B981; }
        .prereq-tag.weak { background: rgba(239,68,68,0.15); color: #EF4444; border: 1px solid rgba(239,68,68,0.3); }
        .prereq-tag:hover { transform: translateY(-1px); }
        .path-steps { display: flex; flex-direction: column; gap: 4px; }
        .path-step { display: flex; align-items: center; gap: 8px; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; transition: all 0.2s; cursor: pointer; }
        .path-step:hover { background: rgba(124,58,237,0.1); }
        .path-step.current { background: rgba(124,58,237,0.15); border: 1px solid var(--purple); }
        .step-num { width: 16px; height: 16px; border-radius: 50%; background: var(--border); display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 600; }
        .step-num.done { background: #10B981; color: white; }
        .step-num.current { background: var(--purple); color: white; }
        .info-footer { padding: 1.25rem; border-top: 1px solid var(--border); }
        .btn-practice { width: 100%; background: linear-gradient(135deg, var(--purple), var(--blue)); border: none; color: white; padding: 10px; border-radius: 10px; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: opacity 0.2s; }
        .btn-practice:hover { opacity: 0.9; }
        .btn-practice:disabled { opacity: 0.4; cursor: not-allowed; }
        .locked-msg { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 8px 0; }

        .graph-controls { position: absolute; bottom: 16px; right: 16px; display: flex; flex-direction: column; gap: 6px; }
        .ctrl-btn { width: 36px; height: 36px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; color: var(--text); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1rem; transition: all 0.2s; }
        .ctrl-btn:hover { border-color: var(--purple); }

        .empty-state { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); text-align: center; color: var(--muted); }
        .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }
    </style>
</head>
<body>
<nav>
    <a class="brand" href="/"><i class="bi bi-diagram-3-fill"></i> Learn.ai</a>
    <div class="nav-right">
        <div class="user-chip">
            <div class="avatar"><%= user.name.charAt(0).toUpperCase() %></div>
            <span><%= user.name %></span>
        </div>
        <form method="POST" action="/logout" style="margin:0">
            <button type="submit" class="btn-sm-ghost"><i class="bi bi-box-arrow-right me-1"></i>Sign out</button>
        </form>
    </div>
</nav>

<div class="main">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h6>Subject</h6>
            <div class="subject-tabs">
                <button class="subject-tab active" data-subject="Physics - Mechanics">Physics</button>
                <button class="subject-tab" data-subject="Mathematics">Maths</button>
                <button class="subject-tab" data-subject="Chemistry">Chem</button>
            </div>
        </div>
        <div class="legend">
            <div class="legend-item"><div class="legend-dot" style="background:#10B981"></div> Mastered (≥80%)</div>
            <div class="legend-item"><div class="legend-dot" style="background:#F59E0B"></div> In Progress</div>
            <div class="legend-item"><div class="legend-dot" style="background:#3B82F6"></div> Unlocked</div>
            <div class="legend-item"><div class="legend-dot" style="background:#374151"></div> Locked</div>
        </div>
        <div class="concept-list" id="conceptList"></div>
    </div>

    <!-- Graph -->
    <div class="graph-area">
        <div id="graph"></div>
        <div class="graph-controls">
            <button class="ctrl-btn" id="zoomIn" title="Zoom in"><i class="bi bi-plus"></i></button>
            <button class="ctrl-btn" id="zoomOut" title="Zoom out"><i class="bi bi-dash"></i></button>
            <button class="ctrl-btn" id="fitGraph" title="Fit"><i class="bi bi-fullscreen"></i></button>
        </div>
    </div>

    <!-- Info Panel -->
    <div class="info-panel hidden" id="infoPanel">
        <div class="info-header">
            <h5 id="infoName">—</h5>
            <small id="infoSubject">—</small>
        </div>
        <div class="info-body">
            <div class="mastery-ring">
                <div class="mastery-pct" id="infoMastery">—</div>
                <div class="mastery-label">Mastery</div>
            </div>
            <div class="stat-row"><span class="stat-label">Questions answered</span><span id="infoQA">—</span></div>
            <div class="stat-row"><span class="stat-label">Correct</span><span id="infoCorrect">—</span></div>
            <div class="stat-row"><span class="stat-label">Status</span><span id="infoStatus">—</span></div>
            <div class="prereq-list" id="prereqList"></div>
            <div class="learning-path" id="learningPath" style="display:none">
                <h6 style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);margin:1rem 0 0.5rem">Suggested Learning Path</h6>
                <div class="path-steps" id="pathSteps"></div>
            </div>
        </div>
        <div class="info-footer">
            <div class="locked-msg" id="lockedMsg" style="display:none"><i class="bi bi-lock me-1"></i>Complete prerequisites first</div>
            <button class="btn-practice" id="btnDiagnose" onclick="diagnoseConcept()" style="background: linear-gradient(135deg, #F59E0B, #EF4444); margin-bottom: 8px;">🔍 Diagnose Prerequisites</button>
            <button class="btn-practice" id="btnPractice" onclick="startPractice()">Practice this concept</button>
        </div>
    </div>
</div>

<script>
const graphData = <%- JSON.stringify(graphData) %>;
let network = null;
let selectedConcept = null;
let currentSubject = 'Physics - Mechanics';

function masteryColor(mastery, unlocked) {
    if (!unlocked) return '#374151';
    if (mastery >= 0.8) return '#10B981';
    if (mastery >= 0.4) return '#F59E0B';
    return '#3B82F6';
}

function buildGraph(subject) {
    const concepts = graphData.concepts.filter(c => c.subject === subject);
    const conceptIds = new Set(concepts.map(c => c.id));
    const masteryMap = {};
    graphData.mastery.forEach(m => { masteryMap[m.concept_id] = m; });
    const prereqMap = {};
    graphData.prereqs.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        prereqMap[p.concept_id].push(p.prereq_id);
    });

    // Determine unlocked state
    const unlockedMap = {};
    concepts.forEach(c => {
        const prereqs = prereqMap[c.id] || [];
        unlockedMap[c.id] = prereqs.every(pid => (masteryMap[pid]?.mastery || 0.2) >= 0.8);
    });

    const nodes = concepts.map(c => {
        const m = masteryMap[c.id]?.mastery || 0.2;
        const unlocked = unlockedMap[c.id];
        const color = masteryColor(m, unlocked);
        return {
            id: c.id,
            label: c.name.length > 22 ? c.name.substring(0, 20) + '…' : c.name,
            fullName: c.name,
            color: { background: color, border: color, highlight: { background: color, border: '#F59E0B' } },
            font: { color: '#F1F5F9', size: 11 },
            shape: 'dot',
            size: 18 + Math.round(m * 14),
            mastery: m,
            unlocked,
            subject: c.subject
        };
    });

    const edges = graphData.prereqs
        .filter(p => conceptIds.has(p.concept_id) && conceptIds.has(p.prereq_id))
        .map(p => ({
            from: p.prereq_id,
            to: p.concept_id,
            arrows: 'to',
            color: { color: '#374151', highlight: '#7C3AED' },
            width: 1.5,
            smooth: { type: 'curvedCW', roundness: 0.2 }
        }));

    return { nodes, edges };
}

function renderSidebar(subject) {
    const concepts = graphData.concepts.filter(c => c.subject === subject);
    const masteryMap = {};
    graphData.mastery.forEach(m => { masteryMap[m.concept_id] = m; });
    const prereqMap = {};
    graphData.prereqs.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        prereqMap[p.concept_id].push(p.prereq_id);
    });

    const list = document.getElementById('conceptList');
    list.innerHTML = '';
    concepts.forEach(c => {
        const m = masteryMap[c.id]?.mastery || 0.2;
        const prereqs = prereqMap[c.id] || [];
        const unlocked = prereqs.every(pid => (masteryMap[pid]?.mastery || 0.2) >= 0.8);
        const color = masteryColor(m, unlocked);
        const div = document.createElement('div');
        div.className = 'concept-item' + (unlocked ? '' : ' locked');
        div.dataset.id = c.id;
        div.innerHTML = `<div class="concept-dot" style="background:${color}"></div><span class="concept-name">${c.name}</span><span class="concept-pct">${Math.round(m*100)}%</span>`;
        div.addEventListener('click', () => unlocked && selectConcept(c.id));
        list.appendChild(div);
    });
}

function initGraph(subject) {
    const { nodes, edges } = buildGraph(subject);
    const container = document.getElementById('graph');

    if (network) network.destroy();

    // Topological level assignment (Kahn's algorithm)
    const inDegree = {};
    const adjList = {};
    nodes.forEach(n => { inDegree[n.id] = 0; adjList[n.id] = []; });
    edges.forEach(e => { inDegree[e.to] = (inDegree[e.to] || 0) + 1; adjList[e.from].push(e.to); });
    const levelMap = {};
    const queue = nodes.filter(n => inDegree[n.id] === 0).map(n => n.id);
    queue.forEach(id => { levelMap[id] = 0; });
    let head = 0;
    while (head < queue.length) {
        const cur = queue[head++];
        (adjList[cur] || []).forEach(next => {
            levelMap[next] = Math.max(levelMap[next] || 0, levelMap[cur] + 1);
            inDegree[next]--;
            if (inDegree[next] === 0) queue.push(next);
        });
    }
    const leveledNodes = nodes.map(n => ({ ...n, level: levelMap[n.id] ?? 0 }));

    network = new vis.Network(container, {
        nodes: new vis.DataSet(leveledNodes),
        edges: new vis.DataSet(edges)
    }, {
        layout: {
            hierarchical: {
                enabled: true,
                direction: 'LR',
                sortMethod: 'directed',
                levelSeparation: 220,
                nodeSpacing: 90,
                treeSpacing: 140,
                blockShifting: true,
                edgeMinimization: true
            }
        },
        physics: false,
        interaction: { hover: true, tooltipDelay: 200 },
        nodes: { borderWidth: 2 },
        edges: { smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 } }
    });

    network.on('click', params => {
        if (params.nodes.length > 0) selectConcept(params.nodes[0]);
    });
}

function selectConcept(id) {
    selectedConcept = id;
    const masteryMap = {};
    graphData.mastery.forEach(m => { masteryMap[m.concept_id] = m; });
    const prereqMap = {};
    graphData.prereqs.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        prereqMap[p.concept_id].push(p.prereq_id);
    });
    const conceptMap = {};
    graphData.concepts.forEach(c => { conceptMap[c.id] = c; });

    const c = conceptMap[id];
    const mData = masteryMap[id] || { mastery: 0.2, questions_answered: 0, correct_answers: 0 };
    const prereqs = prereqMap[id] || [];
    const unlocked = prereqs.every(pid => (masteryMap[pid]?.mastery || 0.2) >= 0.8);

    document.getElementById('infoName').textContent = c.name;
    document.getElementById('infoSubject').textContent = c.subject;
    document.getElementById('infoMastery').textContent = Math.round(mData.mastery * 100) + '%';
    document.getElementById('infoMastery').style.color = masteryColor(mData.mastery, unlocked);
    document.getElementById('infoQA').textContent = mData.questions_answered || 0;
    document.getElementById('infoCorrect').textContent = mData.correct_answers || 0;
    document.getElementById('infoStatus').textContent = !unlocked ? '🔒 Locked' : mData.mastery >= 0.8 ? '✅ Mastered' : '📖 In Progress';

    // Prerequisites
    const prereqListEl = document.getElementById('prereqList');
    if (prereqs.length > 0) {
        prereqListEl.innerHTML = '<h6>Prerequisites</h6>' + prereqs.map(pid => {
            const pm = masteryMap[pid]?.mastery || 0.2;
            const done = pm >= 0.8;
            const weak = pm < 0.5;
            const className = done ? 'done' : weak ? 'weak' : '';
            return `<span class="prereq-tag ${className}" onclick="selectConcept('${pid}')" title="${Math.round(pm*100)}% mastery">${conceptMap[pid]?.name || pid}</span>`;
        }).join('');
    } else {
        prereqListEl.innerHTML = '';
    }

    // Show learning path if concept is locked or struggling
    const learningPathEl = document.getElementById('learningPath');
    const pathStepsEl = document.getElementById('pathSteps');
    if (!unlocked || (mData.questions_answered >= 5 && mData.mastery < 0.5)) {
        // Get optimal path (weak prerequisites + target)
        const weakPrereqs = prereqs.filter(pid => (masteryMap[pid]?.mastery || 0.2) < 0.7)
            .sort((a, b) => (masteryMap[a]?.mastery || 0.2) - (masteryMap[b]?.mastery || 0.2));
        const path = [...weakPrereqs, id];
        
        pathStepsEl.innerHTML = path.map((cid, i) => {
            const cm = masteryMap[cid]?.mastery || 0.2;
            const isDone = cm >= 0.8;
            const isCurrent = cid === id || (!isDone && i === path.findIndex(p => (masteryMap[p]?.mastery || 0.2) < 0.8));
            const stepClass = isDone ? 'done' : isCurrent ? 'current' : '';
            return `<div class="path-step ${isCurrent ? 'current' : ''}" onclick="selectConcept('${cid}')">
                <div class="step-num ${stepClass}">${isDone ? '✓' : i + 1}</div>
                <span>${conceptMap[cid]?.name || cid}</span>
                <span style="margin-left:auto;font-size:0.65rem;color:var(--muted)">${Math.round(cm*100)}%</span>
            </div>`;
        }).join('');
        learningPathEl.style.display = 'block';
    } else {
        learningPathEl.style.display = 'none';
    }

    document.getElementById('lockedMsg').style.display = unlocked ? 'none' : 'block';
    document.getElementById('btnPractice').disabled = !unlocked;

    document.getElementById('infoPanel').classList.remove('hidden');

    // Highlight in sidebar
    document.querySelectorAll('.concept-item').forEach(el => el.classList.remove('selected'));
    const sidebarItem = document.querySelector(`.concept-item[data-id="${id}"]`);
    if (sidebarItem) sidebarItem.classList.add('selected');

    // Focus node in graph
    if (network) network.focus(id, { scale: 1.2, animation: { duration: 400 } });
}

function startPractice() {
    if (selectedConcept) window.location.href = `/practice/${selectedConcept}`;
}

let diagnosisRunning = false;

async function diagnoseConcept() {
    if (!selectedConcept || diagnosisRunning) return;
    
    diagnosisRunning = true;
    const btn = document.getElementById('btnDiagnose');
    btn.disabled = true;
    btn.textContent = '🔍 Diagnosing...';
    
    try {
        const response = await fetch('/api/diagnose-concept', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ conceptId: selectedConcept })
        });
        
        if (!response.ok) throw new Error('Diagnosis failed');
        
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        
        while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            
            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop();
            
            for (const line of lines) {
                if (line.startsWith('data: ')) {
                    try {
                        const data = JSON.parse(line.slice(6));
                        
                        if (data.type === 'checking') {
                            // Highlight node being checked
                            network.selectNodes([data.conceptId]);
                            network.focus(data.conceptId, { scale: 1.5, animation: { duration: 300 } });
                        } else if (data.type === 'gap') {
                            // Mark as gap (red)
                            const update = { id: data.conceptId, color: { background: '#EF4444', border: '#DC2626' } };
                            network.setData({ nodes: network.body.data.nodes.update(update), edges: network.body.data.edges });
                        } else if (data.type === 'ok') {
                            // Mark as OK (green pulse)
                            const update = { id: data.conceptId, color: { background: '#10B981', border: '#059669' } };
                            network.setData({ nodes: network.body.data.nodes.update(update), edges: network.body.data.edges });
                        } else if (data.type === 'complete') {
                            // Reset selection
                            network.unselectAll();
                            if (data.gapsFound > 0) {
                                alert(`Diagnosis complete! Found ${data.gapsFound} prerequisite gaps (marked in red).`);
                            } else {
                                alert('Great! All prerequisites are mastered.');
                            }
                        }
                    } catch (e) {
                        console.warn('Failed to parse SSE data:', line);
                    }
                }
            }
        }
        
    } catch (error) {
        alert(`Diagnosis failed: ${error.message}`);
    } finally {
        diagnosisRunning = false;
        btn.disabled = false;
        btn.textContent = '🔍 Diagnose Prerequisites';
    }
}

function switchSubject(subject) {
    currentSubject = subject;
    document.querySelectorAll('.subject-tab').forEach(t => t.classList.toggle('active', t.dataset.subject === subject));
    document.getElementById('infoPanel').classList.add('hidden');
    selectedConcept = null;
    renderSidebar(subject);
    initGraph(subject);
}

// Controls
document.getElementById('zoomIn').addEventListener('click', () => network?.moveTo({ scale: network.getScale() * 1.3 }));
document.getElementById('zoomOut').addEventListener('click', () => network?.moveTo({ scale: network.getScale() * 0.77 }));
document.getElementById('fitGraph').addEventListener('click', () => network?.fit({ animation: true }));
document.querySelectorAll('.subject-tab').forEach(t => t.addEventListener('click', () => switchSubject(t.dataset.subject)));

