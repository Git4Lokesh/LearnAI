// Init
switchView('chapters');

// Continue Learning: chapter-aware recommendation using prerequisite topology
(function initMission() {
    const concepts = graphData.concepts;
    const masteryData = graphData.mastery;
    const chapters = graphData.chapters || [];
    const chapterPrereqs = graphData.chapterPrereqs || [];
    const conceptPrereqs = graphData.prereqs || [];
    if (!concepts || concepts.length === 0) return;

    // Build mastery lookup (concept-level)
    const masteryMap = {};
    masteryData.forEach(m => { masteryMap[m.concept_id] = parseFloat(m.mastery) || 0; });

    // Build chapter prereq lookup: chapter_id -> [prereq_chapter_ids]
    const chapterPrereqMap = {};
    chapterPrereqs.forEach(p => {
        if (!chapterPrereqMap[p.chapter_id]) chapterPrereqMap[p.chapter_id] = [];
        chapterPrereqMap[p.chapter_id].push(p.prereq_id);
    });

    // Calculate chapter mastery: average of its concepts' mastery
    const chapterConceptMap = {}; // chapter_id -> [concept objects]
    concepts.forEach(c => {
        if (!c.chapter_id) return;
        if (!chapterConceptMap[c.chapter_id]) chapterConceptMap[c.chapter_id] = [];
        chapterConceptMap[c.chapter_id].push(c);
    });

    const chapterMasteryMap = {}; // chapter_id -> avg mastery
    Object.keys(chapterConceptMap).forEach(chId => {
        const chConcepts = chapterConceptMap[chId];
        const total = chConcepts.reduce((sum, c) => sum + (masteryMap[c.id] || 0), 0);
        chapterMasteryMap[chId] = total / chConcepts.length;
    });

    // Chapter is unlocked when ALL prereq chapters have mastery >= 80%
    const CHAPTER_UNLOCK_THRESHOLD = 0.8;
    function isChapterUnlocked(chapterId) {
        const deps = chapterPrereqMap[chapterId] || [];
        return deps.every(pid => (chapterMasteryMap[pid] || 0) >= CHAPTER_UNLOCK_THRESHOLD);
    }

    // Build concept prereq lookup for within-chapter unlock
    const conceptPrereqMap = {};
    conceptPrereqs.forEach(p => {
        if (!conceptPrereqMap[p.concept_id]) conceptPrereqMap[p.concept_id] = [];
        conceptPrereqMap[p.concept_id].push(p.prereq_id);
    });

    // Concept is unlocked if: its chapter is unlocked AND all concept-level prereqs have mastery >= 80%
    const CONCEPT_UNLOCK_THRESHOLD = 0.8;
    function isConceptUnlocked(concept) {
        if (!isChapterUnlocked(concept.chapter_id)) return false;
        const deps = conceptPrereqMap[concept.id] || [];
        return deps.every(pid => (masteryMap[pid] || 0) >= CONCEPT_UNLOCK_THRESHOLD);
    }

    // Build candidates: unlocked concepts with mastery < 80%
    const candidates = concepts
        .filter(c => c.chapter_id) // must belong to a chapter
        .map(c => ({
            id: c.id,
            name: c.name,
            mastery: masteryMap[c.id] || 0,
            unlocked: isConceptUnlocked(c),
            hasStarted: masteryMap[c.id] !== undefined && masteryMap[c.id] > 0
        }))
        .filter(c => c.unlocked && c.mastery < CONCEPT_UNLOCK_THRESHOLD);

    if (candidates.length === 0) return;

    // Priority: 1) in-progress (started but not mastered), sorted by lowest mastery
    //           2) not started yet (entry-point concepts in unlocked chapters)
    const inProgress = candidates.filter(c => c.hasStarted).sort((a, b) => a.mastery - b.mastery);
    const notStarted = candidates.filter(c => !c.hasStarted);

    const mission = inProgress.length > 0 ? inProgress[0] : notStarted[0];
    if (!mission) return;

    const label = mission.hasStarted ? 'Continue Learning' : 'Start Learning';
    const masteryText = mission.hasStarted ? Math.round(mission.mastery * 100) + '% mastery' : 'Not started yet';

    document.getElementById('missionConceptName').textContent = mission.name;
    document.getElementById('missionMastery').textContent = masteryText;
    document.getElementById('missionLabel').textContent = label;
    document.getElementById('todaysMission').style.display = 'block';
    window._missionConceptId = mission.id;
})();
function navigateToMission() {
    if (window._missionConceptId) window.location.href = '/practice/' + window._missionConceptId;
}

// ── Sparkline + Concept Stats ──
function drawSparkline(canvasId, attempts) {
    const canvas = document.getElementById(canvasId);
    if (!canvas || !attempts.length) return;
    const ctx = canvas.getContext('2d');
    const dpr = window.devicePixelRatio || 1;
    const w = canvas.clientWidth;
    const h = canvas.clientHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.scale(dpr, dpr);
    ctx.clearRect(0, 0, w, h);

    const pad = { top: 6, bottom: 6, left: 4, right: 4 };
    const plotW = w - pad.left - pad.right;
    const plotH = h - pad.top - pad.bottom;

    // Build cumulative mastery from attempts using simplified BKT
    let mastery = 0.2;
    const points = [mastery];
    attempts.forEach(a => {
        if (a.correct) {
            mastery = mastery + (1 - mastery) * 0.12;
        } else {
            mastery = mastery * 0.92;
        }
        mastery = Math.min(mastery, 0.99);
        mastery = Math.max(mastery, 0.05);
        points.push(mastery);
    });

    const n = points.length;
    if (n < 2) return;

    // Draw 80% threshold line
    const threshY = pad.top + plotH * (1 - 0.8);
    ctx.strokeStyle = 'rgba(16,185,129,0.25)';
    ctx.lineWidth = 1;
    ctx.setLineDash([4, 4]);
    ctx.beginPath();
    ctx.moveTo(pad.left, threshY);
    ctx.lineTo(w - pad.right, threshY);
    ctx.stroke();
    ctx.setLineDash([]);

    // Draw dots for correct/wrong
    const xStep = plotW / (n - 1);
    attempts.forEach((a, i) => {
        const x = pad.left + (i + 1) * xStep;
        const y = pad.top + plotH * (1 - points[i + 1]);
        ctx.beginPath();
        ctx.arc(x, y, 2.5, 0, Math.PI * 2);
        ctx.fillStyle = a.correct ? 'rgba(16,185,129,0.6)' : 'rgba(239,68,68,0.5)';
        ctx.fill();
    });

    // Draw line
    ctx.beginPath();
    ctx.strokeStyle = '#7C3AED';
    ctx.lineWidth = 1.5;
    ctx.lineJoin = 'round';
    for (let i = 0; i < n; i++) {
        const x = pad.left + i * xStep;
        const y = pad.top + plotH * (1 - points[i]);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
    }
    ctx.stroke();

    // Gradient fill under line
    const grad = ctx.createLinearGradient(0, pad.top, 0, h - pad.bottom);
    grad.addColorStop(0, 'rgba(124,58,237,0.15)');
    grad.addColorStop(1, 'rgba(124,58,237,0)');
    ctx.lineTo(pad.left + (n - 1) * xStep, h - pad.bottom);
    ctx.lineTo(pad.left, h - pad.bottom);
    ctx.closePath();
    ctx.fillStyle = grad;
    ctx.fill();
}

function timeAgo(dateStr) {
    if (!dateStr) return '—';
    const diff = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 1) return 'Just now';
    if (mins < 60) return mins + 'm ago';
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return hrs + 'h ago';
    const days = Math.floor(hrs / 24);
    if (days < 7) return days + 'd ago';
    const weeks = Math.floor(days / 7);
    if (weeks < 4) return weeks + 'w ago';
    return Math.floor(days / 30) + 'mo ago';
}

async function loadConceptStats(conceptId) {
    try {
        const res = await fetch('/api/concept-stats/' + conceptId);
        if (!res.ok) throw new Error('Failed');
        const data = await res.json();

        // Sparkline
        const wrap = document.getElementById('sparklineWrap');
        if (data.attempts && data.attempts.length >= 2) {
            wrap.style.display = 'block';
            drawSparkline('sparklineCanvas', data.attempts);
        } else {
            wrap.style.display = 'none';
        }

        // Stats
        document.getElementById('infoAccuracy').textContent = data.accuracy !== null ? data.accuracy + '%' : '—';
        document.getElementById('infoAvgTime').textContent = data.avgTimeSeconds ? data.avgTimeSeconds + 's' : '—';
        document.getElementById('infoUnsolved').textContent = data.unsolvedQuestions + ' / ' + data.totalQuestions;
        document.getElementById('infoLastPracticed').textContent = timeAgo(data.lastPracticed);
    } catch (e) {
        document.getElementById('sparklineWrap').style.display = 'none';
        document.getElementById('infoAccuracy').textContent = '—';
        document.getElementById('infoAvgTime').textContent = '—';
        document.getElementById('infoUnsolved').textContent = '—';
        document.getElementById('infoLastPracticed').textContent = '—';
    }
}
