<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Knowledge Graph — Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/vis-network@9.1.9/dist/vis-network.min.js"></script>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        :root { --muted: var(--text-dim); }
        body { height: 100vh; display: flex; flex-direction: column; overflow: hidden; }

        nav {
            background: rgba(17,24,39,0.8);
            border-bottom: 1px solid rgba(255,255,255,0.06);
            padding: 0 1.5rem;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
        .brand { color: var(--gold); font-weight: 700; font-size: 1.2rem; text-decoration: none; display: flex; align-items: center; gap: 8px; }
        .nav-right { display: flex; align-items: center; gap: 12px; }
        .user-chip { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 4px 14px 4px 6px; display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }
        .avatar { width: 28px; height: 28px; background: linear-gradient(135deg, var(--purple), var(--blue)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.75rem; }
        .btn-sm-ghost { background: none; border: 1px solid var(--border); color: var(--muted); border-radius: 8px; padding: 4px 12px; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
        .btn-sm-ghost:hover { border-color: var(--purple); color: var(--text); }

        .main { display: flex; flex: 1; overflow: hidden; }

        /* Sidebar */
        .sidebar {
            width: 280px;
            background: rgba(17,24,39,0.6);
            border-right: 1px solid rgba(255,255,255,0.06);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            overflow: hidden;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .sidebar-header { padding: 1rem 1.25rem; border-bottom: 1px solid var(--border); }
        .sidebar-header h6 { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 0.75rem; }
        .view-mode-toggle { display: flex; gap: 4px; margin-bottom: 0.75rem; }
        .view-mode-btn { flex: 1; padding: 6px 0; font-size: 0.75rem; border: 1px solid var(--border); background: none; color: var(--muted); border-radius: 6px; cursor: pointer; transition: all 0.2s; }
        .view-mode-btn.active { background: var(--gold); border-color: var(--gold); color: white; }
        .subject-tabs { display: flex; gap: 4px; }
        .subject-tab { flex: 1; padding: 5px 0; font-size: 0.75rem; border: 1px solid var(--border); background: none; color: var(--muted); border-radius: 6px; cursor: pointer; transition: all 0.2s; }
        .subject-tab.active { background: var(--purple); border-color: var(--purple); color: white; }

        .legend { padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; flex-direction: column; gap: 6px; }
        .legend-item { display: flex; align-items: center; gap: 8px; font-size: 0.78rem; color: var(--muted); }
        .legend-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }

        .sidebar-search { padding: 0.5rem 0.75rem; border-bottom: 1px solid var(--border); }
        .sidebar-search { position: relative; display: flex; align-items: center; }
        .sidebar-search i { position: absolute; left: 1rem; color: var(--muted); font-size: 0.8rem; pointer-events: none; }
        .sidebar-search input { width: 100%; padding: 6px 10px 6px 30px; background: var(--card); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 0.8rem; outline: none; }
        .sidebar-search input:focus { border-color: var(--purple); }
        .sidebar-search input::placeholder { color: var(--muted); }

        .concept-list { flex: 1; overflow-y: auto; padding: 0.5rem; }

        .chapter-concepts-preview { max-height: 300px; overflow-y: auto; }
        .chapter-concept-row { display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: 6px; font-size: 0.78rem; color: var(--text); }
        .chapter-concept-row .concept-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        .chapter-concept-row .concept-name { flex: 1; line-height: 1.3; }
        .chapter-concept-row .concept-pct { color: var(--muted); font-size: 0.72rem; flex-shrink: 0; }
        .concept-item { padding: 8px 10px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 10px; transition: background 0.15s; margin-bottom: 2px; }
        .concept-item:hover { background: rgba(124,58,237,0.1); }
        .concept-item.selected { background: rgba(124,58,237,0.2); border: 1px solid var(--purple); }
        .concept-item.locked { opacity: 0.4; cursor: not-allowed; }
        .concept-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
        .concept-name { font-size: 0.8rem; flex: 1; line-height: 1.3; }
        .concept-pct { font-size: 0.7rem; color: var(--muted); }

        /* Graph area */
        .graph-area { flex: 1; position: relative; overflow: hidden; }
        #graph { width: 100%; height: 100%; }
        #macroGraph { width: 100%; height: 100%; display: none; }
        .loading-indicator { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; color: var(--muted); display: none; }
        .loading-indicator.show { display: block; }
        .loading-spinner { width: 40px; height: 40px; border: 3px solid var(--border); border-top-color: var(--purple); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 1rem; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .breadcrumb { position: absolute; top: 16px; left: 16px; background: rgba(17,24,39,0.95); border: 1px solid var(--border); border-radius: 8px; padding: 8px 16px; font-size: 0.85rem; color: var(--muted); backdrop-filter: blur(12px); display: none; z-index: 10; cursor: pointer; }
        .breadcrumb.show { display: flex; align-items: center; gap: 8px; }
        .breadcrumb a { color: var(--text); text-decoration: none; transition: color 0.2s; display: flex; align-items: center; gap: 6px; }
        .breadcrumb a:hover { color: var(--purple); }
        .breadcrumb-separator { margin: 0 8px; color: var(--muted); }

        /* Info panel */
        .info-panel {
            width: 300px;
            background: rgba(17,24,39,0.75);
            border-left: 1px solid rgba(255,255,255,0.06);
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            position: absolute;
            right: 0;
            top: 56px;
            bottom: 0;
            z-index: 20;
            transition: transform 0.3s;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }
        .info-panel.hidden { transform: translateX(100%); pointer-events: none; }
        .info-header { padding: 1.25rem; border-bottom: 1px solid var(--border); }
        .info-header h5 { font-size: 0.95rem; font-weight: 600; margin-bottom: 4px; }
        .info-header small { color: var(--muted); font-size: 0.75rem; }
        .info-body { padding: 1.25rem; flex: 1; overflow-y: auto; }
        .mastery-ring { text-align: center; margin-bottom: 1.25rem; }
        .mastery-pct { font-size: 2rem; font-weight: 700; }
        .mastery-label { font-size: 0.75rem; color: var(--muted); }
        .stat-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 0.82rem; }
        .stat-row:last-child { border-bottom: none; }
        .stat-label { color: var(--muted); }
        .prereq-list { margin-top: 1rem; }
        .prereq-list h6 { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.5rem; }
        .prereq-tag { display: inline-block; background: var(--border); border-radius: 4px; padding: 2px 8px; font-size: 0.72rem; margin: 2px; cursor: pointer; transition: all 0.2s; }
        .prereq-tag.done { background: rgba(16,185,129,0.2); color: #10B981; }
        .prereq-tag.weak { background: rgba(239,68,68,0.15); color: #EF4444; border: 1px solid rgba(239,68,68,0.3); }
        .prereq-tag:hover { transform: translateY(-1px); }
        .path-steps { display: flex; flex-direction: column; gap: 4px; }
        .path-step { display: flex; align-items: center; gap: 8px; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; transition: all 0.2s; cursor: pointer; }
        .path-step:hover { background: rgba(124,58,237,0.1); }
        .path-step.current { background: rgba(124,58,237,0.15); border: 1px solid var(--purple); }
        .step-num { width: 16px; height: 16px; border-radius: 50%; background: var(--border); display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 600; }
        .step-num.done { background: #10B981; color: white; }
        .step-num.current { background: var(--purple); color: white; }
        .info-footer { padding: 1.25rem; border-top: 1px solid var(--border); }
        .btn-practice { width: 100%; background: linear-gradient(135deg, var(--purple), var(--blue)); border: none; color: white; padding: 10px; border-radius: 10px; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: opacity 0.2s; }
        .btn-practice:hover { opacity: 0.9; }
        .btn-practice:disabled { opacity: 0.4; cursor: not-allowed; }
        .locked-msg { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 8px 0; }

        .graph-controls { position: absolute; bottom: 16px; right: 16px; display: flex; flex-direction: column; gap: 6px; z-index: 10; }
        .ctrl-btn { width: 36px; height: 36px; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; color: var(--text); cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 1rem; transition: all 0.2s; }
        .ctrl-btn:hover { border-color: var(--purple); }

        .empty-state { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); text-align: center; color: var(--muted); }
        .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; }

        /* Mobile: hide graph, show accordion list */
        @media (max-width: 768px) {
            .sidebar { width: 100%; border-right: none; border-bottom: 1px solid var(--border); max-height: 50vh; }
            .graph-area { display: none; }
            .info-panel { position: static; width: 100%; transform: none; }
            .info-panel.hidden { display: none; }
            .main { flex-direction: column; overflow-y: auto; }
        }
    </style>
</head>
<body>
<nav>
    <a class="brand" href="/"><i class="bi bi-diagram-3-fill"></i> Learn.ai</a>
    <div class="nav-right">
        <div class="user-chip">
            <div class="avatar"><%= user.name.charAt(0).toUpperCase() %></div>
            <span><%= user.name %></span>
        </div>
        <form method="POST" action="/logout" style="margin:0">
            <button type="submit" class="btn-sm-ghost"><i class="bi bi-box-arrow-right me-1"></i>Sign out</button>
        </form>
    </div>
</nav>

<div class="main">
    <!-- Today's Mission banner (populated by JS) -->
    <div id="todaysMission" class="glow-pulse" style="display:none;background:linear-gradient(135deg,rgba(245,158,11,0.08),rgba(124,58,237,0.08));border:1px solid rgba(245,158,11,0.25);border-radius:12px;padding:10px 16px;margin:8px 12px 0;flex-shrink:0;cursor:pointer;backdrop-filter:blur(12px);" onclick="navigateToMission()">
        <div style="display:flex;align-items:center;gap:10px;">
            <span style="font-size:1.2rem;">🎯</span>
            <div style="flex:1;">
                <div style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--gold);font-weight:600;">Today's Mission</div>
                <div id="missionConceptName" style="font-size:0.88rem;font-weight:600;color:var(--text);"></div>
            </div>
            <span style="font-size:0.75rem;color:var(--muted);" id="missionMastery"></span>
            <i class="bi bi-arrow-right" style="color:var(--gold);"></i>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h6>View Mode</h6>
            <div class="view-mode-toggle">
                <button class="view-mode-btn active" data-view="chapters">Chapters</button>
                <button class="view-mode-btn" data-view="concepts">Concepts</button>
            </div>
            <h6>Subject</h6>
            <div class="subject-tabs">
                <button class="subject-tab active" data-subject="Physics">Physics</button>
                <button class="subject-tab" data-subject="Mathematics">Maths</button>
                <button class="subject-tab" data-subject="Chemistry">Chem</button>
            </div>
        </div>
        <div class="legend">
            <div class="legend-item"><div class="legend-dot" style="background:#22D3EE"></div> Start Here (not attempted)</div>
            <div class="legend-item"><div class="legend-dot" style="background:#10B981"></div> Mastered (≥80%)</div>
            <div class="legend-item"><div class="legend-dot" style="background:#F59E0B"></div> In Progress (50-80%)</div>
            <div class="legend-item"><div class="legend-dot" style="background:#EF4444"></div> Needs Work (&lt;50%)</div>
            <div class="legend-item"><div class="legend-dot" style="background:#6B7280"></div> Locked (prereqs needed)</div>
            <div class="legend-item"><div style="width:24px;height:2px;border-top:2px dashed #A855F7;flex-shrink:0"></div> Cross-Chapter Dependency</div>
        </div>
        <div class="sidebar-search">
            <i class="bi bi-search"></i>
            <input type="text" id="sidebarSearch" placeholder="Search units..." oninput="filterSidebarList(this.value)">
        </div>
        <div class="concept-list" id="conceptList"></div>
    </div>

    <!-- Graph -->
    <div class="graph-area">
        <div class="breadcrumb" id="breadcrumb">
            <a href="#" id="breadcrumbBack"><i class="bi bi-arrow-left"></i> All Chapters</a>
            <span class="breadcrumb-separator">›</span>
            <span id="breadcrumbCurrent">—</span>
        </div>
        <div class="loading-indicator" id="loadingIndicator">
            <div class="loading-spinner"></div>
            <div>Loading graph data...</div>
        </div>
        <div id="macroGraph"></div>
        <div id="graph"></div>
        <div class="graph-controls">
            <button class="ctrl-btn" id="zoomIn" title="Zoom in"><i class="bi bi-plus"></i></button>
            <button class="ctrl-btn" id="zoomOut" title="Zoom out"><i class="bi bi-dash"></i></button>
            <button class="ctrl-btn" id="fitGraph" title="Fit"><i class="bi bi-fullscreen"></i></button>
        </div>
    </div>

    <!-- Info Panel (concept detail) -->
    <div class="info-panel hidden" id="infoPanel">
        <div class="info-header">
            <h5 id="infoName">—</h5>
            <small id="infoSubject">—</small>
        </div>
        <div class="info-body">
            <div class="mastery-ring">
                <div class="mastery-pct" id="infoMastery">—</div>
                <div class="mastery-label">Mastery</div>
            </div>
            <div class="stat-row"><span class="stat-label">Questions answered</span><span id="infoQA">—</span></div>
            <div class="stat-row"><span class="stat-label">Correct</span><span id="infoCorrect">—</span></div>
            <div class="stat-row"><span class="stat-label">Status</span><span id="infoStatus">—</span></div>
            <div class="prereq-list" id="prereqList"></div>
            <div class="learning-path" id="learningPath" style="display:none">
                <h6 style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);margin:1rem 0 0.5rem">Suggested Learning Path</h6>
                <div class="path-steps" id="pathSteps"></div>
            </div>
        </div>
        <div class="info-footer">
            <div class="locked-msg" id="lockedMsg" style="display:none"><i class="bi bi-lock me-1"></i>Complete prerequisites first</div>
            <button class="btn-practice" id="btnDiagnose" onclick="diagnoseConcept()" style="background: linear-gradient(135deg, #F59E0B, #EF4444); margin-bottom: 8px;">🔍 Diagnose Prerequisites</button>
            <button class="btn-practice" id="btnPractice" onclick="startPractice()">Practice this concept</button>
        </div>
    </div>

    <!-- Chapter Info Panel -->
    <div class="info-panel hidden" id="chapterInfoPanel">
        <div class="info-header">
            <h5 id="chapterInfoName">—</h5>
            <small id="chapterInfoSubject">—</small>
        </div>
        <div class="info-body">
            <div class="mastery-ring">
                <div class="mastery-pct" id="chapterInfoMastery">—</div>
                <div class="mastery-label">Unit Mastery</div>
            </div>
            <div class="stat-row"><span class="stat-label">Subconcepts</span><span id="chapterInfoConceptCount">—</span></div>
            <div class="stat-row"><span class="stat-label">Mastered</span><span id="chapterInfoMasteredCount">—</span></div>
            <div class="stat-row"><span class="stat-label">Status</span><span id="chapterInfoStatus">—</span></div>
            <div class="chapter-concepts-preview" id="chapterConceptsPreview">
                <h6 style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted);margin:1rem 0 0.5rem">Subconcepts</h6>
                <div id="chapterConceptsList"></div>
            </div>
        </div>
        <div class="info-footer">
            <button class="btn-practice" id="btnEnterChapter" onclick="enterSelectedChapter()">
                <i class="bi bi-box-arrow-in-right me-1"></i>Enter Unit
            </button>
        </div>
    </div>
</div>

<script>
const graphData = <%- JSON.stringify(graphData) %>;
let network = null;
let macroNetwork = null;
let selectedConcept = null;
let currentSubject = 'Physics';
let currentView = 'chapters'; // 'chapters', 'concepts', or 'drilldown'
let currentChapter = null;
let drilldownConcepts = []; // Concepts loaded during chapter drilldown
let drilldownPrereqs = []; // Prerequisites loaded during chapter drilldown
let cachedChapterPrereqs = []; // Chapter-level prerequisites from last macro render
let cachedChapterMastery = {}; // Chapter-level mastery map from last macro render

function masteryColor(mastery, unlocked, hasStarted) {
    if (!unlocked) return '#6B7280'; // Gray for locked
    if (!hasStarted) return '#22D3EE'; // Cyan — start here (unlocked, no attempts)
    if (mastery >= 0.8) return '#10B981'; // Green — mastered
    if (mastery >= 0.5) return '#F59E0B'; // Yellow — in progress
    return '#EF4444'; // Red — needs work
}

function chapterMasteryColor(mastery, isStartingPoint) {
    if (mastery === null || mastery === undefined) {
        return isStartingPoint ? '#22D3EE' : '#6B7280'; // Cyan for start, gray for locked
    }
    if (mastery >= 0.8) return '#10B981'; // Green
    if (mastery >= 0.5) return '#F59E0B'; // Yellow
    return '#EF4444'; // Red
}

function filterSidebarList(query) {
    const items = document.querySelectorAll('#conceptList .concept-item');
    const q = query.toLowerCase().trim();
    items.forEach(item => {
        const name = item.querySelector('.concept-name')?.textContent.toLowerCase() || '';
        item.style.display = (!q || name.includes(q)) ? '' : 'none';
    });
}

let selectedChapterId = null; // Currently selected chapter in macro view
let chapterInfoShownAt = 0; // Timestamp to prevent immediate dismiss

async function showChapterInfo(chapterId) {
    selectedChapterId = chapterId;
    chapterInfoShownAt = Date.now();
    
    // Hide concept info panel, show chapter info panel
    document.getElementById('infoPanel').classList.add('hidden');
    document.getElementById('chapterInfoPanel').classList.remove('hidden');
    
    // Zoom into the clicked chapter node
    if (macroNetwork) {
        macroNetwork.focus(chapterId, { scale: 1.5, animation: { duration: 400 } });
    }
    
    // Find chapter data from cached nodes or sidebar
    let chapterLabel = chapterId;
    let chapterSubject = currentSubject;
    const chapterNode = macroNetwork?.body?.data?.nodes?.get(chapterId);
    if (chapterNode) {
        chapterLabel = chapterNode.label || chapterId;
        chapterSubject = chapterNode.chapterData?.subject || currentSubject;
    }
    
    const mastery = cachedChapterMastery[chapterId];
    const isStartingPoint = !cachedChapterPrereqs.some(p => p.chapter_id === chapterId);
    
    // Populate header
    document.getElementById('chapterInfoName').textContent = chapterLabel;
    document.getElementById('chapterInfoSubject').textContent = chapterSubject;
    
    // Populate mastery
    if (mastery !== null && mastery !== undefined) {
        document.getElementById('chapterInfoMastery').textContent = Math.round(mastery * 100) + '%';
        document.getElementById('chapterInfoMastery').style.color = chapterMasteryColor(mastery, isStartingPoint);
    } else {
        document.getElementById('chapterInfoMastery').textContent = '—';
        document.getElementById('chapterInfoMastery').style.color = chapterMasteryColor(null, isStartingPoint);
    }
    
    // Determine chapter unlock status
    const prereqChapterIds = cachedChapterPrereqs
        .filter(p => p.chapter_id === chapterId)
        .map(p => p.prereq_id);
    const chapterUnlocked = prereqChapterIds.length === 0 ||
        prereqChapterIds.every(pid => (cachedChapterMastery[pid] || 0) >= 0.8);
    
    if (chapterUnlocked) {
        if (mastery === null || mastery === undefined) {
            document.getElementById('chapterInfoStatus').textContent = '🆕 Not Started';
        } else if (mastery >= 0.8) {
            document.getElementById('chapterInfoStatus').textContent = '✅ Mastered';
        } else {
            document.getElementById('chapterInfoStatus').textContent = '📖 In Progress';
        }
    } else {
        document.getElementById('chapterInfoStatus').textContent = '🔒 Locked';
    }
    
    // Set loading state for subconcepts while fetching
    document.getElementById('chapterInfoConceptCount').textContent = '…';
    document.getElementById('chapterInfoMasteredCount').textContent = '…';
    document.getElementById('chapterConceptsList').innerHTML = '<div style="color:var(--muted);font-size:0.8rem;padding:8px;">Loading…</div>';
    
    // Fetch subconcepts for this chapter
    try {
        const response = await fetch(`/api/chapters/${chapterId}/concepts?userId=${graphData.userId}`);
        // If user clicked a different chapter while we were fetching, bail
        if (selectedChapterId !== chapterId) return;
        if (!response.ok) throw new Error('Failed to fetch');
        const data = await response.json();
        
        document.getElementById('chapterInfoConceptCount').textContent = data.concepts.length;
        
        // Build mastery map
        const mMap = {};
        graphData.mastery.forEach(m => { mMap[m.concept_id] = m; });
        
        const masteredCount = data.concepts.filter(c => (mMap[c.id]?.mastery || 0) >= 0.8).length;
        document.getElementById('chapterInfoMasteredCount').textContent = masteredCount + ' / ' + data.concepts.length;
        
        // Render subconcept list with proper unlock logic
        const listEl = document.getElementById('chapterConceptsList');
        listEl.innerHTML = '';
        
        const pMap = {};
        data.prerequisites.forEach(p => {
            if (!pMap[p.concept_id]) pMap[p.concept_id] = [];
            pMap[p.concept_id].push(p.prereq_id);
        });
        const cIds = new Set(data.concepts.map(c => c.id));
        
        data.concepts.forEach(c => {
            const mEntry = mMap[c.id];
            const m = mEntry?.mastery || 0.2;
            const hasStarted = !!mEntry;
            const prereqs = pMap[c.id] || [];
            const withinChapterPrereqs = prereqs.filter(pid => cIds.has(pid));
            const unlocked = withinChapterPrereqs.length > 0
                ? withinChapterPrereqs.every(pid => (mMap[pid]?.mastery || 0.2) >= 0.8)
                : chapterUnlocked;
            const color = masteryColor(m, unlocked, hasStarted);
            const row = document.createElement('div');
            row.className = 'chapter-concept-row';
            row.innerHTML = `<div class="concept-dot" style="background:${color}"></div><span class="concept-name">${c.name}</span><span class="concept-pct">${hasStarted ? Math.round(m*100)+'%' : '—'}</span>`;
            listEl.appendChild(row);
        });
    } catch (err) {
        if (selectedChapterId !== chapterId) return;
        console.error('Failed to load chapter concepts for info panel:', err);
        document.getElementById('chapterInfoConceptCount').textContent = '?';
        document.getElementById('chapterInfoMasteredCount').textContent = '?';
        document.getElementById('chapterConceptsList').innerHTML = '<div style="color:var(--muted);font-size:0.8rem;padding:8px;">Unable to load subconcepts</div>';
    }
    
    // Highlight in sidebar
    document.querySelectorAll('#conceptList .concept-item').forEach(el => {
        el.classList.toggle('selected', el.dataset.id === chapterId);
    });
}

function enterSelectedChapter() {
    if (selectedChapterId) {
        document.getElementById('chapterInfoPanel').classList.add('hidden');
        drillDownToChapter(selectedChapterId);
    }
}

function showLoading() {
    document.getElementById('loadingIndicator').classList.add('show');
}

function hideLoading() {
    document.getElementById('loadingIndicator').classList.remove('show');
}

function switchView(view) {
    currentView = view;
    currentChapter = null;
    selectedChapterId = null;
    drilldownConcepts = [];
    drilldownPrereqs = [];
    document.querySelectorAll('.view-mode-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.view === view);
    });
    
    if (view === 'chapters') {
        document.getElementById('graph').style.display = 'none';
        document.getElementById('macroGraph').style.display = 'block';
        document.getElementById('breadcrumb').classList.remove('show');
        document.getElementById('infoPanel').classList.add('hidden');
        document.getElementById('chapterInfoPanel').classList.add('hidden');
        renderMacroGraph(currentSubject);
    } else {
        document.getElementById('graph').style.display = 'block';
        document.getElementById('macroGraph').style.display = 'none';
        document.getElementById('breadcrumb').classList.remove('show');
        document.getElementById('infoPanel').classList.add('hidden');
        document.getElementById('chapterInfoPanel').classList.add('hidden');
        renderSidebar(currentSubject);
        initGraph(currentSubject);
    }
}

async function renderMacroGraph(subject) {
    showLoading();
    try {
        // Check if vis-network loaded successfully
        if (typeof vis === 'undefined' || typeof vis.Network === 'undefined') {
            hideLoading();
            const container = document.getElementById('macroGraph');
            container.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Graph visualization unavailable. Please refresh the page or check your internet connection.</p></div>';
            return;
        }
        
        const container = document.getElementById('macroGraph');
        
        if (macroNetwork) macroNetwork.destroy();
        
        // Clear sidebar — will show chapter list after data loads
        document.getElementById('conceptList').innerHTML = '';
        
        // Fetch chapter data from API
        const chaptersResponse = await fetch('/api/chapters');
        if (!chaptersResponse.ok) throw new Error('Failed to fetch chapters');
        const chaptersData = await chaptersResponse.json();
        
        // Fetch user chapter mastery with BKT unavailability handling
        let masteryData = { chapterMastery: [] };
        let bktWarning = false;
        try {
            const masteryResponse = await fetch(`/api/user/${graphData.userId}/chapter-mastery`);
            if (!masteryResponse.ok) throw new Error('Failed to fetch chapter mastery');
            masteryData = await masteryResponse.json();
        } catch (masteryError) {
            console.warn('BKT service may be unavailable, using cached data:', masteryError);
            bktWarning = true;
        }
        
        // Create mastery map for quick lookup
        const masteryMap = {};
        masteryData.chapterMastery.forEach(m => {
            masteryMap[m.chapter_id] = m.mastery;
        });
        
        // Cache for use in drilldown
        cachedChapterPrereqs = chaptersData.prerequisites;
        cachedChapterMastery = masteryMap;
        
        // Check if student has no mastery data at all
        const hasMasteryData = masteryData.chapterMastery.length > 0;
        
        // Filter chapters by subject if needed
        const filteredChapters = chaptersData.chapters.filter(c => {
            if (subject === 'Physics') {
                return c.subject.startsWith('Physics');
            } else if (subject === 'Mathematics') {
                return c.subject.startsWith('Mathematics');
            } else if (subject === 'Chemistry') {
                return c.subject.startsWith('Chemistry');
            }
            return c.subject.startsWith(subject);
        });
        
        // Determine which chapters are starting points (no prerequisites within this subject)
        const chapterIds = new Set(filteredChapters.map(c => c.id));
        const hasPrereqInSubject = new Set();
        chaptersData.prerequisites.forEach(p => {
            if (chapterIds.has(p.chapter_id) && chapterIds.has(p.prereq_id)) {
                hasPrereqInSubject.add(p.chapter_id);
            }
        });
        
        // Build nodes with color-coding based on mastery
        const nodes = filteredChapters.map(chapter => {
            const mastery = masteryMap[chapter.id];
            const isStartingPoint = !hasPrereqInSubject.has(chapter.id);
            const color = chapterMasteryColor(mastery, isStartingPoint);
            const size = 20 + (mastery !== null && mastery !== undefined ? Math.round(mastery * 15) : 0);
            
            return {
                id: chapter.id,
                label: chapter.name,
                color: {
                    background: color,
                    border: color,
                    highlight: { background: color, border: '#F59E0B' }
                },
                font: { color: '#F1F5F9', size: 12 },
                shape: 'dot',
                size: size,
                mastery: mastery,
                chapterData: chapter
            };
        });
        
        // Filter prerequisites to only include chapters in current subject
        const prerequisiteEdges = chaptersData.prerequisites
            .filter(p => chapterIds.has(p.chapter_id) && chapterIds.has(p.prereq_id))
            .map(p => ({
                from: p.prereq_id,
                to: p.chapter_id,
                arrows: 'to',
                color: { color: '#374151', highlight: '#7C3AED' },
                width: 2,
                smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 }
            }));
        
        // Add bridge edges (cross-chapter concept dependencies) with distinct styling
        const bridgeEdgeSet = new Set(prerequisiteEdges.map(e => e.from + '->' + e.to));
        const bridgeEdges = (chaptersData.bridgeEdges || [])
            .filter(b => chapterIds.has(b.from_chapter) && chapterIds.has(b.to_chapter))
            .filter(b => !bridgeEdgeSet.has(b.from_chapter + '->' + b.to_chapter))
            .map(b => ({
                from: b.from_chapter,
                to: b.to_chapter,
                arrows: 'to',
                color: { color: '#A855F7', highlight: '#C084FC' },
                width: 1.5,
                dashes: [8, 4],
                title: b.concept_count + ' cross-chapter concept ' + (b.concept_count === 1 ? 'dependency' : 'dependencies'),
                smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 }
            }));
        
        const edges = [...prerequisiteEdges, ...bridgeEdges];
        
        // Initialize vis-network with hierarchical layout
        macroNetwork = new vis.Network(container, {
            nodes: new vis.DataSet(nodes),
            edges: new vis.DataSet(edges)
        }, {
            layout: {
                hierarchical: {
                    enabled: true,
                    direction: 'LR',
                    sortMethod: 'directed',
                    levelSeparation: 200,
                    nodeSpacing: 100,
                    treeSpacing: 150,
                    blockShifting: true,
                    edgeMinimization: true
                }
            },
            physics: false,
            interaction: { hover: true, tooltipDelay: 200 },
            nodes: { borderWidth: 2 },
            edges: { smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 } }
        });
        
        // Double-click to drill down directly
        macroNetwork.on('doubleClick', params => {
            if (params.nodes.length > 0) {
                const chapterId = params.nodes[0];
                document.getElementById('chapterInfoPanel').classList.add('hidden');
                drillDownToChapter(chapterId);
            }
        });
        
        // Single-click: show chapter info or dismiss panel on empty area
        macroNetwork.on('click', params => {
            if (params.nodes.length > 0) {
                showChapterInfo(params.nodes[0]);
            } else {
                document.getElementById('chapterInfoPanel').classList.add('hidden');
                selectedChapterId = null;
                document.querySelectorAll('#conceptList .concept-item').forEach(el => el.classList.remove('selected'));
            }
        });
        
        // Populate sidebar with chapter list
        const list = document.getElementById('conceptList');
        list.innerHTML = '';
        document.getElementById('sidebarSearch').value = '';
        document.getElementById('sidebarSearch').placeholder = 'Search units...';
        filteredChapters.forEach(ch => {
            const m = masteryMap[ch.id];
            const isStartingPoint = !hasPrereqInSubject.has(ch.id);
            const color = chapterMasteryColor(m, isStartingPoint);
            const div = document.createElement('div');
            div.className = 'concept-item';
            div.dataset.id = ch.id;
            div.innerHTML = `<div class="concept-dot" style="background:${color}"></div><span class="concept-name">${ch.name}</span><span class="concept-pct">${m !== null && m !== undefined ? Math.round(m*100)+'%' : '—'}</span>`;
            div.addEventListener('click', () => showChapterInfo(ch.id));
            list.appendChild(div);
        });
        
        // Show overlay for no mastery data
        if (!hasMasteryData) {
            const overlay = document.createElement('div');
            overlay.style.cssText = 'position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;background:rgba(10,15,30,0.85);padding:1.5rem 2rem;border-radius:12px;border:1px solid #1F2937;z-index:5;pointer-events:none;';
            overlay.innerHTML = '<i class="bi bi-lightbulb" style="font-size:2rem;color:#F59E0B;display:block;margin-bottom:0.5rem;"></i>' +
                '<div style="color:#F1F5F9;font-size:0.9rem;font-weight:600;margin-bottom:0.25rem;">No mastery data yet</div>' +
                '<div style="color:#64748B;font-size:0.8rem;">Start practicing concepts to see your progress here</div>';
            container.style.position = 'relative';
            container.appendChild(overlay);
        }
        
        // Show BKT service warning if applicable
        if (bktWarning) {
            const warning = document.createElement('div');
            warning.style.cssText = 'position:absolute;top:8px;right:8px;background:rgba(245,158,11,0.15);border:1px solid #F59E0B;padding:6px 12px;border-radius:8px;font-size:0.75rem;color:#F59E0B;z-index:5;display:flex;align-items:center;gap:6px;';
            warning.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Using cached mastery data';
            container.style.position = 'relative';
            container.appendChild(warning);
        }
        
        hideLoading();
    } catch (error) {
        console.error('Failed to render macro graph:', error);
        hideLoading();
        // Show error message to user
        const container = document.getElementById('macroGraph');
        container.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Unable to load graph data. Please refresh the page.</p></div>';
    }
}

async function drillDownToChapter(chapterId) {
    // Store current chapter for breadcrumb
    currentChapter = chapterId;
    
    // Switch to drilldown view (distinct from flat 'concepts' view)
    currentView = 'drilldown';
    document.getElementById('macroGraph').style.display = 'none';
    document.getElementById('graph').style.display = 'block';
    
    // Keep "Chapters" button visually active since drilldown is a sub-state of chapters
    document.querySelectorAll('.view-mode-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.view === 'chapters');
    });
    
    // Hide info panels when drilling down
    document.getElementById('infoPanel').classList.add('hidden');
    document.getElementById('chapterInfoPanel').classList.add('hidden');
    
    // Update breadcrumb
    const breadcrumb = document.getElementById('breadcrumb');
    const breadcrumbCurrent = document.getElementById('breadcrumbCurrent');
    
    showLoading();
    try {
        // Fetch chapter concepts
        const response = await fetch(`/api/chapters/${chapterId}/concepts?userId=${graphData.userId}`);
        if (!response.ok) throw new Error('Failed to fetch chapter concepts');
        const data = await response.json();
        
        breadcrumbCurrent.textContent = data.chapter.name;
        breadcrumb.classList.add('show');
        
        // Determine if this chapter is unlocked
        // A chapter is unlocked if ALL its prerequisite chapters have mastery >= 0.8
        const prereqChapterIds = cachedChapterPrereqs
            .filter(p => p.chapter_id === chapterId)
            .map(p => p.prereq_id);
        const chapterUnlocked = prereqChapterIds.length === 0 ||
            prereqChapterIds.every(pid => (cachedChapterMastery[pid] || 0) >= 0.8);
        
        // Render micro graph with concepts
        renderMicroGraph(data, chapterUnlocked);
        
        hideLoading();
    } catch (error) {
        console.error('Failed to drill down to chapter:', error);
        hideLoading();
        alert('Unable to load chapter concepts. Please try again.');
    }
}

function renderMicroGraph(data, chapterUnlocked) {
    // Default to true if not provided (e.g. ghost node navigation)
    if (chapterUnlocked === undefined) chapterUnlocked = true;
    const container = document.getElementById('graph');
    
    // Check if vis-network loaded successfully
    if (typeof vis === 'undefined' || typeof vis.Network === 'undefined') {
        container.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Graph visualization unavailable. Please refresh the page or check your internet connection.</p></div>';
        return;
    }
    
    if (network) network.destroy();
    
    // Check if chapter has no concepts
    if (data.concepts.length === 0) {
        container.innerHTML = '<div class="empty-state"><i class="bi bi-inbox"></i><p>No concepts available for this chapter</p></div>';
        return;
    }
    
    // Create mastery map
    const masteryMap = {};
    graphData.mastery.forEach(m => {
        masteryMap[m.concept_id] = m;
    });
    
    // Build prerequisite lookup for unlock state
    const prereqMap = {};
    data.prerequisites.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        prereqMap[p.concept_id].push(p.prereq_id);
    });
    
    // Build nodes for regular concepts
    const conceptIds = new Set(data.concepts.map(c => c.id));
    const nodes = data.concepts.map(c => {
        const mEntry = masteryMap[c.id];
        const m = mEntry?.mastery || 0.2;
        const hasStarted = !!mEntry; // Has the student attempted this concept?
        const prereqs = prereqMap[c.id] || [];
        const withinChapterPrereqs = prereqs.filter(pid => conceptIds.has(pid));
        // Entry-point concepts (no within-chapter prereqs) are gated by chapter unlock
        // Other concepts are gated by their within-chapter prereqs being mastered
        const unlocked = withinChapterPrereqs.length > 0
            ? withinChapterPrereqs.every(pid => (masteryMap[pid]?.mastery || 0.2) >= 0.8)
            : chapterUnlocked;
        const color = masteryColor(m, unlocked, hasStarted);
        
        return {
            id: c.id,
            label: c.name.length > 22 ? c.name.substring(0, 20) + '…' : c.name,
            fullName: c.name,
            color: {
                background: color,
                border: color,
                highlight: { background: color, border: '#F59E0B' }
            },
            font: { color: '#F1F5F9', size: 11 },
            shape: 'dot',
            size: 18 + Math.round(m * 14),
            mastery: m,
            isGhost: false
        };
    });
    
    // Add ghost nodes for cross-chapter prerequisites
    // Only show ghost nodes where student mastery is below 60% (conditional rendering)
    const ghostNodes = (data.ghostNodes || [])
        .filter(g => {
            const m = masteryMap[g.id]?.mastery || 0.2;
            return m < 0.6; // Hide ghost nodes the student already knows
        })
        .map(g => {
        const m = masteryMap[g.id]?.mastery || 0.2;
        
        return {
            id: g.id,
            label: `${g.name}\n(${g.chapter_name})`,
            fullName: g.name,
            color: {
                background: '#6B7280',
                border: '#9CA3AF'
            },
            font: { color: '#F1F5F9', size: 10 },
            shape: 'dot',
            size: 16,
            borderWidth: 2,
            borderWidthSelected: 3,
            shapeProperties: {
                borderDashes: [5, 5] // Dashed border for ghost nodes
            },
            mastery: m,
            isGhost: true,
            sourceChapterId: g.chapter_id
        };
    });
    
    const allNodes = [...nodes, ...ghostNodes];
    const allNodeIds = new Set(allNodes.map(n => n.id));
    
    // Build edges — only include edges where both endpoints exist as nodes
    const edges = data.prerequisites
        .filter(p => allNodeIds.has(p.prereq_id) && allNodeIds.has(p.concept_id))
        .map(p => ({
        from: p.prereq_id,
        to: p.concept_id,
        arrows: 'to',
        color: { color: '#374151', highlight: '#7C3AED' },
        width: 1.5,
        smooth: { type: 'curvedCW', roundness: 0.2 }
    }));
    
    // Update sidebar with chapter concepts
    const list = document.getElementById('conceptList');
    list.innerHTML = '';
    document.getElementById('sidebarSearch').value = '';
    document.getElementById('sidebarSearch').placeholder = 'Search concepts...';
    
    // Store drilldown data for selectConcept to use
    drilldownConcepts = data.concepts;
    drilldownPrereqs = data.prerequisites;
    
    data.concepts.forEach(c => {
        const mEntry = masteryMap[c.id];
        const m = mEntry?.mastery || 0.2;
        const hasStarted = !!mEntry;
        const prereqs = prereqMap[c.id] || [];
        const withinChapterPrereqs = prereqs.filter(pid => conceptIds.has(pid));
        const unlocked = withinChapterPrereqs.length > 0
            ? withinChapterPrereqs.every(pid => (masteryMap[pid]?.mastery || 0.2) >= 0.8)
            : chapterUnlocked;
        const color = masteryColor(m, unlocked, hasStarted);
        const div = document.createElement('div');
        div.className = 'concept-item' + (unlocked ? '' : ' locked');
        div.dataset.id = c.id;
        div.innerHTML = `<div class="concept-dot" style="background:${color}"></div><span class="concept-name">${c.name}</span><span class="concept-pct">${Math.round(m*100)}%</span>`;
        div.addEventListener('click', () => unlocked && selectConcept(c.id));
        list.appendChild(div);
    });
    
    // Initialize vis-network
    network = new vis.Network(container, {
        nodes: new vis.DataSet(allNodes),
        edges: new vis.DataSet(edges)
    }, {
        layout: {
            hierarchical: {
                enabled: true,
                direction: 'LR',
                sortMethod: 'directed',
                levelSeparation: 220,
                nodeSpacing: 90,
                treeSpacing: 140,
                blockShifting: true,
                edgeMinimization: true
            }
        },
        physics: false,
        interaction: { hover: true, tooltipDelay: 200 },
        nodes: { borderWidth: 2 },
        edges: { smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 } }
    });
    
    // Add click event handler
    network.on('click', params => {
        if (params.nodes.length > 0) {
            const nodeId = params.nodes[0];
            const nodeData = allNodes.find(n => n.id === nodeId);
            
            // If it's a ghost node, navigate to its source chapter
            if (nodeData && nodeData.isGhost) {
                drillDownToChapter(nodeData.sourceChapterId);
            } else {
                // Regular concept - show info panel
                selectConcept(nodeId);
            }
        } else {
            // Clicked empty area — dismiss info panel
            document.getElementById('infoPanel').classList.add('hidden');
            selectedConcept = null;
            document.querySelectorAll('#conceptList .concept-item').forEach(el => el.classList.remove('selected'));
        }
    });
}

function buildGraph(subject) {
    const concepts = graphData.concepts.filter(c => c.subject === subject || c.subject.startsWith(subject));
    const conceptIds = new Set(concepts.map(c => c.id));
    const masteryMap = {};
    graphData.mastery.forEach(m => { masteryMap[m.concept_id] = m; });
    const prereqMap = {};
    graphData.prereqs.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        prereqMap[p.concept_id].push(p.prereq_id);
    });

    // Determine unlocked state
    const unlockedMap = {};
    concepts.forEach(c => {
        const prereqs = prereqMap[c.id] || [];
        unlockedMap[c.id] = prereqs.every(pid => (masteryMap[pid]?.mastery || 0.2) >= 0.8);
    });

    const nodes = concepts.map(c => {
        const mEntry = masteryMap[c.id];
        const m = mEntry?.mastery || 0.2;
        const hasStarted = !!mEntry;
        const unlocked = unlockedMap[c.id];
        const color = masteryColor(m, unlocked, hasStarted);
        return {
            id: c.id,
            label: c.name.length > 22 ? c.name.substring(0, 20) + '…' : c.name,
            fullName: c.name,
            color: { background: color, border: color, highlight: { background: color, border: '#F59E0B' } },
            font: { color: '#F1F5F9', size: 11 },
            shape: 'dot',
            size: 18 + Math.round(m * 14),
            mastery: m,
            unlocked,
            subject: c.subject
        };
    });

    const edges = graphData.prereqs
        .filter(p => conceptIds.has(p.concept_id) && conceptIds.has(p.prereq_id))
        .map(p => ({
            from: p.prereq_id,
            to: p.concept_id,
            arrows: 'to',
            color: { color: '#374151', highlight: '#7C3AED' },
            width: 1.5,
            smooth: { type: 'curvedCW', roundness: 0.2 }
        }));

    return { nodes, edges };
}

function renderSidebar(subject) {
    const concepts = graphData.concepts.filter(c => c.subject === subject || c.subject.startsWith(subject));
    const masteryMap = {};
    graphData.mastery.forEach(m => { masteryMap[m.concept_id] = m; });
    const prereqMap = {};
    graphData.prereqs.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        prereqMap[p.concept_id].push(p.prereq_id);
    });

    const list = document.getElementById('conceptList');
    list.innerHTML = '';
    document.getElementById('sidebarSearch').value = '';
    document.getElementById('sidebarSearch').placeholder = 'Search concepts...';
    concepts.forEach(c => {
        const mEntry = masteryMap[c.id];
        const m = mEntry?.mastery || 0.2;
        const hasStarted = !!mEntry;
        const prereqs = prereqMap[c.id] || [];
        const unlocked = prereqs.every(pid => (masteryMap[pid]?.mastery || 0.2) >= 0.8);
        const color = masteryColor(m, unlocked, hasStarted);
        const div = document.createElement('div');
        div.className = 'concept-item' + (unlocked ? '' : ' locked');
        div.dataset.id = c.id;
        div.innerHTML = `<div class="concept-dot" style="background:${color}"></div><span class="concept-name">${c.name}</span><span class="concept-pct">${Math.round(m*100)}%</span>`;
        div.addEventListener('click', () => unlocked && selectConcept(c.id));
        list.appendChild(div);
    });
}

function initGraph(subject) {
    // Check if vis-network loaded successfully
    if (typeof vis === 'undefined' || typeof vis.Network === 'undefined') {
        const container = document.getElementById('graph');
        container.innerHTML = '<div class="empty-state"><i class="bi bi-exclamation-triangle"></i><p>Graph visualization unavailable. Please refresh the page or check your internet connection.</p></div>';
        return;
    }
    
    const { nodes, edges } = buildGraph(subject);
    const container = document.getElementById('graph');

    if (network) network.destroy();

    // Topological level assignment (Kahn's algorithm)
    const inDegree = {};
    const adjList = {};
    nodes.forEach(n => { inDegree[n.id] = 0; adjList[n.id] = []; });
    edges.forEach(e => { inDegree[e.to] = (inDegree[e.to] || 0) + 1; adjList[e.from].push(e.to); });
    const levelMap = {};
    const queue = nodes.filter(n => inDegree[n.id] === 0).map(n => n.id);
    queue.forEach(id => { levelMap[id] = 0; });
    let head = 0;
    while (head < queue.length) {
        const cur = queue[head++];
        (adjList[cur] || []).forEach(next => {
            levelMap[next] = Math.max(levelMap[next] || 0, levelMap[cur] + 1);
            inDegree[next]--;
            if (inDegree[next] === 0) queue.push(next);
        });
    }
    const leveledNodes = nodes.map(n => ({ ...n, level: levelMap[n.id] ?? 0 }));

    network = new vis.Network(container, {
        nodes: new vis.DataSet(leveledNodes),
        edges: new vis.DataSet(edges)
    }, {
        layout: {
            hierarchical: {
                enabled: true,
                direction: 'LR',
                sortMethod: 'directed',
                levelSeparation: 220,
                nodeSpacing: 90,
                treeSpacing: 140,
                blockShifting: true,
                edgeMinimization: true
            }
        },
        physics: false,
        interaction: { hover: true, tooltipDelay: 200 },
        nodes: { borderWidth: 2 },
        edges: { smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 } }
    });

    network.on('click', params => {
        if (params.nodes.length > 0) selectConcept(params.nodes[0]);
    });
}

function selectConcept(id) {
    selectedConcept = id;
    const masteryMap = {};
    graphData.mastery.forEach(m => { masteryMap[m.concept_id] = m; });
    const prereqMap = {};
    graphData.prereqs.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        prereqMap[p.concept_id].push(p.prereq_id);
    });
    // Also include drilldown prerequisites
    drilldownPrereqs.forEach(p => {
        if (!prereqMap[p.concept_id]) prereqMap[p.concept_id] = [];
        if (!prereqMap[p.concept_id].includes(p.prereq_id)) {
            prereqMap[p.concept_id].push(p.prereq_id);
        }
    });
    const conceptMap = {};
    graphData.concepts.forEach(c => { conceptMap[c.id] = c; });
    // Also include drilldown concepts
    drilldownConcepts.forEach(c => { if (!conceptMap[c.id]) conceptMap[c.id] = c; });

    const c = conceptMap[id];
    if (!c) return; // Concept not found, bail out
    const mData = masteryMap[id] || { mastery: 0.2, questions_answered: 0, correct_answers: 0 };
    const hasStarted = !!masteryMap[id];
    const prereqs = prereqMap[id] || [];
    const unlocked = prereqs.every(pid => (masteryMap[pid]?.mastery || 0.2) >= 0.8);

    document.getElementById('infoName').textContent = c.name;
    document.getElementById('infoSubject').textContent = c.subject || currentSubject;
    document.getElementById('infoMastery').textContent = Math.round(mData.mastery * 100) + '%';
    document.getElementById('infoMastery').style.color = masteryColor(mData.mastery, unlocked, hasStarted);
    document.getElementById('infoQA').textContent = mData.questions_answered || 0;
    document.getElementById('infoCorrect').textContent = mData.correct_answers || 0;
    document.getElementById('infoStatus').textContent = !unlocked ? '🔒 Locked' : !hasStarted ? '🆕 Not Started' : mData.mastery >= 0.8 ? '✅ Mastered' : '📖 In Progress';

    // Prerequisites
    const prereqListEl = document.getElementById('prereqList');
    if (prereqs.length > 0) {
        prereqListEl.innerHTML = '<h6>Prerequisites</h6>' + prereqs.map(pid => {
            const pm = masteryMap[pid]?.mastery || 0.2;
            const done = pm >= 0.8;
            const weak = pm < 0.5;
            const className = done ? 'done' : weak ? 'weak' : '';
            return `<span class="prereq-tag ${className}" onclick="selectConcept('${pid}')" title="${Math.round(pm*100)}% mastery">${conceptMap[pid]?.name || pid}</span>`;
        }).join('');
    } else {
        prereqListEl.innerHTML = '';
    }

    // Show learning path if concept is locked or struggling
    const learningPathEl = document.getElementById('learningPath');
    const pathStepsEl = document.getElementById('pathSteps');
    if (!unlocked || (mData.questions_answered >= 5 && mData.mastery < 0.5)) {
        // Get optimal path (weak prerequisites + target)
        const weakPrereqs = prereqs.filter(pid => (masteryMap[pid]?.mastery || 0.2) < 0.7)
            .sort((a, b) => (masteryMap[a]?.mastery || 0.2) - (masteryMap[b]?.mastery || 0.2));
        const path = [...weakPrereqs, id];
        
        pathStepsEl.innerHTML = path.map((cid, i) => {
            const cm = masteryMap[cid]?.mastery || 0.2;
            const isDone = cm >= 0.8;
            const isCurrent = cid === id || (!isDone && i === path.findIndex(p => (masteryMap[p]?.mastery || 0.2) < 0.8));
            const stepClass = isDone ? 'done' : isCurrent ? 'current' : '';
            return `<div class="path-step ${isCurrent ? 'current' : ''}" onclick="selectConcept('${cid}')">
                <div class="step-num ${stepClass}">${isDone ? '✓' : i + 1}</div>
                <span>${conceptMap[cid]?.name || cid}</span>
                <span style="margin-left:auto;font-size:0.65rem;color:var(--muted)">${Math.round(cm*100)}%</span>
            </div>`;
        }).join('');
        learningPathEl.style.display = 'block';
    } else {
        learningPathEl.style.display = 'none';
    }

    document.getElementById('lockedMsg').style.display = unlocked ? 'none' : 'block';
    document.getElementById('btnPractice').disabled = !unlocked;

    document.getElementById('infoPanel').classList.remove('hidden');

    // Highlight in sidebar
    document.querySelectorAll('.concept-item').forEach(el => el.classList.remove('selected'));
    const sidebarItem = document.querySelector(`.concept-item[data-id="${id}"]`);
    if (sidebarItem) sidebarItem.classList.add('selected');

    // Focus node in graph
    if (network) network.focus(id, { scale: 1.2, animation: { duration: 400 } });
}

function startPractice() {
    if (selectedConcept) window.location.href = `/practice/${selectedConcept}`;
}

let diagnosisRunning = false;

async function diagnoseConcept() {
    if (!selectedConcept || diagnosisRunning) return;
    
    diagnosisRunning = true;
    const btn = document.getElementById('btnDiagnose');
    btn.disabled = true;
    btn.textContent = '🔍 Diagnosing...';
    
    try {
        const response = await fetch('/api/diagnose-concept', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ conceptId: selectedConcept })
        });
        
        if (!response.ok) throw new Error('Diagnosis failed');
        
        const reader = response.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        
        while (true) {
            const { done, value } = await reader.read();
            if (done) break;
            
            buffer += decoder.decode(value, { stream: true });
            const lines = buffer.split('\n');
            buffer = lines.pop();
            
            for (const line of lines) {
                if (line.startsWith('data: ')) {
                    try {
                        const data = JSON.parse(line.slice(6));
                        
                        if (data.type === 'checking') {
                            // Highlight node being checked
                            network.selectNodes([data.conceptId]);
                            network.focus(data.conceptId, { scale: 1.5, animation: { duration: 300 } });
                        } else if (data.type === 'gap') {
                            // Mark as gap (red)
                            const update = { id: data.conceptId, color: { background: '#EF4444', border: '#DC2626' } };
                            network.setData({ nodes: network.body.data.nodes.update(update), edges: network.body.data.edges });
                        } else if (data.type === 'ok') {
                            // Mark as OK (green pulse)
                            const update = { id: data.conceptId, color: { background: '#10B981', border: '#059669' } };
                            network.setData({ nodes: network.body.data.nodes.update(update), edges: network.body.data.edges });
                        } else if (data.type === 'complete') {
                            // Reset selection
                            network.unselectAll();
                            if (data.gapsFound > 0) {
                                alert(`Diagnosis complete! Found ${data.gapsFound} prerequisite gaps (marked in red).`);
                            } else {
                                alert('Great! All prerequisites are mastered.');
                            }
                        }
                    } catch (e) {
                        console.warn('Failed to parse SSE data:', line);
                    }
                }
            }
        }
        
    } catch (error) {
        alert(`Diagnosis failed: ${error.message}`);
    } finally {
        diagnosisRunning = false;
        btn.disabled = false;
        btn.textContent = '🔍 Diagnose Prerequisites';
    }
}

function switchSubject(subject) {
    currentSubject = subject;
    document.querySelectorAll('.subject-tab').forEach(t => t.classList.toggle('active', t.dataset.subject === subject));
    document.getElementById('infoPanel').classList.add('hidden');
    document.getElementById('chapterInfoPanel').classList.add('hidden');
    selectedConcept = null;
    selectedChapterId = null;
    currentChapter = null;
    
    // Always reset to macro chapter view when switching subjects
    if (currentView === 'drilldown') {
        currentView = 'chapters';
        document.getElementById('graph').style.display = 'none';
        document.getElementById('macroGraph').style.display = 'block';
        document.getElementById('breadcrumb').classList.remove('show');
        document.querySelectorAll('.view-mode-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.view === 'chapters');
        });
    }
    
    if (currentView === 'chapters') {
        renderMacroGraph(subject);
    } else {
        renderSidebar(subject);
        initGraph(subject);
    }
}

// Controls
document.getElementById('zoomIn').addEventListener('click', () => {
    const activeNetwork = currentView === 'chapters' ? macroNetwork : network;
    activeNetwork?.moveTo({ scale: activeNetwork.getScale() * 1.3 });
});
document.getElementById('zoomOut').addEventListener('click', () => {
    const activeNetwork = currentView === 'chapters' ? macroNetwork : network;
    activeNetwork?.moveTo({ scale: activeNetwork.getScale() * 0.77 });
});
document.getElementById('fitGraph').addEventListener('click', () => {
    const activeNetwork = currentView === 'chapters' ? macroNetwork : network;
    activeNetwork?.fit({ animation: true });
});
document.querySelectorAll('.subject-tab').forEach(t => t.addEventListener('click', () => switchSubject(t.dataset.subject)));
document.querySelectorAll('.view-mode-btn').forEach(btn => btn.addEventListener('click', () => switchView(btn.dataset.view)));

// Breadcrumb back button
document.getElementById('breadcrumbBack').addEventListener('click', (e) => {
    e.preventDefault();
    switchView('chapters');
});

// Init
switchView('chapters');

// Today's Mission: find highest-priority yellow concept
(function initMission() {
    const concepts = <%- JSON.stringify(typeof concepts !== 'undefined' ? concepts : []) %>;
    // Find in-progress concepts (mastery 0.01-0.79) sorted by lowest mastery
    const inProgress = concepts
        .filter(c => c.mastery > 0 && c.mastery < 0.8 && !c.locked)
        .sort((a, b) => a.mastery - b.mastery);
    if (inProgress.length > 0) {
        const mission = inProgress[0];
        document.getElementById('missionConceptName').textContent = mission.name;
        document.getElementById('missionMastery').textContent = Math.round(mission.mastery * 100) + '% mastery';
        document.getElementById('todaysMission').style.display = 'block';
        window._missionConceptId = mission.id;
    }
})();
function navigateToMission() {
    if (window._missionConceptId) window.location.href = '/practice/' + window._missionConceptId;
}
</script>
