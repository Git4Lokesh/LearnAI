<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diagnostic Assessment — Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$','$'],['\\(','\\)']],
        displayMath: [['$$','$$'],['\\[','\\]']],
        processEscapes: true, processEnvironments: true
      },
      options: { renderActions: { addMenu: [] } }
    };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <style>
        :root {
            --bg: #0A0F1E;
            --surface: #111827;
            --card: #1E293B;
            --border: #1F2937;
            --purple: #7C3AED;
            --blue: #2563EB;
            --gold: #F59E0B;
            --cyan: #22D3EE;
            --green: #10B981;
            --red: #EF4444;
            --text: #F1F5F9;
            --muted: #94A3B8;
            --dim: #64748B;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: var(--bg); color: var(--text); font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; }

        nav {
            background: rgba(17,24,39,0.95);
            border-bottom: 1px solid var(--border);
            padding: 0 1.5rem;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            backdrop-filter: blur(12px);
        }
        .brand { color: var(--gold); font-weight: 700; font-size: 1.2rem; text-decoration: none; display: flex; align-items: center; gap: 8px; }
        .badge-diag { background: rgba(124,58,237,0.2); color: #A78BFA; border: 1px solid rgba(124,58,237,0.3); border-radius: 8px; padding: 4px 12px; font-size: 0.8rem; }

        .diag-wrap { max-width: 680px; margin: 0 auto; padding: 2rem 1rem; }

        .diag-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 16px 48px rgba(0,0,0,0.3);
            overflow: hidden;
        }
        .diag-body { padding: 2.5rem; }

        /* Welcome screen */
        .welcome-icon { color: var(--gold); font-size: 3rem; margin-bottom: 1rem; }
        .welcome-title { color: var(--gold); font-size: 1.8rem; font-weight: 700; margin-bottom: 0.75rem; }
        .welcome-desc { color: var(--muted); font-size: 0.95rem; line-height: 1.6; max-width: 480px; margin: 0 auto 1.5rem; }

        .stat-grid { display: flex; gap: 12px; justify-content: center; margin-bottom: 1.5rem; }
        .stat-box {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem 1.5rem;
            text-align: center;
            min-width: 100px;
        }
        .stat-num { color: var(--gold); font-size: 1.5rem; font-weight: 700; }
        .stat-label { color: var(--dim); font-size: 0.75rem; margin-top: 2px; }

        .hint { color: var(--dim); font-size: 0.82rem; margin-bottom: 1.5rem; }
        .hint i { color: var(--cyan); }

        .btn-start {
            background: linear-gradient(135deg, var(--purple), var(--blue));
            border: none; color: white; padding: 14px 40px; border-radius: 10px;
            font-weight: 600; font-size: 1rem; cursor: pointer; transition: all 0.2s;
        }
        .btn-start:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(124,58,237,0.4); }

        .skip-link { color: var(--dim); font-size: 0.8rem; text-decoration: none; display: inline-block; margin-top: 1rem; transition: color 0.2s; }
        .skip-link:hover { color: var(--muted); }

        /* Question screen */
        .progress-header { padding: 1.25rem 2rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
        .progress-count { color: var(--muted); font-size: 0.82rem; }
        .progress-bar-wrap { height: 4px; background: var(--border); border-radius: 2px; flex: 1; margin: 0 1rem; }
        .progress-fill { height: 100%; background: linear-gradient(90deg, var(--purple), var(--cyan)); border-radius: 2px; transition: width 0.3s; }

        .concept-badge {
            display: inline-block;
            background: rgba(124,58,237,0.15);
            color: #A78BFA;
            border: 1px solid rgba(124,58,237,0.25);
            border-radius: 6px;
            padding: 3px 10px;
            font-size: 0.78rem;
            margin-bottom: 1rem;
        }

        .feedback {
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 0.82rem;
            margin-bottom: 1rem;
        }
        .feedback-correct { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.25); color: var(--green); }
        .feedback-wrong { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.25); color: var(--red); }

        .question-text { font-size: 1.05rem; line-height: 1.6; color: var(--text); margin-bottom: 1.25rem; }

        .option-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.5rem; }
        .option-item {
            display: flex; align-items: center; gap: 12px;
            background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
            padding: 12px 16px; cursor: pointer; transition: all 0.15s;
        }
        .option-item:hover { border-color: var(--purple); background: rgba(124,58,237,0.05); }
        .option-item input[type="radio"] { accent-color: var(--purple); width: 16px; height: 16px; cursor: pointer; }
        .option-item span { color: var(--text); font-size: 0.92rem; line-height: 1.4; }

        .q-footer { display: flex; justify-content: space-between; align-items: center; }
        .btn-next {
            background: linear-gradient(135deg, var(--purple), var(--blue));
            border: none; color: white; padding: 10px 28px; border-radius: 10px;
            font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: all 0.2s;
        }
        .btn-next:hover { opacity: 0.9; transform: translateY(-1px); }

        /* No question fallback */
        .empty-msg { color: var(--muted); text-align: center; padding: 2rem 0; }

        @media (max-width: 640px) {
            .diag-body { padding: 1.5rem; }
            .stat-grid { flex-direction: column; align-items: center; }
            .stat-box { width: 100%; }
        }
    </style>
</head>
<body>
<nav>
    <a class="brand" href="/"><i class="bi bi-diagram-3-fill"></i> Learn.ai</a>
    <span class="badge-diag"><i class="bi bi-clipboard2-pulse me-1"></i> Diagnostic</span>
</nav>

<div class="diag-wrap">

<% if (!diagnostic.started) { %>
    <!-- ── Welcome Screen ── -->
    <div class="diag-card">
        <div class="diag-body" style="text-align:center;">
            <div class="welcome-icon"><i class="bi bi-clipboard2-pulse"></i></div>
            <h2 class="welcome-title">Diagnostic Assessment</h2>
            <p class="welcome-desc">
                Welcome, <strong><%= user.name || 'Student' %></strong>. This adaptive test will map your current knowledge across Physics, Chemistry, and Mathematics — so your learning path is personalized from Day 1.
            </p>
            <div class="stat-grid">
                <div class="stat-box">
                    <div class="stat-num">45</div>
                    <div class="stat-label">Questions</div>
                </div>
                <div class="stat-box">
                    <div class="stat-num">3</div>
                    <div class="stat-label">Subjects</div>
                </div>
                <div class="stat-box">
                    <div class="stat-num">~30</div>
                    <div class="stat-label">Minutes</div>
                </div>
            </div>
            <p class="hint"><i class="bi bi-info-circle me-1"></i> The test adapts to your level. Don't worry about getting everything right — it's about finding where you are.</p>
            <form action="/diagnostic/start" method="POST">
                <button type="submit" class="btn-start"><i class="bi bi-play-fill me-2"></i>Start Assessment</button>
            </form>
            <a href="/diagnostic/skip" class="skip-link">Skip for now (start with default levels)</a>
        </div>
    </div>

<% } else if (question) { %>
    <!-- ── Question Screen ── -->
    <div class="diag-card">
        <div class="progress-header">
            <span class="progress-count">Q<%= diagnostic.questionIndex + 1 %></span>
            <div class="progress-bar-wrap">
                <div class="progress-fill" style="width:<%= (diagnostic.questionIndex / diagnostic.totalQuestions) * 100 %>%"></div>
            </div>
            <span class="progress-count"><%= diagnostic.questionIndex + 1 %>/<%= diagnostic.totalQuestions %></span>
        </div>
        <div class="diag-body">
            <div class="concept-badge"><%= diagnostic.currentConceptName || diagnostic.currentConceptId %></div>

            <% if (diagnostic.lastAnswer) { %>
            <div class="feedback <%= diagnostic.lastAnswer.correct ? 'feedback-correct' : 'feedback-wrong' %>">
                <%= diagnostic.lastAnswer.correct ? '✓ Correct' : '✗ Incorrect' %> — <%= diagnostic.lastAnswer.conceptName %>
            </div>
            <% } %>

            <div class="question-text"><%= question.question_text %></div>

            <form action="/diagnostic/answer" method="POST">
                <div class="option-list">
                    <% ['option1','option2','option3','option4'].forEach(function(opt) { %>
                    <label class="option-item">
                        <input type="radio" name="answer" value="<%= opt %>" required>
                        <span><%= question[opt] %></span>
                    </label>
                    <% }) %>
                </div>
                <div class="q-footer">
                    <button type="submit" class="btn-next">
                        <i class="bi bi-arrow-right me-1"></i>
                        <%= diagnostic.questionIndex + 1 >= diagnostic.totalQuestions ? 'Finish' : 'Next' %>
                    </button>
                    <a href="/diagnostic/skip" class="skip-link">Skip remaining</a>
                </div>
            </form>
        </div>
    </div>

<% } else { %>
    <!-- ── No question fallback ── -->
    <div class="diag-card">
        <div class="diag-body">
            <p class="empty-msg">No questions available for this concept. Continuing to next.</p>
            <form action="/diagnostic/answer" method="POST" style="text-align:center;">
                <input type="hidden" name="answer" value="skip">
                <button type="submit" class="btn-next">Continue</button>
            </form>
        </div>
    </div>
<% } %>

</div>
<script src="/js/translator.js"></script>
</body>
</html>
