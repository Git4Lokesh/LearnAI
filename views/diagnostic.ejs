<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diagnostic Test — Learn.ai</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$','$'],['\\(','\\)']],
        displayMath: [['$$','$$'],['\\[','\\]']],
        processEscapes: true,
        processEnvironments: true
      },
      options: { renderActions: { addMenu: [] } }
    };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <style>
        /* ── Welcome Screen ── */
        .welcome-wrap { max-width: 680px; margin: 0 auto; padding: 3rem 1rem; }
        .welcome-card {
            background: var(--glass-bg);
            backdrop-filter: blur(var(--glass-blur));
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-xl);
            box-shadow: var(--shadow-xl);
            padding: 3rem 2.5rem;
            text-align: center;
        }
        .welcome-icon { font-size: 3.5rem; color: var(--gold); margin-bottom: 1rem; }
        .welcome-title { font-size: 1.8rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem; }
        .welcome-greeting { color: var(--purple-light); font-size: 1.1rem; margin-bottom: 1.5rem; }
        .welcome-desc { color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; max-width: 500px; margin: 0 auto 2rem; }

        .info-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 2rem; }
        .info-box {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1rem 0.75rem;
            text-align: center;
        }
        .info-box .num { font-size: 1.4rem; font-weight: 700; color: var(--gold); }
        .info-box .label { font-size: 0.72rem; color: var(--text-dim); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }

        .marking-info {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: center;
            gap: 2rem;
            font-size: 0.85rem;
        }
        .marking-info .mark { display: flex; align-items: center; gap: 6px; }
        .marking-info .mark-val { font-weight: 700; }
        .marking-info .mark-val.correct { color: var(--green); }
        .marking-info .mark-val.incorrect { color: var(--red); }
        .marking-info .mark-val.skip { color: var(--text-muted); }

        .btn-start-test {
            background: var(--gradient-purple);
            border: none; color: #fff; padding: 14px 48px; border-radius: var(--radius);
            font-weight: 600; font-size: 1rem; cursor: pointer; transition: var(--transition);
            box-shadow: var(--shadow-glow-purple);
        }
        .btn-start-test:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 8px 30px rgba(124,58,237,0.5); }

        .skip-link {
            display: inline-block; margin-top: 1.25rem;
            color: var(--text-dim); font-size: 0.82rem; text-decoration: none;
            transition: var(--transition);
        }
        .skip-link:hover { color: var(--text-secondary); }

        /* ── Test UI Layout ── */
        .test-container { display: flex; flex-direction: column; height: 100vh; overflow: hidden; }

        /* Header */
        .test-header {
            background: var(--gradient-header);
            border-bottom: 1px solid var(--border);
            padding: 0 1.5rem;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            z-index: 100;
        }
        .test-header .logo { color: var(--gold); font-weight: 700; font-size: 1.15rem; text-decoration: none; display: flex; align-items: center; gap: 8px; }
        .test-header .student-info { display: flex; align-items: center; gap: 12px; font-size: 0.85rem; }
        .test-header .student-name { color: var(--text-primary); font-weight: 600; }
        .test-header .section-indicator {
            background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15);
            border-radius: var(--radius-pill); padding: 4px 14px; font-size: 0.78rem; color: var(--text-secondary);
        }
        .test-header .timer {
            font-family: 'Courier New', monospace; font-size: 1.2rem; font-weight: 700;
            color: var(--green-light); letter-spacing: 1px;
        }
        .test-header .timer.timer-warning { color: var(--red); animation: pulse-timer 1s ease-in-out infinite; }
        @keyframes pulse-timer { 0%,100% { opacity: 1; } 50% { opacity: 0.6; } }

        /* Section Tabs */
        .section-tabs {
            display: flex; background: var(--surface); border-bottom: 1px solid var(--border);
            flex-shrink: 0; padding: 0 1rem;
        }
        .section-tab {
            padding: 12px 24px; cursor: pointer; font-size: 0.88rem; font-weight: 500;
            color: var(--text-muted); border-bottom: 3px solid transparent;
            transition: var(--transition); user-select: none;
        }
        .section-tab:hover { color: var(--text-secondary); background: rgba(255,255,255,0.02); }
        .section-tab.active { color: var(--purple-light); border-bottom-color: var(--purple); font-weight: 600; }

        /* Main body: question + palette */
        .test-body { display: flex; flex: 1; overflow: hidden; }

        /* Question area */
        .question-panel {
            flex: 1; overflow-y: auto; padding: 2rem 2.5rem;
            display: flex; flex-direction: column;
        }
        .q-header { display: flex; align-items: center; gap: 12px; margin-bottom: 1.25rem; }
        .q-number { font-size: 1.1rem; font-weight: 700; color: var(--text-primary); }
        .q-difficulty {
            font-size: 0.7rem; font-weight: 600; padding: 3px 10px;
            border-radius: var(--radius-pill); text-transform: uppercase; letter-spacing: 0.5px;
        }
        .q-difficulty.tier-1 { background: rgba(16,185,129,0.15); color: var(--green); border: 1px solid rgba(16,185,129,0.3); }
        .q-difficulty.tier-2 { background: rgba(245,158,11,0.15); color: var(--gold); border: 1px solid rgba(245,158,11,0.3); }
        .q-difficulty.tier-3 { background: rgba(239,68,68,0.15); color: var(--red); border: 1px solid rgba(239,68,68,0.3); }

        .q-text { font-size: 1.05rem; line-height: 1.7; color: var(--text); margin-bottom: 1.5rem; }

        .options-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.5rem; }
        .option-item {
            display: flex; align-items: flex-start; gap: 14px;
            background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
            padding: 14px 18px; cursor: pointer; transition: var(--transition);
        }
        .option-item:hover { border-color: var(--purple); background: rgba(124,58,237,0.05); }
        .option-item.selected { border-color: var(--purple); background: rgba(124,58,237,0.1); box-shadow: var(--shadow-glow-purple); }
        .option-item input[type="radio"] { accent-color: var(--purple); width: 18px; height: 18px; margin-top: 2px; cursor: pointer; flex-shrink: 0; }
        .option-label-letter {
            width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            font-weight: 700; font-size: 0.82rem; flex-shrink: 0;
            background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary);
        }
        .option-item.selected .option-label-letter { background: var(--purple); border-color: var(--purple); color: #fff; }
        .option-text { font-size: 0.95rem; line-height: 1.5; color: var(--text); padding-top: 3px; }

        /* ── Question Palette (right panel) ── */
        .palette-panel {
            width: 280px; flex-shrink: 0; background: var(--glass-bg);
            backdrop-filter: blur(var(--glass-blur)); border-left: 1px solid var(--glass-border);
            display: flex; flex-direction: column; overflow-y: auto;
        }
        .palette-section-title {
            font-size: 0.72rem; font-weight: 600; color: var(--text-muted);
            text-transform: uppercase; letter-spacing: 0.8px; padding: 12px 16px 6px;
        }
        .palette-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; padding: 4px 16px 12px; }
        .palette-btn {
            width: 36px; height: 36px; border-radius: 6px; border: 1px solid var(--border);
            background: var(--card); color: var(--text-muted); font-size: 0.75rem; font-weight: 600;
            cursor: pointer; transition: var(--transition); display: flex; align-items: center;
            justify-content: center; position: relative;
        }
        .palette-btn:hover { border-color: var(--purple-light); transform: scale(1.08); }
        .palette-btn.current { outline: 2px solid var(--cyan); outline-offset: 1px; }
        .palette-btn.answered { background: var(--green); border-color: var(--green); color: #fff; }
        .palette-btn.marked { background: var(--purple); border-color: var(--purple); color: #fff; }
        .palette-btn.answered-marked { background: var(--purple); border-color: var(--purple); color: #fff; }
        .palette-btn.answered-marked::after {
            content: ''; position: absolute; bottom: 2px; right: 2px;
            width: 8px; height: 8px; border-radius: 50%; background: var(--green);
            border: 1px solid var(--purple);
        }

        /* Palette legend */
        .palette-legend { padding: 12px 16px; border-top: 1px solid var(--border); margin-top: auto; }
        .palette-legend-title { font-size: 0.7rem; font-weight: 600; color: var(--text-dim); text-transform: uppercase; margin-bottom: 8px; }
        .legend-items { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        .legend-item { display: flex; align-items: center; gap: 8px; font-size: 0.72rem; color: var(--text-muted); }
        .legend-swatch {
            width: 16px; height: 16px; border-radius: 4px; flex-shrink: 0; position: relative;
        }
        .legend-swatch.unattempted { background: var(--card); border: 1px solid var(--border); }
        .legend-swatch.answered { background: var(--green); }
        .legend-swatch.marked { background: var(--purple); }
        .legend-swatch.answered-marked { background: var(--purple); }
        .legend-swatch.answered-marked::after {
            content: ''; position: absolute; bottom: 1px; right: 1px;
            width: 6px; height: 6px; border-radius: 50%; background: var(--green);
        }

        /* ── Footer Controls ── */
        .test-footer {
            background: var(--surface); border-top: 1px solid var(--border);
            padding: 12px 1.5rem; display: flex; align-items: center;
            justify-content: space-between; flex-shrink: 0; gap: 8px; flex-wrap: wrap;
        }
        .footer-left { display: flex; gap: 8px; flex-wrap: wrap; }
        .footer-right { display: flex; gap: 8px; flex-wrap: wrap; }

        .btn-test {
            padding: 10px 18px; border-radius: var(--radius-sm); font-size: 0.82rem;
            font-weight: 600; cursor: pointer; transition: var(--transition); border: 1px solid var(--border);
        }
        .btn-mark { background: var(--card); color: var(--purple-light); border-color: var(--purple); }
        .btn-mark:hover { background: rgba(124,58,237,0.1); }
        .btn-clear { background: var(--card); color: var(--text-secondary); }
        .btn-clear:hover { background: rgba(255,255,255,0.05); }
        .btn-prev { background: var(--card); color: var(--text-secondary); }
        .btn-prev:hover { background: rgba(255,255,255,0.05); }
        .btn-save { background: var(--gradient-purple); color: #fff; border: none; }
        .btn-save:hover { opacity: 0.9; }
        .btn-submit-test { background: var(--red); color: #fff; border: none; }
        .btn-submit-test:hover { background: #dc2626; }

        /* ── Mobile Palette Drawer ── */
        .palette-toggle {
            display: none; position: fixed; bottom: 80px; right: 16px; z-index: 200;
            width: 48px; height: 48px; border-radius: 50%; background: var(--purple);
            color: #fff; border: none; font-size: 1.2rem; cursor: pointer;
            box-shadow: var(--shadow-lg); transition: var(--transition);
        }
        .palette-toggle:hover { transform: scale(1.1); }

        .palette-overlay {
            display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5);
            z-index: 300;
        }
        .palette-overlay.open { display: block; }

        /* ── Confirm Dialog ── */
        .confirm-overlay {
            display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6);
            z-index: 500; align-items: center; justify-content: center;
        }
        .confirm-overlay.open { display: flex; }
        .confirm-dialog {
            background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg);
            padding: 2rem; max-width: 420px; width: 90%; box-shadow: var(--shadow-xl); text-align: center;
        }
        .confirm-dialog h3 { color: var(--text-primary); margin-bottom: 0.75rem; font-size: 1.1rem; }
        .confirm-dialog p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; line-height: 1.5; }
        .confirm-actions { display: flex; gap: 12px; justify-content: center; }
        .confirm-actions .btn-test { min-width: 120px; }

        /* ── Responsive ── */
        @media (max-width: 768px) {
            .palette-panel { display: none; position: fixed; top: 0; right: 0; bottom: 0; width: 280px; z-index: 400; }
            .palette-panel.open { display: flex; }
            .palette-toggle { display: flex; align-items: center; justify-content: center; }
            .question-panel { padding: 1.25rem; }
            .test-header .student-info { display: none; }
            .section-tab { padding: 10px 14px; font-size: 0.8rem; }
            .test-footer { padding: 10px 1rem; }
            .btn-test { padding: 8px 12px; font-size: 0.78rem; }
            .info-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>

<% if (!diagnostic.started) { %>
<!-- ════════════════════════════════════════════════════════════
     STATE 1: WELCOME SCREEN
     ════════════════════════════════════════════════════════════ -->
<div class="welcome-wrap">
    <div class="welcome-card">
        <div class="welcome-icon"><i class="bi bi-clipboard2-pulse"></i></div>
        <h1 class="welcome-title">JEE Mains Diagnostic Test</h1>
        <p class="welcome-greeting">Welcome, <strong><%= user.name || 'Student' %></strong></p>
        <p class="welcome-desc">
            This diagnostic test follows the JEE Mains format. Your results will personalize your learning path across all subjects from Day 1.
        </p>

        <div class="info-grid">
            <div class="info-box">
                <div class="num">90</div>
                <div class="label">Questions</div>
            </div>
            <div class="info-box">
                <div class="num">3</div>
                <div class="label">Subjects</div>
            </div>
            <div class="info-box">
                <div class="num">3 hrs</div>
                <div class="label">Duration</div>
            </div>
            <div class="info-box">
                <div class="num">360</div>
                <div class="label">Max Score</div>
            </div>
        </div>

        <div class="marking-info">
            <div class="mark"><span class="mark-val correct">+4</span> Correct</div>
            <div class="mark"><span class="mark-val incorrect">−1</span> Incorrect</div>
            <div class="mark"><span class="mark-val skip">0</span> Unattempted</div>
        </div>

        <p style="color: var(--text-dim); font-size: 0.82rem; margin-bottom: 1.5rem;">
            <i class="bi bi-info-circle" style="color: var(--cyan);"></i>
            Physics · Chemistry · Mathematics — 30 questions each
        </p>

        <form action="/diagnostic/start" method="POST">
            <button type="submit" class="btn-start-test">
                <i class="bi bi-play-fill" style="margin-right: 8px;"></i>Take Diagnostic Test
            </button>
        </form>
        <a href="/diagnostic/skip" class="skip-link">Skip and Start Fresh →</a>
    </div>
</div>

<% } else { %>
<!-- ════════════════════════════════════════════════════════════
     STATE 2: JEE MAINS CBT TEST UI
     ════════════════════════════════════════════════════════════ -->
<div class="test-container">

    <!-- Header -->
    <div class="test-header">
        <span class="logo"><i class="bi bi-diagram-3-fill"></i> Learn.ai</span>
        <div class="student-info">
            <span class="student-name"><%= user.name || 'Student' %></span>
            <span class="section-indicator" id="sectionIndicator">Physics</span>
        </div>
        <div class="timer" id="timerDisplay">03:00:00</div>
    </div>

    <!-- Section Tabs -->
    <div class="section-tabs" id="sectionTabs">
        <div class="section-tab active" data-section="Physics">Physics</div>
        <div class="section-tab" data-section="Chemistry">Chemistry</div>
        <div class="section-tab" data-section="Mathematics">Mathematics</div>
    </div>

    <div class="test-body">
        <!-- Question Display Area -->
        <div class="question-panel" id="questionPanel">
            <div class="q-header">
                <span class="q-number" id="qNumber">Q.1</span>
                <span class="q-difficulty" id="qDifficulty">Easy</span>
            </div>
            <div class="q-text" id="qText"></div>
            <div class="options-list" id="optionsList">
                <label class="option-item" data-option="option1">
                    <input type="radio" name="answer" value="option1">
                    <span class="option-label-letter">A</span>
                    <span class="option-text" id="optA"></span>
                </label>
                <label class="option-item" data-option="option2">
                    <input type="radio" name="answer" value="option2">
                    <span class="option-label-letter">B</span>
                    <span class="option-text" id="optB"></span>
                </label>
                <label class="option-item" data-option="option3">
                    <input type="radio" name="answer" value="option3">
                    <span class="option-label-letter">C</span>
                    <span class="option-text" id="optC"></span>
                </label>
                <label class="option-item" data-option="option4">
                    <input type="radio" name="answer" value="option4">
                    <span class="option-label-letter">D</span>
                    <span class="option-text" id="optD"></span>
                </label>
            </div>
        </div>

        <!-- Question Palette (right panel) -->
        <div class="palette-panel" id="palettePanel">
            <div class="palette-section-title">Physics (1–30)</div>
            <div class="palette-grid" id="palettePhysics"></div>
            <div class="palette-section-title">Chemistry (31–60)</div>
            <div class="palette-grid" id="paletteChemistry"></div>
            <div class="palette-section-title">Mathematics (61–90)</div>
            <div class="palette-grid" id="paletteMathematics"></div>

            <div class="palette-legend">
                <div class="palette-legend-title">Legend</div>
                <div class="legend-items">
                    <div class="legend-item"><span class="legend-swatch unattempted"></span> Unattempted</div>
                    <div class="legend-item"><span class="legend-swatch answered"></span> Answered</div>
                    <div class="legend-item"><span class="legend-swatch marked"></span> Marked for Review</div>
                    <div class="legend-item"><span class="legend-swatch answered-marked"></span> Answered + Marked</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mobile palette toggle -->
    <button class="palette-toggle" id="paletteToggle"><i class="bi bi-grid-3x3-gap-fill"></i></button>
    <div class="palette-overlay" id="paletteOverlay"></div>

    <!-- Footer Controls -->
    <div class="test-footer">
        <div class="footer-left">
            <button class="btn-test btn-mark" id="btnMarkReview"><i class="bi bi-bookmark"></i> Mark for Review & Next</button>
            <button class="btn-test btn-clear" id="btnClear"><i class="bi bi-x-circle"></i> Clear Response</button>
        </div>
        <div class="footer-right">
            <button class="btn-test btn-prev" id="btnPrev"><i class="bi bi-chevron-left"></i> Previous</button>
            <button class="btn-test btn-save" id="btnSaveNext">Save & Next <i class="bi bi-chevron-right"></i></button>
            <button class="btn-test btn-submit-test" id="btnSubmit"><i class="bi bi-check2-square"></i> Submit Test</button>
        </div>
    </div>
</div>

<!-- Confirm Dialog -->
<div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-dialog">
        <h3><i class="bi bi-exclamation-triangle" style="color: var(--gold);"></i> Submit Test?</h3>
        <p id="confirmMsg">Are you sure you want to submit?</p>
        <div class="confirm-actions">
            <button class="btn-test btn-clear" id="confirmCancel">Cancel</button>
            <button class="btn-test btn-submit-test" id="confirmYes">Yes, Submit</button>
        </div>
    </div>
</div>

<script>
(function() {
    // ── Data injection from server ──
    const questions = <%- JSON.stringify(questions || []) %>;
    const answers = <%- JSON.stringify(diagnostic.answers || {}) %>;
    const markedForReview = <%- JSON.stringify(diagnostic.markedForReview || {}) %>;
    const startTimestamp = <%= diagnostic.startTimestamp || 0 %>;
    const durationMs = <%= diagnostic.durationMs || 0 %>;

    // ── State ──
    let currentSeq = 1;
    let currentSection = 'Physics';
    let submitting = false;

    // ── Section helpers ──
    const sectionRanges = {
        Physics:     { start: 1,  end: 30 },
        Chemistry:   { start: 31, end: 60 },
        Mathematics: { start: 61, end: 90 },
    };

    function getQuestionBySeq(seq) {
        return questions.find(q => q.seq === seq);
    }

    function getSectionForSeq(seq) {
        if (seq >= 1 && seq <= 30) return 'Physics';
        if (seq >= 31 && seq <= 60) return 'Chemistry';
        return 'Mathematics';
    }

    function getSectionQuestions(section) {
        const range = sectionRanges[section];
        return questions.filter(q => q.seq >= range.start && q.seq <= range.end).sort((a, b) => a.seq - b.seq);
    }

    // ── Build palette buttons ──
    function buildPalette() {
        const sections = [
            { id: 'palettePhysics', start: 1, end: 30 },
            { id: 'paletteChemistry', start: 31, end: 60 },
            { id: 'paletteMathematics', start: 61, end: 90 },
        ];
        sections.forEach(sec => {
            const container = document.getElementById(sec.id);
            container.innerHTML = '';
            for (let i = sec.start; i <= sec.end; i++) {
                const btn = document.createElement('button');
                btn.className = 'palette-btn';
                btn.textContent = i;
                btn.dataset.seq = i;
                btn.addEventListener('click', () => navigateToQuestion(i));
                container.appendChild(btn);
            }
        });
    }

    // ── Update palette button colors ──
    function updatePalette() {
        document.querySelectorAll('.palette-btn').forEach(btn => {
            const seq = btn.dataset.seq;
            const hasAnswer = !!answers[seq];
            const isMarked = !!markedForReview[seq];
            const isCurrent = parseInt(seq) === currentSeq;

            btn.className = 'palette-btn';
            if (hasAnswer && isMarked) btn.classList.add('answered-marked');
            else if (hasAnswer) btn.classList.add('answered');
            else if (isMarked) btn.classList.add('marked');
            if (isCurrent) btn.classList.add('current');
        });
    }

    // ── Render question ──
    function renderQuestion() {
        const q = getQuestionBySeq(currentSeq);
        if (!q) return;

        // Update header
        document.getElementById('qNumber').textContent = 'Q.' + q.seq;

        const diffEl = document.getElementById('qDifficulty');
        const tierLabels = { 1: 'Easy', 2: 'Medium', 3: 'Hard' };
        diffEl.textContent = tierLabels[q.difficulty_tier] || 'Medium';
        diffEl.className = 'q-difficulty tier-' + q.difficulty_tier;

        // Question text
        document.getElementById('qText').innerHTML = q.question_text;

        // Options
        document.getElementById('optA').innerHTML = q.option1;
        document.getElementById('optB').innerHTML = q.option2;
        document.getElementById('optC').innerHTML = q.option3;
        document.getElementById('optD').innerHTML = q.option4;

        // Radio selection
        const radios = document.querySelectorAll('input[name="answer"]');
        const savedAnswer = answers[String(currentSeq)];
        radios.forEach(r => { r.checked = (r.value === savedAnswer); });

        // Option item highlight
        document.querySelectorAll('.option-item').forEach(item => {
            item.classList.toggle('selected', item.dataset.option === savedAnswer);
        });

        // Section indicator
        currentSection = getSectionForSeq(currentSeq);
        document.getElementById('sectionIndicator').textContent = currentSection;

        // Update section tabs
        document.querySelectorAll('.section-tab').forEach(tab => {
            tab.classList.toggle('active', tab.dataset.section === currentSection);
        });

        updatePalette();

        // MathJax re-render
        if (window.MathJax && MathJax.typesetPromise) {
            MathJax.typesetPromise([document.getElementById('questionPanel')]).catch(() => {});
        }
    }

    // ── Navigation ──
    function navigateToQuestion(seq) {
        currentSeq = seq;
        currentSection = getSectionForSeq(seq);
        renderQuestion();
        // Close mobile drawer if open
        closePaletteDrawer();
    }

    function nextInSection() {
        const range = sectionRanges[currentSection];
        if (currentSeq < range.end) {
            currentSeq++;
        } else {
            // Wrap to first of section
            currentSeq = range.start;
        }
        renderQuestion();
    }

    function prevInSection() {
        const range = sectionRanges[currentSection];
        if (currentSeq > range.start) {
            currentSeq--;
        } else {
            currentSeq = range.end;
        }
        renderQuestion();
    }

    // ── Server communication ──
    async function saveAnswer(seq, answer) {
        try {
            await fetch('/diagnostic/answer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ seq, answer }),
            });
            answers[String(seq)] = answer;
            updatePalette();
        } catch (e) {
            console.error('Failed to save answer:', e);
        }
    }

    async function clearAnswer(seq) {
        try {
            await fetch('/diagnostic/clear', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ seq }),
            });
            delete answers[String(seq)];
            // Deselect radios
            document.querySelectorAll('input[name="answer"]').forEach(r => { r.checked = false; });
            document.querySelectorAll('.option-item').forEach(item => { item.classList.remove('selected'); });
            updatePalette();
        } catch (e) {
            console.error('Failed to clear answer:', e);
        }
    }

    async function markForReview(seq, marked) {
        try {
            await fetch('/diagnostic/mark-review', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ seq, marked }),
            });
            if (marked) {
                markedForReview[String(seq)] = true;
            } else {
                delete markedForReview[String(seq)];
            }
            updatePalette();
        } catch (e) {
            console.error('Failed to mark for review:', e);
        }
    }

    async function submitTest() {
        if (submitting) return;
        submitting = true;
        try {
            const res = await fetch('/diagnostic/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
            });
            const data = await res.json();
            if (data.ok && data.redirect) {
                window.location.href = data.redirect;
            }
        } catch (e) {
            console.error('Failed to submit test:', e);
            submitting = false;
        }
    }

    // ── Timer ──
    function startTimer() {
        const timerEl = document.getElementById('timerDisplay');
        let remainingMs = durationMs - (Date.now() - startTimestamp);

        if (remainingMs <= 0) {
            submitTest();
            return;
        }

        function formatTime(ms) {
            const totalSec = Math.max(0, Math.floor(ms / 1000));
            const h = Math.floor(totalSec / 3600);
            const m = Math.floor((totalSec % 3600) / 60);
            const s = totalSec % 60;
            return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
        }

        timerEl.textContent = formatTime(remainingMs);

        const interval = setInterval(() => {
            remainingMs = durationMs - (Date.now() - startTimestamp);

            if (remainingMs <= 0) {
                timerEl.textContent = '00:00:00';
                clearInterval(interval);
                submitTest();
                return;
            }

            timerEl.textContent = formatTime(remainingMs);

            // Warning when < 15 minutes
            if (remainingMs < 15 * 60 * 1000) {
                timerEl.classList.add('timer-warning');
            } else {
                timerEl.classList.remove('timer-warning');
            }
        }, 1000);
    }

    // ── Mobile palette drawer ──
    function openPaletteDrawer() {
        document.getElementById('palettePanel').classList.add('open');
        document.getElementById('paletteOverlay').classList.add('open');
    }
    function closePaletteDrawer() {
        document.getElementById('palettePanel').classList.remove('open');
        document.getElementById('paletteOverlay').classList.remove('open');
    }

    // ── Confirm dialog ──
    function showConfirmDialog() {
        const unanswered = 90 - Object.keys(answers).length;
        const msg = unanswered > 0
            ? 'You have ' + unanswered + ' unanswered question' + (unanswered > 1 ? 's' : '') + '. Unanswered questions will be scored as 0. Are you sure you want to submit?'
            : 'Are you sure you want to submit the test?';
        document.getElementById('confirmMsg').textContent = msg;
        document.getElementById('confirmOverlay').classList.add('open');
    }
    function hideConfirmDialog() {
        document.getElementById('confirmOverlay').classList.remove('open');
    }

    // ── Event listeners ──
    function init() {
        buildPalette();

        // Section tab clicks
        document.querySelectorAll('.section-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                const section = tab.dataset.section;
                currentSection = section;
                const sectionQs = getSectionQuestions(section);
                if (sectionQs.length > 0) {
                    currentSeq = sectionQs[0].seq;
                }
                renderQuestion();
            });
        });

        // Option clicks (radio + label)
        document.querySelectorAll('.option-item').forEach(item => {
            item.addEventListener('click', () => {
                const radio = item.querySelector('input[type="radio"]');
                radio.checked = true;
                const answer = radio.value;
                // Highlight
                document.querySelectorAll('.option-item').forEach(i => i.classList.remove('selected'));
                item.classList.add('selected');
                // Save immediately
                saveAnswer(currentSeq, answer);
            });
        });

        // Save & Next
        document.getElementById('btnSaveNext').addEventListener('click', () => {
            const selected = document.querySelector('input[name="answer"]:checked');
            if (selected) {
                saveAnswer(currentSeq, selected.value);
            }
            nextInSection();
        });

        // Previous
        document.getElementById('btnPrev').addEventListener('click', () => {
            prevInSection();
        });

        // Clear Response
        document.getElementById('btnClear').addEventListener('click', () => {
            clearAnswer(currentSeq);
        });

        // Mark for Review & Next
        document.getElementById('btnMarkReview').addEventListener('click', () => {
            markForReview(currentSeq, true);
            nextInSection();
        });

        // Submit Test
        document.getElementById('btnSubmit').addEventListener('click', () => {
            showConfirmDialog();
        });

        // Confirm dialog buttons
        document.getElementById('confirmYes').addEventListener('click', () => {
            hideConfirmDialog();
            submitTest();
        });
        document.getElementById('confirmCancel').addEventListener('click', () => {
            hideConfirmDialog();
        });

        // Mobile palette toggle
        document.getElementById('paletteToggle').addEventListener('click', () => {
            const panel = document.getElementById('palettePanel');
            if (panel.classList.contains('open')) {
                closePaletteDrawer();
            } else {
                openPaletteDrawer();
            }
        });
        document.getElementById('paletteOverlay').addEventListener('click', () => {
            closePaletteDrawer();
        });

        // Render first question
        renderQuestion();

        // Start timer
        startTimer();
    }

    // Run on DOM ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
<% } %>

</body>
</html>
