<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Institute — Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Page-specific: institute register form */
        .form-floating { margin-bottom: 0.75rem; }
        .form-control { background: rgba(10,15,30,0.8); border: 2px solid var(--border-light); border-radius: 12px; color: var(--text); font-size: 1rem; padding: 1rem; transition: var(--transition-slow); }
        .form-control:focus { background: rgba(10,15,30,0.9); border-color: var(--gold); box-shadow: 0 0 0 0.25rem rgba(245,158,11,0.25); color: var(--text); }
        .form-control::placeholder { color: var(--text-muted); }
    </style>
</head>
<body>
<div class="auth-wrap">
    <div class="auth-left">
        <div class="auth-card auth-card--wide auth-card--bordered">
            <div style="text-align:center;margin-bottom:2rem;">
                <h1 style="color:var(--gold);font-size:1.8rem;font-weight:700;margin-bottom:0.5rem;"><i class="bi bi-building me-2"></i>Register Institute</h1>
                <p style="color:var(--text-secondary);margin:0;">Set up your coaching center on Learn.ai</p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-dark-danger p-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
                </div>
            <% } %>

            <form method="POST" action="/institute/register">
                <div class="section-label">Institute Details</div>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="instituteName" name="instituteName" placeholder="My Coaching Center" required>
                    <label for="instituteName">Institute Name</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" id="contactEmail" name="contactEmail" placeholder="contact@institute.com" required>
                    <label for="contactEmail">Contact Email</label>
                </div>

                <div class="section-label">Admin Account</div>
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="adminName" name="adminName" placeholder="John Doe" required>
                    <label for="adminName">Admin Name</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" id="adminEmail" name="adminEmail" placeholder="admin@institute.com" required>
                    <label for="adminEmail">Admin Email</label>
                </div>
                <div class="form-floating mb-4">
                    <input type="password" class="form-control" id="adminPassword" name="adminPassword" placeholder="Password" required minlength="6">
                    <label for="adminPassword">Admin Password</label>
                </div>

                <button type="submit" class="btn-auth btn-auth--gold-border">
                    <i class="bi bi-building-add me-2"></i>Register Institute
                </button>
            </form>

            <div class="auth-footer">
                <p>Already have an account? <a href="/login">Sign in</a></p>
                <p style="margin-top:6px;">Just a student? <a href="/signup">Sign up here</a></p>
            </div>
        </div>
    </div>

    <!-- Right — Features -->
    <div class="auth-right">
        <div class="product-info">
            <div class="product-hero">
                <h2>Empower Your Institute</h2>
                <p>Everything you need to run a modern coaching center</p>
            </div>
            <ul class="feature-list">
                <li><i class="bi bi-upload"></i><div><strong>Bulk Question Upload</strong><span>Upload CSV/Excel files with AI-powered concept tagging</span></div></li>
                <li><i class="bi bi-graph-up"></i><div><strong>Mastery Heatmaps</strong><span>Track student progress across all concepts at a glance</span></div></li>
                <li><i class="bi bi-people"></i><div><strong>Batch Management</strong><span>Organize students into batches and monitor performance</span></div></li>
                <li><i class="bi bi-lightbulb"></i><div><strong>Stuck Student Detection</strong><span>Identify struggling students and get prerequisite gap analysis</span></div></li>
            </ul>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
