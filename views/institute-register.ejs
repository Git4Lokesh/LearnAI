<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Institute — Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --royal-purple: #7C3AED;
            --royal-blue: #2563EB;
            --royal-gold: #F59E0B;
            --dark-bg: #0F172A;
            --dark-card: #1E293B;
            --dark-border: #334155;
            --royal-gradient: linear-gradient(135deg, #0F172A 0%, #1E293B 25%, #312E81 50%, #7C3AED 100%);
            --text-primary: #F8FAFC;
            --text-secondary: #CBD5E1;
            --text-muted: #94A3B8;
        }

        body {
            background: var(--royal-gradient);
            min-height: 100vh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        .auth-container {
            min-height: 100vh;
            display: flex;
        }

        .auth-left {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(20px);
        }

        .auth-right {
            flex: 1;
            background: var(--royal-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .auth-card {
            background: var(--dark-card);
            border: 2px solid var(--royal-purple);
            border-radius: 20px;
            padding: 3rem;
            width: 100%;
            max-width: 480px;
            box-shadow: 0 20px 40px rgba(124, 58, 237, 0.3);
            backdrop-filter: blur(20px);
        }

        .auth-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .auth-header h1 {
            color: var(--royal-gold);
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .auth-header p {
            color: var(--text-secondary);
            margin: 0;
        }

        .section-label {
            color: var(--royal-gold);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
            margin-top: 1.25rem;
        }

        .form-floating label {
            color: var(--text-muted);
        }

        .form-control {
            background: rgba(15, 23, 42, 0.8);
            border: 2px solid var(--dark-border);
            border-radius: 12px;
            color: var(--text-primary);
            font-size: 1rem;
            padding: 1rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            background: rgba(15, 23, 42, 0.9);
            border-color: var(--royal-gold);
            box-shadow: 0 0 0 0.25rem rgba(245, 158, 11, 0.25);
            color: var(--text-primary);
        }

        .form-control::placeholder {
            color: var(--text-muted);
        }

        .btn-signup {
            background: linear-gradient(135deg, var(--royal-purple) 0%, var(--royal-blue) 100%);
            border: 2px solid var(--royal-gold);
            color: white;
            font-weight: 600;
            padding: 1rem 2rem;
            border-radius: 12px;
            width: 100%;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .btn-signup:hover {
            background: linear-gradient(135deg, #8B5CF6 0%, #3B82F6 100%);
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(124, 58, 237, 0.5);
            color: white;
        }

        .alert-danger {
            background: rgba(220, 38, 38, 0.15);
            border: 1px solid rgba(220, 38, 38, 0.4);
            color: #FCA5A5;
            border-radius: 12px;
        }

        .auth-footer {
            text-align: center;
            margin-top: 2rem;
            color: var(--text-secondary);
        }

        .auth-footer a {
            color: var(--royal-gold);
            text-decoration: none;
            font-weight: 500;
        }

        .auth-footer a:hover {
            color: #FCD34D;
        }

        .features-showcase {
            max-width: 500px;
            color: var(--text-primary);
        }

        .feature-hero {
            text-align: center;
            margin-bottom: 3rem;
        }

        .feature-hero h2 {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--royal-gold);
            margin-bottom: 1rem;
        }

        .feature-hero p {
            font-size: 1.2rem;
            color: var(--text-secondary);
            margin: 0;
        }

        .feature-list {
            list-style: none;
            padding: 0;
        }

        .feature-list li {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
            margin-bottom: 1.5rem;
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid var(--royal-purple);
            border-radius: 16px;
            padding: 1.25rem;
            backdrop-filter: blur(10px);
        }

        .feature-list li i {
            color: var(--royal-gold);
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .feature-list li strong {
            color: var(--text-primary);
            display: block;
            margin-bottom: 0.25rem;
        }

        .feature-list li span {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        @media (max-width: 768px) {
            .auth-container {
                flex-direction: column;
            }
            .auth-right {
                display: none;
            }
            .auth-left {
                min-height: 100vh;
            }
        }
    </style>
</head>
<body>
    <div class="auth-container">
        <!-- Left Side - Registration Form -->
        <div class="auth-left">
            <div class="auth-card">
                <div class="auth-header">
                    <h1><i class="bi bi-building me-2"></i>Register Institute</h1>
                    <p>Set up your coaching center on Learn.ai</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
                    </div>
                <% } %>

                <form method="POST" action="/institute/register">
                    <div class="section-label">Institute Details</div>

                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="instituteName" name="instituteName" placeholder="My Coaching Center" required>
                        <label for="instituteName">Institute Name</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="email" class="form-control" id="contactEmail" name="contactEmail" placeholder="contact@institute.com" required>
                        <label for="contactEmail">Contact Email</label>
                    </div>

                    <div class="section-label">Admin Account</div>

                    <div class="form-floating mb-3">
                        <input type="text" class="form-control" id="adminName" name="adminName" placeholder="John Doe" required>
                        <label for="adminName">Admin Name</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="email" class="form-control" id="adminEmail" name="adminEmail" placeholder="admin@institute.com" required>
                        <label for="adminEmail">Admin Email</label>
                    </div>

                    <div class="form-floating mb-4">
                        <input type="password" class="form-control" id="adminPassword" name="adminPassword" placeholder="Password" required minlength="6">
                        <label for="adminPassword">Admin Password</label>
                    </div>

                    <button type="submit" class="btn btn-signup mb-3">
                        <i class="bi bi-building-add me-2"></i>
                        Register Institute
                    </button>
                </form>

                <div class="auth-footer">
                    <p>Already have an account? <a href="/login">Sign in</a></p>
                    <p>Just a student? <a href="/signup">Sign up here</a></p>
                </div>
            </div>
        </div>

        <!-- Right Side - Features -->
        <div class="auth-right">
            <div class="features-showcase">
                <div class="feature-hero">
                    <h2>Empower Your Institute</h2>
                    <p>Everything you need to run a modern coaching center</p>
                </div>

                <ul class="feature-list">
                    <li>
                        <i class="bi bi-upload"></i>
                        <div>
                            <strong>Bulk Question Upload</strong>
                            <span>Upload CSV/Excel files with AI-powered concept tagging</span>
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-graph-up"></i>
                        <div>
                            <strong>Mastery Heatmaps</strong>
                            <span>Track student progress across all concepts at a glance</span>
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-people"></i>
                        <div>
                            <strong>Batch Management</strong>
                            <span>Organize students into batches and monitor performance</span>
                        </div>
                    </li>
                    <li>
                        <i class="bi bi-lightbulb"></i>
                        <div>
                            <strong>Stuck Student Detection</strong>
                            <span>Identify struggling students and get prerequisite gap analysis</span>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
