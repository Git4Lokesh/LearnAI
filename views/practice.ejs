<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= concept.name %> — Practice</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
<script>
window.MathJax = {
    tex: { inlineMath: [['$','$'],['\\(','\\)']], displayMath: [['$$','$$'],['\\[','\\]']], processEscapes: true },
    options: { renderActions: { addMenu: [] } }
};
</script>
<script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<link rel="stylesheet" href="/css/theme.css">
<style>
:root{--muted:var(--text-dim)}
body{min-height:100vh}
nav.practice-nav{background:rgba(17,24,39,.8);border-bottom:1px solid rgba(255,255,255,.06);padding:0 1.5rem;height:56px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px)}
.brand{color:var(--gold);font-weight:700;font-size:1.1rem;text-decoration:none;display:flex;align-items:center;gap:8px}
.back-btn{background:rgba(30,41,59,.5);border:1px solid rgba(255,255,255,.08);color:var(--muted);border-radius:8px;padding:5px 14px;font-size:.82rem;cursor:pointer;text-decoration:none;display:flex;align-items:center;gap:6px;transition:var(--transition);backdrop-filter:blur(8px)}
.back-btn:hover{border-color:var(--purple);color:var(--text);background:rgba(124,58,237,.1)}
.concept-header-bar{max-width:1280px;margin:0 auto;padding:1.25rem 1.5rem 1rem}
.concept-header-bar h1{font-size:1.5rem;font-weight:700;margin:0 0 .15rem;background:linear-gradient(135deg,var(--text),var(--text-secondary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.concept-meta{color:var(--muted);font-size:.85rem;margin-bottom:.75rem}
.mastery-bar-h{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.mastery-bar-track{flex:1;max-width:400px;height:10px;background:rgba(15,23,42,.6);border:1px solid rgba(255,255,255,.08);border-radius:6px;overflow:hidden;position:relative}
.mastery-bar-fill{height:100%;border-radius:5px;transition:width .6s cubic-bezier(.4,0,.2,1),background .4s ease}
.mastery-bar-pct{font-size:.95rem;font-weight:700;min-width:48px;letter-spacing:-.02em}
.mastery-bar-status{font-size:.7rem;font-weight:600;padding:2px 10px;border-radius:20px;white-space:nowrap}
.decay-warning{font-size:.78rem;color:#F59E0B;margin-top:.35rem;display:flex;align-items:center;gap:6px}
.mastered-banner{background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.25);border-radius:12px;padding:1.25rem;text-align:center;margin-top:.75rem;display:none;backdrop-filter:blur(12px);box-shadow:0 0 20px rgba(16,185,129,.1)}
.mastered-banner h4{color:#10B981;margin:0 0 .25rem}
.mastered-banner p{color:var(--muted);font-size:.85rem;margin:0}
.practice-grid{max-width:1280px;margin:0 auto;padding:0 1.5rem 2rem;display:grid;grid-template-columns:1fr 380px;gap:1.5rem;align-items:start}
.question-card{background:var(--glass-bg,var(--surface));border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:1.75rem;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:var(--shadow-md);position:relative}
.q-top-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}
.q-meta{display:flex;align-items:center;gap:8px}
.tier-badge{font-size:.7rem;padding:2px 10px;border-radius:20px;font-weight:600;backdrop-filter:blur(4px)}
.tier-1{background:rgba(16,185,129,.15);color:#10B981}
.tier-2{background:rgba(245,158,11,.15);color:#F59E0B}
.tier-3{background:rgba(239,68,68,.15);color:#EF4444}
.q-num{font-size:.75rem;color:var(--muted)}
.btn-hint{background:rgba(245,158,11,.12);border:1px solid rgba(245,158,11,.3);color:var(--gold);width:34px;height:34px;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1rem;transition:var(--transition);flex-shrink:0}
.btn-hint:hover{background:rgba(245,158,11,.22);border-color:var(--gold);transform:translateY(-1px);box-shadow:0 4px 12px rgba(245,158,11,.15)}
.question-text{font-size:1rem;line-height:1.7;margin-bottom:1.5rem}
.options{display:flex;flex-direction:column;gap:10px}
.option-label{display:flex;align-items:flex-start;gap:12px;padding:12px 16px;border:1px solid var(--border);border-radius:10px;cursor:pointer;transition:all .25s ease}
.option-label:hover{border-color:rgba(124,58,237,.4);background:rgba(124,58,237,.05);box-shadow:0 0 0 1px rgba(124,58,237,.1),0 4px 12px rgba(124,58,237,.08);transform:translateY(-1px)}
.option-label input{display:none}
.option-label.selected{border-color:var(--purple);background:rgba(124,58,237,.1);box-shadow:0 0 16px rgba(124,58,237,.15)}
.option-label.correct{border-color:#10B981;background:rgba(16,185,129,.1);box-shadow:0 0 16px rgba(16,185,129,.15)}
.option-label.wrong{border-color:#EF4444;background:rgba(239,68,68,.1);box-shadow:0 0 16px rgba(239,68,68,.1)}
.option-key{width:24px;height:24px;border-radius:6px;background:rgba(30,41,59,.6);border:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:600;flex-shrink:0;margin-top:1px}
.option-text{font-size:.9rem;line-height:1.5}
.feedback{border-radius:10px;padding:12px 16px;margin-top:1rem;font-size:.88rem;display:none}
.feedback.correct{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);color:#10B981}
.feedback.wrong{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:#EF4444}
.solution-text{margin-top:8px;color:var(--text);font-size:.85rem;line-height:1.6}
.btn-explain-why{background:rgba(124,58,237,.12);border:1px solid rgba(124,58,237,.3);color:var(--purple-light);border-radius:8px;padding:6px 14px;font-size:.78rem;font-weight:600;cursor:pointer;transition:var(--transition);display:none;margin-top:8px;align-items:center;gap:6px}
.btn-explain-why:hover{background:rgba(124,58,237,.22);border-color:var(--purple);transform:translateY(-1px)}
.stagnation-warning{background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.3);border-radius:10px;padding:12px 16px;margin-top:1rem;font-size:.85rem;color:#F59E0B;display:none}
.stagnation-warning a{color:#F59E0B;font-weight:600}
.prereq-link{display:inline-block;background:rgba(245,158,11,.15);border:1px solid rgba(245,158,11,.4);border-radius:6px;padding:2px 8px;margin:2px;font-size:.75rem;text-decoration:none;transition:var(--transition)}
.prereq-link:hover{background:rgba(245,158,11,.25);transform:translateY(-1px)}
.actions{display:flex;gap:10px;margin-top:1.25rem}
.btn-submit{background:linear-gradient(135deg,var(--purple),var(--blue));border:none;color:#fff;padding:10px 24px;border-radius:10px;font-weight:600;cursor:pointer;transition:all .3s ease;position:relative;overflow:hidden}
.btn-submit::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.1),transparent);opacity:0;transition:opacity .3s ease}
.btn-submit:hover::before{opacity:1}
.btn-submit:hover{box-shadow:0 8px 24px rgba(124,58,237,.4);transform:translateY(-2px)}
.btn-submit:disabled{opacity:.4;cursor:not-allowed;transform:none;box-shadow:none}
.btn-submit:active{transform:translateY(0)}
.btn-next{background:rgba(30,41,59,.5);border:1px solid rgba(255,255,255,.08);color:var(--text);padding:10px 24px;border-radius:10px;font-weight:500;cursor:pointer;transition:var(--transition);display:none;backdrop-filter:blur(8px)}
.btn-next:hover{border-color:var(--purple);background:rgba(124,58,237,.1);transform:translateY(-1px)}
.ai-tutor-panel{background:var(--glass-bg,var(--surface));border:1px solid rgba(124,58,237,.12);border-radius:16px;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:0 0 20px rgba(124,58,237,.08),var(--shadow-md);display:flex;flex-direction:column;height:calc(100vh - 180px);position:sticky;top:72px;overflow:hidden}
.ai-panel-header{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid rgba(124,58,237,.15);background:rgba(124,58,237,.06);flex-shrink:0}
.ai-panel-logo{width:32px;height:32px;border-radius:8px;background:var(--gradient-purple);display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
.ai-panel-title{font-size:.9rem;font-weight:700;color:var(--purple-light)}
.ai-chat-messages{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;min-height:0}
.chat-msg{max-width:90%;padding:10px 14px;border-radius:12px;font-size:.85rem;line-height:1.6;word-wrap:break-word;overflow-wrap:break-word}
.chat-msg.user{align-self:flex-end;background:var(--purple);color:#fff;border-bottom-right-radius:4px}
.chat-msg.assistant{align-self:flex-start;background:var(--card);color:var(--text);border:1px solid var(--border);border-bottom-left-radius:4px}
.chat-msg.assistant h1,.chat-msg.assistant h2,.chat-msg.assistant h3{font-size:.9rem;color:var(--gold);margin:.5rem 0 .25rem}
.chat-msg.assistant ul,.chat-msg.assistant ol{padding-left:1rem;margin:.25rem 0}
.chat-msg.assistant strong{color:var(--text-primary)}
.chat-msg.assistant p{margin:.3rem 0}
.chat-msg.assistant code{background:rgba(0,0,0,.3);padding:1px 5px;border-radius:4px;font-size:.82rem}
.chat-typing{align-self:flex-start;padding:10px 14px;background:var(--card);border:1px solid var(--border);border-radius:12px;border-bottom-left-radius:4px}
.chat-typing-dots{display:flex;gap:4px}
.chat-typing-dots span{width:6px;height:6px;border-radius:50%;background:var(--text-muted);animation:dotPulse 1.4s ease-in-out infinite}
.chat-typing-dots span:nth-child(2){animation-delay:.2s}
.chat-typing-dots span:nth-child(3){animation-delay:.4s}
@keyframes dotPulse{0%,60%,100%{opacity:.3;transform:scale(.8)}30%{opacity:1;transform:scale(1)}}
.ai-chat-input{display:flex;gap:8px;padding:12px;border-top:1px solid rgba(255,255,255,.06);background:rgba(15,23,42,.4);flex-shrink:0}
.ai-chat-input textarea{flex:1;background:rgba(15,23,42,.6);border:1px solid var(--border);border-radius:8px;color:var(--text);padding:8px 12px;font-size:.85rem;resize:none;font-family:inherit;min-height:38px;max-height:100px}
.ai-chat-input textarea:focus{outline:none;border-color:var(--purple)}
.ai-chat-input button{background:var(--gradient-purple);border:none;color:#fff;width:38px;height:38px;border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:var(--transition);flex-shrink:0}
.ai-chat-input button:hover{opacity:.9;box-shadow:0 4px 12px rgba(124,58,237,.3)}
.session-summary{background:var(--glass-bg,var(--surface));border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:1.75rem;text-align:center;backdrop-filter:blur(16px);box-shadow:0 8px 24px rgba(0,0,0,.3),0 0 20px rgba(124,58,237,.08)}
.session-summary h3{margin-bottom:1.5rem}
.summary-stats{display:flex;justify-content:center;gap:2rem;margin-bottom:1.5rem}
.stat{display:flex;flex-direction:column;align-items:center}
.stat-val{font-size:1.8rem;font-weight:700;text-shadow:0 0 16px rgba(124,58,237,.2)}
.stat-label{font-size:.75rem;color:var(--muted);margin-top:2px}
.mastery-delta{font-size:.85rem;color:var(--muted);margin-bottom:1.5rem}
.no-questions{text-align:center;padding:4rem 2rem;color:var(--muted)}
.no-questions i{font-size:3rem;display:block;margin-bottom:1rem}
.tier-toast{position:fixed;top:70px;right:1.5rem;padding:8px 16px;border-radius:20px;font-size:.8rem;font-weight:600;opacity:0;transform:translateY(-8px);transition:opacity .3s,transform .3s;pointer-events:none;z-index:200}
.tier-toast.up{background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.4);color:#EF4444}
.tier-toast.down{background:rgba(16,185,129,.15);border:1px solid rgba(16,185,129,.4);color:#10B981}
.tier-toast.show{opacity:1;transform:translateY(0)}
.ai-loader{padding:1rem}
.ai-loader-text{color:var(--text-muted);font-size:.85rem;margin-bottom:.75rem;font-style:italic}
.ai-loader-bar{height:4px;border-radius:2px;background:linear-gradient(90deg,var(--purple),var(--gold),var(--purple));background-size:200% 100%;animation:shimmer 1.5s ease-in-out infinite}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
@keyframes masteryPulse{0%,100%{box-shadow:none}50%{box-shadow:0 0 16px rgba(124,58,237,.6)}}
.mastery-bar-track.pulse{animation:masteryPulse .6s ease}
.ai-mobile-toggle{display:none;background:var(--gradient-purple);border:none;color:#fff;padding:10px 20px;border-radius:10px;font-weight:600;font-size:.85rem;cursor:pointer;width:100%;margin-top:1rem;transition:var(--transition)}
.ai-mobile-toggle:hover{opacity:.9}
.ai-mobile-toggle i{margin-right:6px}
@media(max-width:900px){
.practice-grid{grid-template-columns:1fr;padding:0 .75rem 2rem}
.concept-header-bar{padding:1rem .75rem .75rem}
.ai-tutor-panel{position:static;height:auto;max-height:500px;display:none}
.ai-tutor-panel.mobile-open{display:flex}
.ai-mobile-toggle{display:block}
.mastery-bar-track{max-width:100%}
.option-label{padding:14px 16px;min-height:48px}
.option-text{font-size:.95rem}
.question-text{font-size:1.05rem;overflow-x:auto}
.btn-submit,.btn-next{width:100%;padding:14px;font-size:1rem}
.actions{flex-direction:column}
.summary-stats{flex-direction:column;gap:1rem}
}
</style>
</head>
<body>
<nav class="practice-nav">
    <a class="brand" href="/"><i class="bi bi-diagram-3-fill"></i> Learn.ai</a>
    <a class="back-btn" href="/"><i class="bi bi-arrow-left"></i> Knowledge Graph</a>
</nav>
<div class="tier-toast" id="tierToast"></div>
<div class="concept-header-bar">
    <h1><%= concept.name %></h1>
    <p class="concept-meta"><%= concept.subject %> · <%= questions.length %> question<%= questions.length !== 1 ? 's' : '' %> available</p>
    <div class="mastery-bar-h">
        <div class="mastery-bar-track" id="masteryBar">
            <div class="mastery-bar-fill" id="masteryFill" style="width:<%= Math.round(mastery*100) %>%;background:<%= mastery >= 0.6 ? 'linear-gradient(90deg,#10B981,#F59E0B,#EF4444)' : mastery >= 0.33 ? 'linear-gradient(90deg,#10B981,#F59E0B)' : '#10B981' %>"></div>
        </div>
        <span class="mastery-bar-pct" id="masteryPct" style="color:<%= mastery >= 0.6 ? '#EF4444' : mastery >= 0.33 ? '#F59E0B' : '#10B981' %>"><%= Math.round(mastery*100) %>%</span>
        <% if (mastery < 0.33) { %>
        <span class="mastery-bar-status" style="background:rgba(16,185,129,.15);color:#10B981">Easy</span>
        <% } else if (mastery < 0.6) { %>
        <span class="mastery-bar-status" style="background:rgba(245,158,11,.15);color:#F59E0B">Medium</span>
        <% } else if (mastery < 0.8) { %>
        <span class="mastery-bar-status" style="background:rgba(239,68,68,.15);color:#EF4444">Hard</span>
        <% } else { %>
        <span class="mastery-bar-status" style="background:rgba(16,185,129,.15);color:#10B981">✓ Mastered</span>
        <% } %>
    </div>
    <% if (decayedBy >= 2) { %>
    <div class="decay-warning"><i class="bi bi-graph-down"></i> Mastery adjusted <strong>-<%= decayedBy %>%</strong> for inactivity</div>
    <% } %>
    <div class="mastered-banner" id="masteredBanner">
        <h4>🎉 Concept Mastered!</h4>
        <p>You've reached 80%+ mastery. Adjacent concepts may now be unlocked.</p>
    </div>
</div>
<% if (questions.length === 0) { %>
<div class="practice-grid">
    <div class="no-questions">
        <i class="bi bi-inbox"></i>
        <p>No approved questions available for this concept yet.</p>
        <a href="/" class="back-btn" style="display:inline-flex;margin-top:1rem">Back to graph</a>
    </div>
</div>
<% } else { %>
<div class="practice-grid">
    <div class="left-column">
        <div id="questionArea"></div>
        <button class="ai-mobile-toggle" id="aiMobileToggle" onclick="toggleMobileAi()">
            <i class="bi bi-robot"></i> Toggle AI Tutor
        </button>
    </div>
    <div class="ai-tutor-panel" id="aiTutorPanel">
        <div class="ai-panel-header">
            <div class="ai-panel-logo"><i class="bi bi-robot"></i></div>
            <span class="ai-panel-title">🤖 AI Tutor</span>
        </div>
        <div class="ai-chat-messages" id="aiChatMessages">
            <div class="chat-msg assistant">I'm your AI tutor. I can see your current question and mastery data. Ask me anything!</div>
        </div>
        <div class="ai-chat-input">
            <textarea id="aiChatInput" placeholder="Ask your AI tutor anything..." rows="1" aria-label="Chat message"></textarea>
            <button id="aiChatSend" aria-label="Send message"><i class="bi bi-send"></i></button>
        </div>
    </div>
</div>
<% } %>
