<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= concept.name %> — Practice</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script>
    window.MathJax = {
        tex: { inlineMath: [['$','$'],['\\(','\\)']], displayMath: [['$$','$$'],['\\[','\\]']], processEscapes: true },
        options: { renderActions: { addMenu: [] } }
    };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        :root { --muted: var(--text-dim); }
        body { min-height: 100vh; }
        nav { background: rgba(17,24,39,0.8); border-bottom: 1px solid rgba(255,255,255,0.06); padding: 0 1.5rem; height: 56px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 10; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
        .brand { color: var(--gold); font-weight: 700; font-size: 1.1rem; text-decoration: none; display: flex; align-items: center; gap: 8px; }
        .back-btn { background: rgba(30,41,59,0.5); border: 1px solid rgba(255,255,255,0.08); color: var(--muted); border-radius: 8px; padding: 5px 14px; font-size: 0.82rem; cursor: pointer; text-decoration: none; display: flex; align-items: center; gap: 6px; transition: all 0.2s; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
        .back-btn:hover { border-color: var(--purple); color: var(--text); background: rgba(124,58,237,0.1); }

        /* Layout */
        .practice-main { max-width: 720px; margin: 0 auto; padding: 2rem 1rem; }

        .concept-header { margin-bottom: 2rem; }
        .concept-header h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.25rem; background: linear-gradient(135deg, var(--text), var(--text-secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .concept-header p { color: var(--muted); font-size: 0.85rem; }

        /* Fixed sidebar mastery bar — pinned to right edge */
        .mastery-sidebar { position: fixed; right: 28px; top: 72px; width: 110px; height: calc(100vh - 88px); z-index: 8; display: flex; flex-direction: column; align-items: center; }
        .mastery-sidebar-inner { background: var(--glass-bg, var(--surface)); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 1.25rem 0.85rem; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 2px 8px rgba(0,0,0,0.2); display: flex; flex-direction: column; align-items: center; gap: 0.85rem; height: 100%; }
        .mastery-sidebar-label { font-size: 0.75rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
        .mastery-pct { font-size: 1.7rem; font-weight: 800; letter-spacing: -0.02em; text-shadow: 0 0 16px rgba(124,58,237,0.3); }
        .mastery-status { font-size: 0.7rem; font-weight: 600; padding: 3px 10px; border-radius: 20px; white-space: nowrap; }

        /* The vertical track area */
        .mastery-bar-area { flex: 1; display: flex; gap: 6px; align-items: stretch; width: 100%; min-height: 0; }
        .mastery-zones { display: flex; flex-direction: column; width: 8px; flex-shrink: 0; }
        .mastery-zones .zone { flex: 1; position: relative; }
        .mastery-zones .zone:first-child { border-radius: 5px 5px 0 0; }
        .mastery-zones .zone:last-child { border-radius: 0 0 5px 5px; }
        .zone-hard { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.25); border-bottom: none; }
        .zone-medium { background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.25); border-bottom: none; }
        .zone-easy { background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.25); }
        .mastery-track { position: relative; width: 36px; background: rgba(15,23,42,0.6); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; overflow: hidden; flex-shrink: 0; }
        .mastery-fill-v { position: absolute; bottom: 0; left: 0; right: 0; border-radius: 0 0 7px 7px; transition: height 0.6s cubic-bezier(0.4,0,0.2,1), background 0.4s ease; }
        .mastery-tier-labels { display: flex; flex-direction: column; justify-content: space-between; padding: 2px 0; }
        .tier-label { font-size: 0.65rem; font-weight: 600; display: flex; align-items: center; gap: 3px; white-space: nowrap; }
        .tier-label-hard { color: #EF4444; }
        .tier-label-medium { color: #F59E0B; }
        .tier-label-easy { color: #10B981; }

        @keyframes masteryPulse { 0%,100% { box-shadow: none; } 50% { box-shadow: 0 0 16px rgba(124,58,237,0.6); } }
        .mastery-track.pulse { animation: masteryPulse 0.6s ease; }

        .question-card { background: var(--glass-bg, var(--surface)); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 1.75rem; margin-bottom: 1.5rem; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: 0 4px 6px rgba(0,0,0,0.25), 0 2px 4px rgba(0,0,0,0.15); }
        .q-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 1rem; }
        .tier-badge { font-size: 0.7rem; padding: 2px 10px; border-radius: 20px; font-weight: 600; backdrop-filter: blur(4px); }
        .tier-1 { background: rgba(16,185,129,0.15); color: #10B981; }
        .tier-2 { background: rgba(245,158,11,0.15); color: #F59E0B; }
        .tier-3 { background: rgba(239,68,68,0.15); color: #EF4444; }
        .q-num { font-size: 0.75rem; color: var(--muted); }

        .question-text { font-size: 1rem; line-height: 1.7; margin-bottom: 1.5rem; }

        .options { display: flex; flex-direction: column; gap: 10px; }
        .option-label { display: flex; align-items: flex-start; gap: 12px; padding: 12px 16px; border: 1px solid var(--border); border-radius: 10px; cursor: pointer; transition: all 0.25s ease; }
        .option-label:hover { border-color: rgba(124,58,237,0.4); background: rgba(124,58,237,0.05); box-shadow: 0 0 0 1px rgba(124,58,237,0.1), 0 4px 12px rgba(124,58,237,0.08); transform: translateY(-1px); }
        .option-label input { display: none; }
        .option-label.selected { border-color: var(--purple); background: rgba(124,58,237,0.1); box-shadow: 0 0 16px rgba(124,58,237,0.15); }
        .option-label.correct { border-color: #10B981; background: rgba(16,185,129,0.1); box-shadow: 0 0 16px rgba(16,185,129,0.15); }
        .option-label.wrong { border-color: #EF4444; background: rgba(239,68,68,0.1); box-shadow: 0 0 16px rgba(239,68,68,0.1); }
        .option-key { width: 24px; height: 24px; border-radius: 6px; background: rgba(30,41,59,0.6); border: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 600; flex-shrink: 0; margin-top: 1px; }
        .option-text { font-size: 0.9rem; line-height: 1.5; }

        .feedback { border-radius: 10px; padding: 12px 16px; margin-top: 1rem; font-size: 0.88rem; display: none; }
        .feedback.correct { background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); color: #10B981; }
        .feedback.wrong { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #EF4444; }
        .solution-text { margin-top: 8px; color: var(--text); font-size: 0.85rem; line-height: 1.6; }

        .actions { display: flex; gap: 10px; margin-top: 1.5rem; }
        .btn-submit { background: linear-gradient(135deg, var(--purple), var(--blue)); border: none; color: white; padding: 10px 24px; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.3s ease; position: relative; overflow: hidden; }
        .btn-submit::before { content: ''; position: absolute; inset: 0; background: linear-gradient(135deg, rgba(255,255,255,0.1), transparent); opacity: 0; transition: opacity 0.3s ease; }
        .btn-submit:hover::before { opacity: 1; }
        .btn-submit:hover { box-shadow: 0 8px 24px rgba(124,58,237,0.4); transform: translateY(-2px); }
        .btn-submit:disabled { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }
        .btn-submit:active { transform: translateY(0); }
        .btn-next { background: rgba(30,41,59,0.5); border: 1px solid rgba(255,255,255,0.08); color: var(--text); padding: 10px 24px; border-radius: 10px; font-weight: 500; cursor: pointer; transition: all 0.2s; display: none; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
        .btn-next:hover { border-color: var(--purple); background: rgba(124,58,237,0.1); transform: translateY(-1px); }

        .no-questions { text-align: center; padding: 4rem 2rem; color: var(--muted); }
        .no-questions i { font-size: 3rem; display: block; margin-bottom: 1rem; }

        .stagnation-warning { background: rgba(245,158,11,0.1); border: 1px solid rgba(245,158,11,0.3); border-radius: 10px; padding: 12px 16px; margin-top: 1rem; font-size: 0.85rem; color: #F59E0B; display: none; }
        .stagnation-warning a { color: #F59E0B; font-weight: 600; }
        .prereq-link { display: inline-block; background: rgba(245,158,11,0.15); border: 1px solid rgba(245,158,11,0.4); border-radius: 6px; padding: 2px 8px; margin: 2px; font-size: 0.75rem; text-decoration: none; transition: all 0.2s; }
        .prereq-link:hover { background: rgba(245,158,11,0.25); transform: translateY(-1px); }

        .session-summary { background: var(--glass-bg, var(--surface)); border: 1px solid rgba(255,255,255,0.06); border-radius: 16px; padding: 1.75rem; text-align: center; backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: 0 8px 24px rgba(0,0,0,0.3), 0 0 20px rgba(124,58,237,0.08); }
        .session-summary h3 { margin-bottom: 1.5rem; }
        .summary-stats { display: flex; justify-content: center; gap: 2rem; margin-bottom: 1.5rem; }
        .stat { display: flex; flex-direction: column; align-items: center; }
        .stat-val { font-size: 1.8rem; font-weight: 700; text-shadow: 0 0 16px rgba(124,58,237,0.2); }
        .stat-label { font-size: 0.75rem; color: var(--muted); margin-top: 2px; }
        .mastery-delta { font-size: 0.85rem; color: var(--muted); margin-bottom: 1.5rem; }

        .tier-toast { position: fixed; top: 70px; right: 1.5rem; padding: 8px 16px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; opacity: 0; transform: translateY(-8px); transition: opacity 0.3s, transform 0.3s; pointer-events: none; z-index: 100; }
        .tier-toast.up { background: rgba(239,68,68,0.15); border: 1px solid rgba(239,68,68,0.4); color: #EF4444; }
        .tier-toast.down { background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.4); color: #10B981; }
        .tier-toast.show { opacity: 1; transform: translateY(0); }

        /* Mobile: collapse sidebar to compact fixed top bar */
        @media (max-width: 768px) {
            .practice-main { padding: 1rem 0.75rem; padding-top: 4rem; }
            .mastery-sidebar { position: fixed; right: 0; left: 0; top: 56px; width: 100%; height: auto; flex-direction: row; z-index: 8; }
            .mastery-sidebar-inner { flex-direction: row; height: auto; padding: 0.5rem 1rem; gap: 0.75rem; width: 100%; border-radius: 0; }
            .mastery-bar-area { flex-direction: row; height: 8px; flex: 1; min-height: auto; align-items: center; }
            .mastery-zones { flex-direction: row-reverse; width: auto; height: 8px; flex: 1; }
            .mastery-zones .zone { border-radius: 0; }
            .mastery-zones .zone:first-child { border-radius: 0 5px 5px 0; }
            .mastery-zones .zone:last-child { border-radius: 5px 0 0 5px; }
            .zone-hard { border-bottom: 1px solid rgba(239,68,68,0.25); border-right: none; }
            .zone-medium { border-bottom: 1px solid rgba(245,158,11,0.25); border-right: none; }
            .zone-easy { border-right: none; }
            .mastery-track { width: auto; height: 8px; flex: 1; border-radius: 5px; }
            .mastery-fill-v { bottom: auto; top: 0; left: 0; right: auto; height: 100% !important; border-radius: 5px 0 0 5px; transition: width 0.6s cubic-bezier(0.4,0,0.2,1), background 0.4s ease; }
            .mastery-tier-labels { display: none; }
            .mastery-sidebar-label { display: none; }
            .mastery-pct { font-size: 0.9rem; }
            .mastery-status { font-size: 0.58rem; }
            .option-label { padding: 14px 16px; font-size: 0.95rem; min-height: 48px; }
            .option-text { font-size: 0.95rem; }
            .question-text { font-size: 1.05rem; overflow-x: auto; }
            .btn-submit, .btn-next { width: 100%; padding: 14px; font-size: 1rem; }
            .actions { flex-direction: column; }
            .summary-stats { flex-direction: column; gap: 1rem; }
        }
        /* AI Tutor Section */
        .ai-tutor-section { background: var(--glass-bg); border: 1px solid rgba(124,58,237,0.15); border-radius: 14px; margin-bottom: 1rem; backdrop-filter: blur(12px); overflow: hidden; }
        .ai-tutor-header { font-size: 0.75rem; font-weight: 600; color: var(--purple-light); text-transform: uppercase; letter-spacing: 0.06em; padding: 12px 16px 0; display: flex; align-items: center; gap: 6px; }
        .ai-tutor-buttons { display: flex; gap: 0; border-bottom: 1px solid rgba(124,58,237,0.15); }
        .ai-tutor-buttons .btn-ai { border-radius: 0; border: none; border-bottom: 2px solid transparent; flex: 1; justify-content: center; margin: 0; padding: 10px 8px; font-size: 0.75rem; background: none; color: var(--text-muted); }
        .ai-tutor-buttons .btn-ai:hover { background: rgba(124,58,237,0.05); color: var(--text-secondary); transform: none; }
        .ai-tutor-buttons .btn-ai.active { border-bottom-color: var(--purple); color: var(--purple-light); background: rgba(124,58,237,0.08); }
        .ai-tutor-buttons .btn-ai-advice { color: var(--text-muted); }
        .ai-tutor-buttons .btn-ai-advice:hover { color: var(--red-light); }
        .ai-tutor-buttons .btn-ai-advice.active { color: var(--red-light); border-bottom-color: var(--red); }
        .ai-carousel { position: relative; min-height: 60px; max-height: 300px; overflow-y: auto; }
        .ai-carousel .ai-panel { display: none; }
        .ai-carousel .ai-panel.active { display: block; }

        /* AI Panels */
        .ai-panel { background: var(--glass-bg); border: 1px solid rgba(124,58,237,0.2); border-radius: 12px; margin-top: 1rem; overflow: hidden; backdrop-filter: blur(12px); }
        .ai-panel-header { display: flex; align-items: center; justify-content: space-between; padding: 10px 16px; background: rgba(124,58,237,0.08); border-bottom: 1px solid rgba(124,58,237,0.15); font-size: 0.85rem; font-weight: 600; color: var(--purple-light); }
        .ai-panel-body { padding: 16px; font-size: 0.9rem; line-height: 1.7; color: var(--text); }
        .ai-panel-body h1,.ai-panel-body h2,.ai-panel-body h3 { color: var(--gold); margin: 1rem 0 0.5rem; font-size: 1rem; }
        .ai-panel-body ul,.ai-panel-body ol { padding-left: 1.25rem; margin: 0.5rem 0; }
        .ai-panel-body strong { color: var(--text-primary); }
        .ai-panel-body a { color: var(--gold); }
        .btn-ai { background: rgba(124,58,237,0.15); border: 1px solid rgba(124,58,237,0.3); color: var(--purple-light); border-radius: 8px; padding: 6px 14px; font-size: 0.78rem; font-weight: 600; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 6px; margin-top: 8px; }
        .btn-ai:hover { background: rgba(124,58,237,0.25); border-color: var(--purple); transform: translateY(-1px); }
        .btn-ai-advice { background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.3); color: var(--red-light); }
        .btn-ai-advice:hover { background: rgba(239,68,68,0.25); border-color: var(--red); }
        .ai-loader { padding: 1rem; }
        .ai-loader-text { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.75rem; font-style: italic; }
        .ai-loader-bar { height: 4px; border-radius: 2px; background: linear-gradient(90deg, var(--purple), var(--gold), var(--purple)); background-size: 200% 100%; animation: shimmer 1.5s ease-in-out infinite; }

        /* Floating Chat Widget */
        .chat-widget { position: fixed; bottom: 24px; right: 150px; z-index: 1000; }
        .chat-widget-toggle { width: 56px; height: 56px; border-radius: 50%; background: var(--gradient-purple); border: 2px solid var(--gold); color: white; font-size: 1.5rem; cursor: pointer; box-shadow: var(--shadow-lg), var(--shadow-glow-purple); transition: all 0.3s; display: flex; align-items: center; justify-content: center; }
        .chat-widget-toggle:hover { transform: scale(1.1); }
        .chat-widget-panel { position: absolute; bottom: 70px; right: 0; width: 400px; height: 550px; background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: var(--radius-xl); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); box-shadow: var(--shadow-xl); display: none; flex-direction: column; overflow: hidden; }
        .chat-widget-panel.open { display: flex; }
        .chat-widget-header { display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(124,58,237,0.1); border-bottom: 1px solid var(--glass-border); font-weight: 600; font-size: 0.9rem; color: var(--purple-light); }
        .chat-widget-header button { background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1rem; }
        .chat-widget-messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
        .chat-msg { max-width: 85%; padding: 10px 14px; border-radius: 12px; font-size: 0.85rem; line-height: 1.6; }
        .chat-msg.user { align-self: flex-end; background: var(--purple); color: white; border-bottom-right-radius: 4px; }
        .chat-msg.assistant { align-self: flex-start; background: var(--card); color: var(--text); border: 1px solid var(--border); border-bottom-left-radius: 4px; }
        .chat-msg.assistant h1,.chat-msg.assistant h2,.chat-msg.assistant h3 { font-size: 0.9rem; color: var(--gold); margin: 0.5rem 0 0.25rem; }
        .chat-msg.assistant ul,.chat-msg.assistant ol { padding-left: 1rem; margin: 0.25rem 0; }
        .chat-msg.assistant strong { color: var(--text-primary); }
        .chat-typing { align-self: flex-start; padding: 10px 14px; background: var(--card); border: 1px solid var(--border); border-radius: 12px; border-bottom-left-radius: 4px; }
        .chat-typing-dots { display: flex; gap: 4px; }
        .chat-typing-dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--text-muted); animation: dotPulse 1.4s ease-in-out infinite; }
        .chat-typing-dots span:nth-child(2) { animation-delay: 0.2s; }
        .chat-typing-dots span:nth-child(3) { animation-delay: 0.4s; }
        @keyframes dotPulse { 0%,60%,100% { opacity: 0.3; transform: scale(0.8); } 30% { opacity: 1; transform: scale(1); } }
        .chat-widget-input { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--border); background: var(--surface); }
        .chat-widget-input textarea { flex: 1; background: rgba(15,23,42,0.6); border: 1px solid var(--border); border-radius: 8px; color: var(--text); padding: 8px 12px; font-size: 0.85rem; resize: none; font-family: inherit; }
        .chat-widget-input textarea:focus { outline: none; border-color: var(--purple); }
        .chat-widget-input button { background: var(--gradient-purple); border: none; color: white; width: 38px; height: 38px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; flex-shrink: 0; }
        .chat-widget-input button:hover { opacity: 0.9; }
        @media (max-width: 768px) {
            .chat-widget { bottom: 16px; right: 16px; }
            .chat-widget-panel { position: fixed; inset: 0; width: 100%; height: 100%; border-radius: 0; bottom: 0; right: 0; }
        }
    </style>
</head>
<body>
<nav>
    <a class="brand" href="/"><i class="bi bi-diagram-3-fill"></i> Learn.ai</a>
    <a class="back-btn" href="/"><i class="bi bi-arrow-left"></i> Knowledge Graph</a>
</nav>

<div class="tier-toast" id="tierToast"></div>

<div class="practice-main">
        <div class="concept-header">
            <h1><%= concept.name %></h1>
            <p><%= concept.subject %> · <%= questions.length %> question<%= questions.length !== 1 ? 's' : '' %> available</p>
        </div>

        <% if (decayedBy >= 2) { %>
        <p style="font-size:0.78rem;color:#F59E0B;margin:0 0 1.25rem;display:flex;align-items:center;gap:6px">
            <i class="bi bi-graph-down"></i> Mastery adjusted <strong>-<%= decayedBy %>%</strong> for inactivity
        </p>
        <% } %>

        <div class="mastered-banner" id="masteredBanner" style="background:rgba(16,185,129,0.08);border:1px solid rgba(16,185,129,0.25);border-radius:12px;padding:1.5rem;text-align:center;margin-bottom:1.5rem;display:none;backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:0 0 20px rgba(16,185,129,0.1)">
            <h4 style="color:#10B981">🎉 Concept Mastered!</h4>
            <p style="color:var(--muted);font-size:0.85rem;margin:0">You've reached 80%+ mastery. Adjacent concepts may now be unlocked.</p>
        </div>

        <% if (questions.length === 0) { %>
        <div class="no-questions">
            <i class="bi bi-inbox"></i>
            <p>No approved questions available for this concept yet.</p>
            <a href="/" class="back-btn" style="display:inline-flex; margin-top:1rem">Back to graph</a>
        </div>
        <% } else { %>
        <div id="questionArea"></div>
        <% } %>
</div>

<!-- Fixed mastery sidebar -->
<div class="mastery-sidebar">
        <div class="mastery-sidebar-inner">
            <span class="mastery-sidebar-label">Mastery</span>
            <span class="mastery-pct" id="masteryPct" style="color:<%= mastery >= 0.6 ? '#EF4444' : mastery >= 0.33 ? '#F59E0B' : '#10B981' %>"><%= Math.round(mastery*100) %>%</span>
            <% if (mastery < 0.33) { %>
            <span class="mastery-status" style="background:rgba(16,185,129,0.15);color:#10B981">Easy</span>
            <% } else if (mastery < 0.6) { %>
            <span class="mastery-status" style="background:rgba(245,158,11,0.15);color:#F59E0B">Medium</span>
            <% } else if (mastery < 0.8) { %>
            <span class="mastery-status" style="background:rgba(239,68,68,0.15);color:#EF4444">Hard</span>
            <% } else { %>
            <span class="mastery-status" style="background:rgba(16,185,129,0.15);color:#10B981">✓ Mastered</span>
            <% } %>
            <div class="mastery-bar-area">
                <div class="mastery-zones">
                    <div class="zone zone-hard"></div>
                    <div class="zone zone-medium"></div>
                    <div class="zone zone-easy"></div>
                </div>
                <div class="mastery-track" id="masteryBar">
                    <div class="mastery-fill-v" id="masteryFill" style="height:<%= Math.round(mastery*100) %>%; background:<%= mastery >= 0.6 ? 'linear-gradient(to top, #10B981, #F59E0B, #EF4444)' : mastery >= 0.33 ? 'linear-gradient(to top, #10B981, #F59E0B)' : '#10B981' %>"></div>
                </div>
                <div class="mastery-tier-labels">
                    <div class="tier-label tier-label-hard"><i class="bi bi-fire"></i> Hard</div>
                    <div class="tier-label tier-label-medium"><i class="bi bi-lightning"></i> Med</div>
                    <div class="tier-label tier-label-easy"><i class="bi bi-check-circle"></i> Easy</div>
                </div>
            </div>
        </div>
</div>

<script>
const questions = <%- JSON.stringify(questions) %>;
const conceptId = '<%= concept.id %>';
let currentIdx = 0;
let currentMastery = <%= mastery %>;
const initialMastery = <%= mastery %>;
let answered = false;
let questionStartTime = Date.now();
let sessionCorrect = 0;
let sessionTotal = 0;
const seenIds = new Set();
let prevTier = null;
const isMobile = window.innerWidth <= 768;

const keys = ['A','B','C','D'];
const optKeys = ['option1','option2','option3','option4'];

function showTierToast(oldTier, newTier) {
    if (oldTier === null || oldTier === newTier) return;
    const toast = document.getElementById('tierToast');
    const up = newTier > oldTier;
    toast.className = 'tier-toast ' + (up ? 'up' : 'down');
    toast.textContent = up ? '⬆ Difficulty increased' : '⬇ Difficulty decreased';
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 2500);
}

function renderQuestion() {
    if (currentIdx >= questions.length) {
        showSessionSummary();
        return;
    }

    const q = questions[currentIdx];
    answered = false;
    questionStartTime = Date.now();
    seenIds.add(q.id);
    showTierToast(prevTier, q.difficulty_tier);
    prevTier = q.difficulty_tier;
    const tierLabel = ['','Easy','Medium','Hard'][q.difficulty_tier] || '';
    const tierClass = ['','tier-1','tier-2','tier-3'][q.difficulty_tier] || 'tier-2';

    const optionsHtml = optKeys.map((ok, i) => `
        <label class="option-label" data-opt="${ok}" onclick="selectOption(this)">
            <input type="radio" name="answer" value="${ok}">
            <div class="option-key">${keys[i]}</div>
            <div class="option-text">${q[ok]}</div>
        </label>`).join('');

    document.getElementById('questionArea').innerHTML = `
        <div class="question-card">
            <div class="q-meta">
                <span class="tier-badge ${tierClass}">${tierLabel}</span>
                <span class="q-num">Q${currentIdx + 1} of ${questions.length}</span>
            </div>
            <div class="question-text">${q.question_text}</div>
            <div class="options">${optionsHtml}</div>
            <div class="feedback" id="feedback">
                <span id="feedbackMsg"></span>
                <div class="solution-text" id="solutionText"></div>
            </div>
            <div class="stagnation-warning" id="stagnationWarn"></div>
        </div>
        <div class="ai-tutor-section">
            <div class="ai-tutor-header"><i class="bi bi-robot"></i> AI Tutor</div>
            <div class="ai-tutor-buttons">
                <button class="btn-ai" data-panel="aiHintPanel" onclick="showAiTab(this,'aiHintPanel')"><i class="bi bi-lightbulb"></i> Hint</button>
                <button class="btn-ai btn-ai-advice" id="btnAiAdvice" data-panel="aiAdvicePanel" onclick="showAiTab(this,'aiAdvicePanel')" style="display:none"><i class="bi bi-compass"></i> Advice</button>
                <button class="btn-ai" onclick="document.getElementById('chatWidgetPanel').classList.add('open')"><i class="bi bi-chat-left-text"></i> Chat</button>
            </div>
            <div class="ai-carousel" id="aiCarousel">
                <div id="aiHintPanel" class="ai-panel"><div class="ai-panel-body" id="aiHintContent" style="padding:16px;color:var(--text-muted);font-size:0.85rem">Click <b>Hint</b> to get a nudge on this question.</div></div>
                <div id="aiAdvicePanel" class="ai-panel"><div class="ai-panel-body" id="aiAdviceContent" style="padding:16px;color:var(--text-muted);font-size:0.85rem">Loading advice...</div></div>
            </div>
        </div>
        <div class="actions">
            <button class="btn-submit" id="btnSubmit" onclick="submitAnswer()" disabled>Submit</button>
            <button class="btn-next" id="btnNext" onclick="nextQuestion()">Next <i class="bi bi-arrow-right ms-1"></i></button>
        </div>`;

    if (window.MathJax) MathJax.typesetPromise();
}

function showSessionSummary() {
    const accuracy = sessionTotal > 0 ? Math.round((sessionCorrect / sessionTotal) * 100) : 0;
    const masteryGain = Math.round((currentMastery - initialMastery) * 100);
    const gainColor = masteryGain >= 0 ? '#10B981' : '#EF4444';
    document.getElementById('questionArea').innerHTML = `
        <div class="session-summary">
            <h3>Session Complete</h3>
            <div class="summary-stats">
                <div class="stat"><span class="stat-val" style="color:#10B981">${sessionCorrect}</span><span class="stat-label">Correct</span></div>
                <div class="stat"><span class="stat-val" style="color:#EF4444">${sessionTotal - sessionCorrect}</span><span class="stat-label">Wrong</span></div>
                <div class="stat"><span class="stat-val">${accuracy}%</span><span class="stat-label">Accuracy</span></div>
            </div>
            <div class="mastery-delta">Mastery: ${Math.round(initialMastery*100)}% → <strong style="color:${gainColor}">${Math.round(currentMastery*100)}%</strong> (${masteryGain >= 0 ? '+' : ''}${masteryGain}%)</div>
            <a href="/" class="btn-submit" style="display:inline-block;text-decoration:none">Back to Graph</a>
        </div>`;
}

function selectOption(el) {
    if (answered) return;
    document.querySelectorAll('.option-label').forEach(l => l.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('btnSubmit').disabled = false;
}

async function submitAnswer() {
    if (answered) return;
    answered = true;

    const selected = document.querySelector('.option-label.selected');
    if (!selected) return;
    const chosen = selected.dataset.opt;
    const q = questions[currentIdx];
    const correct = chosen === q.correct_answer;
    sessionTotal++;
    if (correct) sessionCorrect++;

    const timeTaken = (Date.now() - questionStartTime) / 1000;

    document.querySelectorAll('.option-label').forEach(l => {
        if (l.dataset.opt === q.correct_answer) l.classList.add('correct');
        else if (l.dataset.opt === chosen && !correct) l.classList.add('wrong');
    });

    const fb = document.getElementById('feedback');
    fb.className = 'feedback ' + (correct ? 'correct' : 'wrong');
    fb.style.display = 'block';
    document.getElementById('feedbackMsg').textContent = correct ? '✓ Correct!' : '✗ Incorrect';
    if (q.solution_text) document.getElementById('solutionText').textContent = q.solution_text;

    // Show Advice button after wrong answer and auto-switch to it
    if (!correct) {
        const adviceBtn = document.getElementById('btnAiAdvice');
        if (adviceBtn) {
            adviceBtn.style.display = 'flex';
            // Reset loaded state so it fetches fresh
            const advicePanel = document.getElementById('aiAdvicePanel');
            if (advicePanel) advicePanel.dataset.loaded = '';
            // Auto-switch to advice tab
            showAiTab(adviceBtn, 'aiAdvicePanel');
        }
    }

    document.getElementById('btnSubmit').style.display = 'none';
    document.getElementById('btnNext').style.display = 'block';

    try {
        const res = await fetch(`/practice/${conceptId}/answer`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ correct, question_id: q.id, difficulty_tier: q.difficulty_tier, time_taken_seconds: timeTaken })
        });
        const data = await res.json();
        if (data.mastery !== undefined) {
            const oldMastery = currentMastery;
            currentMastery = data.mastery;
            updateMasteryBar(data.mastery);
            
            const oldTier = oldMastery < 0.4 ? 1 : oldMastery < 0.7 ? 2 : 3;
            const newTier = currentMastery < 0.4 ? 1 : currentMastery < 0.7 ? 2 : 3;
            
            if (newTier > oldTier) {
                const newQuestions = await fetchAdaptiveQuestions(newTier);
                if (newQuestions && newQuestions.length > 0) {
                    questions.splice(currentIdx + 1, questions.length - currentIdx - 1, ...newQuestions);
                    showTierToast(oldTier, newTier);
                }
            }
            
            if (data.mastery >= 0.8) {
                document.getElementById('masteredBanner').style.display = 'block';
            }
        }
        if (data.stagnating && data.prerequisiteGaps && data.prerequisiteGaps.length > 0) {
            const warn = document.getElementById('stagnationWarn');
            warn.style.display = 'block';
            const gapsList = data.prerequisiteGaps.map(g => 
                `<a href="/practice/${g.concept_id}" class="prereq-link">${g.name} (${Math.round(g.mastery*100)}%)</a>`
            ).join(', ');
            warn.innerHTML = `⚠️ <strong>Struggling with this concept?</strong><br>Consider reviewing these prerequisites first: ${gapsList}`;
        }
    } catch(e) { console.error(e); }

    if (window.MathJax) MathJax.typesetPromise();
}

async function fetchAdaptiveQuestions(tier) {
    try {
        const res = await fetch(`/api/adaptive-questions/${conceptId}?tier=${tier}`);
        const data = await res.json();
        if (data.questions && data.questions.length > 0) {
            return data.questions.filter(nq => !seenIds.has(nq.id));
        }
        return [];
    } catch(e) {
        console.error('Failed to fetch adaptive questions:', e);
        return [];
    }
}

function updateMasteryBar(m) {
    const pct = Math.round(m * 100);
    const fill = document.getElementById('masteryFill');
    const pctEl = document.getElementById('masteryPct');
    
    let bg, pctColor, statusText, statusBg;
    if (m >= 0.6) {
        bg = 'linear-gradient(to top, #10B981, #F59E0B, #EF4444)';
        pctColor = '#EF4444';
        statusText = m >= 0.8 ? '✓ Mastered' : 'Hard';
        statusBg = m >= 0.8 ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)';
    } else if (m >= 0.33) {
        bg = 'linear-gradient(to top, #10B981, #F59E0B)';
        pctColor = '#F59E0B';
        statusText = 'Medium';
        statusBg = 'rgba(245,158,11,0.15)';
    } else {
        bg = '#10B981';
        pctColor = '#10B981';
        statusText = 'Easy';
        statusBg = 'rgba(16,185,129,0.15)';
    }
    
    // On mobile, use width instead of height
    if (window.innerWidth <= 768) {
        fill.style.width = pct + '%';
        fill.style.height = '100%';
    } else {
        fill.style.height = pct + '%';
    }
    fill.style.background = bg;
    pctEl.textContent = pct + '%';
    pctEl.style.color = pctColor;
    
    const statusEl = document.querySelector('.mastery-status');
    if (statusEl) {
        statusEl.textContent = statusText;
        statusEl.style.background = statusBg;
        statusEl.style.color = pctColor;
    }
    
    const bar = document.getElementById('masteryBar');
    bar.classList.remove('pulse');
    void bar.offsetWidth;
    bar.classList.add('pulse');
}

function nextQuestion() {
    currentIdx++;
    if (currentIdx >= questions.length) {
        showSessionSummary();
        return;
    }
    renderQuestion();
}

renderQuestion();

// ── AI Tab Switching ──
function showAiTab(btn, panelId) {
    // Deactivate all tabs
    document.querySelectorAll('.ai-tutor-buttons .btn-ai[data-panel]').forEach(b => b.classList.remove('active'));
    // Hide all panels
    document.querySelectorAll('.ai-carousel .ai-panel').forEach(p => p.classList.remove('active'));
    // Activate clicked tab and panel
    btn.classList.add('active');
    const panel = document.getElementById(panelId);
    if (panel) panel.classList.add('active');
    // Fetch content if not loaded yet
    if (panelId === 'aiHintPanel' && !panel.dataset.loaded) {
        fetchAiHint(questions[currentIdx]);
        panel.dataset.loaded = '1';
    }
    if (panelId === 'aiAdvicePanel' && !panel.dataset.loaded) {
        fetchAiAdvice();
        panel.dataset.loaded = '1';
    }
}

// ── AI Helper Functions ──
function typewriterRender(container, fullText, onComplete) {
    let index = 0;
    const charsPerFrame = 20;
    container.innerHTML = '';
    function frame() {
        if (index < fullText.length) {
            index = Math.min(index + charsPerFrame, fullText.length);
            container.innerHTML = marked.parse(fullText.substring(0, index));
            requestAnimationFrame(frame);
        } else {
            container.innerHTML = marked.parse(fullText);
            if (window.MathJax && MathJax.typesetPromise) MathJax.typesetPromise([container]);
            if (onComplete) onComplete();
        }
    }
    requestAnimationFrame(frame);
}

function showAiLoader(container) {
    container.innerHTML = '<div class="ai-loader"><div class="ai-loader-text">Your AI tutor is thinking...</div><div class="ai-loader-bar"></div></div>';
}

async function fetchAiHint(q) {
    const content = document.getElementById('aiHintContent');
    if (!content) return;
    showAiLoader(content);
    try {
        const res = await fetch('/api/ai/hint', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                questionId: q.id,
                mode: 'hint'
            })
        });
        if (res.status === 429) {
            content.innerHTML = '<p style="color:var(--gold)">Daily AI limit reached. Try again tomorrow!</p>';
            return;
        }
        const data = await res.json();
        typewriterRender(content, data.hint || 'Could not generate hint.');
    } catch(e) {
        content.innerHTML = '<p style="color:var(--text-muted)">Hint unavailable. Please review the solution text.</p>';
    }
}

async function fetchAiAdvice() {
    const content = document.getElementById('aiAdviceContent');
    if (!content) return;
    showAiLoader(content);
    try {
        const res = await fetch('/api/ai/diagnose', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ conceptId })
        });
        if (res.status === 429) {
            content.innerHTML = '<p style="color:var(--gold)">Daily AI limit reached. Try again tomorrow!</p>';
            return;
        }
        const data = await res.json();
        typewriterRender(content, data.explanation || 'Could not generate advice.');
    } catch(e) {
        content.innerHTML = '<p style="color:var(--text-muted)">Advice unavailable right now.</p>';
    }
}


</script>
<!-- Floating Chat Widget -->
<div class="chat-widget">
    <button class="chat-widget-toggle" id="chatWidgetToggle" aria-label="Open AI Chat"><i class="bi bi-robot"></i></button>
    <div class="chat-widget-panel" id="chatWidgetPanel">
        <div class="chat-widget-header">
            <span><i class="bi bi-robot"></i> AI Study Tutor</span>
            <button onclick="document.getElementById('chatWidgetPanel').classList.remove('open')"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="chat-widget-messages" id="chatWidgetMessages"></div>
        <div class="chat-widget-input">
            <textarea id="chatWidgetInput" placeholder="Ask your AI tutor anything..." rows="1" aria-label="Chat message"></textarea>
            <button id="chatWidgetSend" aria-label="Send"><i class="bi bi-send"></i></button>
        </div>
    </div>
</div>
<script>
// Chat widget init — must run after widget HTML is in DOM
(function() {
    const widget = document.getElementById('chatWidgetPanel');
    const toggle = document.getElementById('chatWidgetToggle');
    const input = document.getElementById('chatWidgetInput');
    const sendBtn = document.getElementById('chatWidgetSend');
    const messages = document.getElementById('chatWidgetMessages');
    if (!toggle || !widget) return;

    toggle.addEventListener('click', function() {
        widget.classList.toggle('open');
        if (widget.classList.contains('open') && messages.children.length === 0) {
            const welcome = document.createElement('div');
            welcome.className = 'chat-msg assistant';
            welcome.innerHTML = marked.parse("Hi! I'm your **AI study tutor**. I know your mastery levels across all subjects. Ask me anything — what to study next, why you're stuck, or explain a concept!");
            messages.appendChild(welcome);
        }
        if (widget.classList.contains('open')) input.focus();
    });

    function addMsg(role, text) {
        const div = document.createElement('div');
        div.className = 'chat-msg ' + role;
        if (role === 'assistant') {
            typewriterRender(div, text);
        } else {
            div.textContent = text;
        }
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
    }

    async function send() {
        const msg = input.value.trim();
        if (!msg) return;
        input.value = '';
        addMsg('user', msg);
        // typing indicator
        const typing = document.createElement('div');
        typing.className = 'chat-typing';
        typing.id = 'chatTyping';
        typing.innerHTML = '<div class="chat-typing-dots"><span></span><span></span><span></span></div>';
        messages.appendChild(typing);
        messages.scrollTop = messages.scrollHeight;
        try {
            const res = await fetch('/api/ai/chat', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg, currentConcept: '<%= concept.name %>', currentConceptId: conceptId, currentQuestion: questions[currentIdx] ? { text: questions[currentIdx].question_text, option1: questions[currentIdx].option1, option2: questions[currentIdx].option2, option3: questions[currentIdx].option3, option4: questions[currentIdx].option4, tier: questions[currentIdx].difficulty_tier } : null })
            });
            const el = document.getElementById('chatTyping');
            if (el) el.remove();
            if (res.status === 429) { addMsg('assistant', 'Daily AI limit reached. Try again tomorrow!'); return; }
            const data = await res.json();
            addMsg('assistant', data.response || 'Sorry, I couldn\'t respond.');
        } catch(e) {
            const el = document.getElementById('chatTyping');
            if (el) el.remove();
            addMsg('assistant', 'Something went wrong. Please try again.');
        }
    }

    sendBtn.addEventListener('click', send);
    input.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
    });
})();
</script>
</body>
</html>
