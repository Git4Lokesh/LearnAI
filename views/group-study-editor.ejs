<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit: <%= content.title || content.topic %> - Group Study</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <style>
        :root {
            --royal-purple: #7C3AED;
            --royal-blue: #2563EB;
            --royal-gold: #F59E0B;
            --dark-bg: #0F172A;
            --dark-card: #1E293B;
            --dark-border: #334155;
        }
        body {
            background: linear-gradient(135deg, #0F172A 0%, #1E293B 25%, #312E81 50%, #7C3AED 100%);
            min-height: 100vh;
            color: #F8FAFC;
        }
        .editor-container {
            background: white;
            color: black;
            border-radius: 8px;
            margin: 2rem 0;
        }
        #editor { min-height: 500px; font-size: 1rem; }
        .ql-toolbar { border-radius: 8px 8px 0 0; }
        .ql-container { border-radius: 0 0 8px 8px; font-size: 1rem; }
        .annotation-panel {
            background: var(--dark-card);
            border: 2px solid var(--dark-border);
            border-radius: 12px;
            padding: 1rem;
            max-height: 600px;
            overflow-y: auto;
        }
        .annotation-item {
            background: var(--dark-bg);
            border-left: 3px solid var(--royal-purple);
            padding: 0.75rem;
            margin-bottom: 0.75rem;
            border-radius: 4px;
        }
        .collaborator-indicator {
            position: fixed;
            top: 80px;
            right: 20px;
            background: var(--dark-card);
            border: 2px solid var(--dark-border);
            border-radius: 8px;
            padding: 1rem;
            min-width: 200px;
            z-index: 100;
        }
        .collaborator-item {
            padding: 0.5rem;
            margin-bottom: 0.5rem;
            background: var(--dark-bg);
            border-radius: 4px;
        }
        .btn-primary {
            background: linear-gradient(135deg, var(--royal-purple) 0%, var(--royal-blue) 100%);
            border: 2px solid var(--royal-gold);
            color: white;
        }
        #sync-status { font-size: 0.75rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="/group-study/room/<%= room.id %>">
                <i class="bi bi-arrow-left me-2"></i>Edit: <%= content.title || content.topic %>
            </a>
            <div class="navbar-nav ms-auto align-items-center">
                <span id="sync-status" class="text-muted me-3">Connecting...</span>
                <button class="btn btn-sm btn-primary" onclick="saveContent()">
                    <i class="bi bi-save me-2"></i>Save
                </button>
            </div>
        </div>
    </nav>

    <div class="container-fluid" style="padding-top: 100px;">
        <div class="row">
            <div class="col-lg-9">
                <div class="editor-container">
                    <div id="editor"></div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-primary" onclick="saveContent()">
                        <i class="bi bi-save me-2"></i>Save Changes
                    </button>
                    <button class="btn btn-outline-light ms-2" onclick="addAnnotation()">
                        <i class="bi bi-sticky me-2"></i>Add Annotation
                    </button>
                </div>
            </div>

            <div class="col-lg-3">
                <div class="collaborator-indicator">
                    <h6><i class="bi bi-people me-2"></i>Active Editors</h6>
                    <div id="collaboratorsList">
                        <div class="collaborator-item"><%= user.name %> (You)</div>
                    </div>
                </div>

                <div class="annotation-panel mt-3">
                    <h6><i class="bi bi-sticky me-2"></i>Annotations</h6>
                    <div id="annotationsList">
                        <% annotations.forEach(ann => { %>
                            <div class="annotation-item">
                                <strong><%= ann.user_name %>:</strong>
                                <p class="mb-0 mt-1"><%= ann.annotation_text %></p>
                                <small class="text-muted"><%= new Date(ann.created_at).toLocaleDateString() %></small>
                            </div>
                        <% }); %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Annotation Modal -->
    <div class="modal fade" id="annotationModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-light">
                <div class="modal-header">
                    <h5 class="modal-title">Add Annotation</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Selected Text</label>
                        <div class="form-control bg-dark" id="selectedTextDisplay" style="min-height: 50px;"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Annotation</label>
                        <textarea class="form-control bg-dark" id="annotationText" rows="3" placeholder="Add your annotation..."></textarea>
                    </div>
                    <button class="btn btn-primary" onclick="submitAnnotation()">Add Annotation</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <!-- Yjs + y-quill + y-webrtc from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/yjs/dist/yjs.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/y-quill/dist/y-quill.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/y-webrtc/dist/y-webrtc.js"></script>
    <script>
        const socket = io();
        const roomId = <%= room.id %>;
        const userId = <%= user.id %>;
        const contentId = <%= content.id %>;
        const docId = `learn-ai-room-${roomId}-content-${contentId}`;

        // --- Quill setup ---
        const quill = new Quill('#editor', {
            theme: 'snow',
            modules: {
                toolbar: [
                    [{ header: [1, 2, 3, false] }],
                    ['bold', 'italic', 'underline'],
                    [{ list: 'ordered' }, { list: 'bullet' }],
                    ['link'],
                    ['clean']
                ]
            }
        });

        // Load initial content
        const initialContent = <%- JSON.stringify(
            typeof content.content_data === 'string'
                ? content.content_data
                : (content.content_data && content.content_data.note_content) || ''
        ) %>;
        if (initialContent) quill.clipboard.dangerouslyPasteHTML(initialContent);

        // --- Yjs CRDT + WebRTC ---
        const ydoc = new Y.Doc();
        const provider = new WebrtcProvider(docId, ydoc, {
            signaling: ['wss://signaling.yjs.dev']
        });
        const ytext = ydoc.getText('quill');
        const binding = new QuillBinding(ytext, quill, provider.awareness);

        provider.awareness.setLocalStateField('user', { name: '<%= user.name %>', color: '#7C3AED' });

        provider.on('status', ({ connected }) => {
            document.getElementById('sync-status').textContent = connected ? '🟢 Synced' : '🔴 Offline';
        });

        // Update collaborators list from Yjs awareness
        provider.awareness.on('change', () => {
            const states = Array.from(provider.awareness.getStates().values());
            const list = document.getElementById('collaboratorsList');
            list.innerHTML = '';
            states.forEach(state => {
                if (!state.user) return;
                const item = document.createElement('div');
                item.className = 'collaborator-item';
                item.style.borderLeft = `3px solid ${state.user.color || '#7C3AED'}`;
                item.textContent = state.user.name + (state.user.name === '<%= user.name %>' ? ' (You)' : '');
                list.appendChild(item);
            });
        });

        // --- Socket.io: room presence only ---
        socket.emit('join_room', { roomId, userId });
        socket.on('members_updated', (members) => {
            // Awareness handles editor collaborators; this keeps room presence in sync
        });

        // --- Annotation ---
        let selectedRange = null;
        quill.on('selection-change', (range) => {
            if (range && range.length > 0) {
                selectedRange = { text: quill.getText(range.index, range.length), start: range.index, end: range.index + range.length };
            }
        });

        function addAnnotation() {
            if (!selectedRange || !selectedRange.text.trim()) { alert('Please select text to annotate'); return; }
            document.getElementById('selectedTextDisplay').textContent = selectedRange.text;
            new bootstrap.Modal(document.getElementById('annotationModal')).show();
        }

        function submitAnnotation() {
            const annotationText = document.getElementById('annotationText').value.trim();
            if (!annotationText) { alert('Please enter an annotation'); return; }
            fetch(`/group-study/content/${contentId}/annotate`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ annotationText, positionStart: selectedRange.start, positionEnd: selectedRange.end })
            }).then(r => r.json()).then(d => { if (d.success) location.reload(); });
        }

        socket.on('annotation_added', (annotation) => {
            const list = document.getElementById('annotationsList');
            const item = document.createElement('div');
            item.className = 'annotation-item';
            item.innerHTML = `<strong>${annotation.user_name || 'Someone'}:</strong><p class="mb-0 mt-1">${annotation.annotation_text}</p><small class="text-muted">${new Date(annotation.created_at).toLocaleDateString()}</small>`;
            list.insertBefore(item, list.firstChild);
        });

        // --- Save ---
        function saveContent() {
            fetch(`/group-study/room/${roomId}/share`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    contentType: 'quicknotes',
                    contentId,
                    title: '<%= content.title || content.topic %>',
                    topic: '<%= content.topic %>',
                    gradeLevel: '<%= content.grade_level %>',
                    contentData: quill.root.innerHTML
                })
            }).then(r => r.json()).then(d => alert(d.success ? 'Saved!' : 'Error saving'));
        }
    </script>
</body>
</html>
