<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Batches - Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Page-specific: batch buttons */
        .btn-create { background: var(--gradient-purple); border: 2px solid var(--gold); color: white; font-weight: 600; padding: 0.75rem 1.5rem; border-radius: 12px; transition: var(--transition-slow); }
        .btn-create:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(124,58,237,0.4); color: white; }
        .btn-assign { background: rgba(245,158,11,0.15); border: 1px solid var(--gold); color: var(--gold); font-weight: 600; padding: 0.5rem 1.25rem; border-radius: 10px; transition: var(--transition-slow); }
        .btn-assign:hover { background: rgba(245,158,11,0.3); color: var(--gold); }
        .form-control { background: rgba(10,15,30,0.8); border: 2px solid var(--border-light); border-radius: 12px; color: var(--text); padding: 0.75rem 1rem; transition: var(--transition-slow); }
        .form-control:focus { background: rgba(10,15,30,0.9); border-color: var(--gold); box-shadow: 0 0 0 0.25rem rgba(245,158,11,0.25); color: var(--text); }
        .form-control::placeholder { color: var(--text-muted); }
        .form-check-label { color: var(--text-secondary); font-size: 0.9rem; }
    </style>
</head>
<body class="bg-alt">
    <div class="page-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <h1><i class="bi bi-collection me-2"></i>Batches</h1>
                <a href="/" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-dark-danger p-3 mb-3" role="alert"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert-dark-success p-3 mb-3" role="alert"><i class="bi bi-check-circle me-2"></i><%= success %></div>
        <% } %>

        <div class="card-section animate-in">
            <div class="section-label">Create New Batch</div>
            <form method="POST" action="/institute/batches" class="d-flex gap-3 align-items-end">
                <input type="hidden" name="action" value="create">
                <div class="flex-grow-1">
                    <input type="text" class="form-control" name="name" placeholder="e.g. JEE 2026 Batch A" required>
                </div>
                <button type="submit" class="btn btn-create"><i class="bi bi-plus-circle me-1"></i> Create</button>
            </form>
        </div>

        <div class="section-label mt-4 animate-in" style="animation-delay:0.1s">Existing Batches</div>

        <% if (batches.length === 0) { %>
            <div class="card-section empty-state">
                <i class="bi bi-inbox"></i>
                <p>No batches created yet. Create your first batch above.</p>
            </div>
        <% } else { %>
            <% batches.forEach(function(batch) { %>
            <div class="batch-card">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="batch-name"><i class="bi bi-collection me-1"></i> <%= batch.name %></span>
                        <span class="student-badge ms-2"><%= batch.students.length %> student<%= batch.students.length !== 1 ? 's' : '' %></span>
                    </div>
                    <% if (batch.invite_code) { %>
                    <button class="btn btn-sm" style="background:rgba(245,158,11,0.15);border:1px solid var(--gold);color:var(--gold);font-weight:600;border-radius:8px;padding:4px 12px;font-size:0.8rem;cursor:pointer;" onclick="copyInviteLink('<%= batch.invite_code %>', this)">
                        <i class="bi bi-link-45deg me-1"></i>Copy Invite Link
                    </button>
                    <% } %>
                </div>
                <% if (batch.students.length > 0) { %>
                <div class="mb-2">
                    <% batch.students.forEach(function(s) { %>
                        <span class="student-badge"><i class="bi bi-person me-1"></i><%= s.name %></span>
                    <% }); %>
                </div>
                <% } else { %>
                <p style="color:var(--text-muted);font-style:italic;font-size:0.85rem;margin-bottom:0.5rem;">No students assigned yet.</p>
                <% } %>
                <% if (unassignedStudents.length > 0) { %>
                <form method="POST" action="/institute/batches">
                    <input type="hidden" name="action" value="assign">
                    <input type="hidden" name="batch_id" value="<%= batch.id %>">
                    <div class="section-label" style="font-size: 0.75rem; margin-top: 0.75rem;">Assign Students</div>
                    <div class="row">
                        <% unassignedStudents.forEach(function(student) { %>
                        <div class="col-md-4 col-sm-6">
                            <div class="form-check mb-1">
                                <input class="form-check-input form-check-input-dark" type="checkbox" name="student_ids" value="<%= student.id %>" id="batch<%= batch.id %>_student<%= student.id %>">
                                <label class="form-check-label" for="batch<%= batch.id %>_student<%= student.id %>"><%= student.name %> (<%= student.email %>)</label>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                    <button type="submit" class="btn btn-assign mt-2"><i class="bi bi-person-plus me-1"></i> Assign Selected</button>
                </form>
                <% } %>
            </div>
            <% }); %>
        <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    function copyInviteLink(code, btn) {
        const url = window.location.origin + '/join/' + code;
        navigator.clipboard.writeText(url).then(() => {
            const orig = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied!';
            btn.style.background = 'rgba(16,185,129,0.2)';
            btn.style.borderColor = '#10B981';
            btn.style.color = '#10B981';
            setTimeout(() => { btn.innerHTML = orig; btn.style.background = ''; btn.style.borderColor = ''; btn.style.color = ''; }, 2000);
        }).catch(() => {
            prompt('Copy this invite link:', url);
        });
    }
    </script>
</body>
</html>
