<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Batches - AI Study Generator</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --royal-purple: #7C3AED;
            --royal-blue: #2563EB;
            --royal-gold: #F59E0B;
            --dark-bg: #0F172A;
            --dark-card: #1E293B;
            --dark-border: #334155;
            --text-primary: #F8FAFC;
            --text-secondary: #CBD5E1;
            --text-muted: #94A3B8;
        }
        body {
            background: var(--dark-bg);
            color: var(--text-primary);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
        }
        .page-header {
            background: linear-gradient(135deg, #312E81 0%, #7C3AED 100%);
            padding: 2rem 0;
            border-bottom: 2px solid var(--royal-gold);
        }
        .page-header h1 { color: var(--royal-gold); font-weight: 700; }
        .card-section {
            background: var(--dark-card);
            border: 1px solid var(--dark-border);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .section-label {
            color: var(--royal-gold);
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.75rem;
        }
        .form-control {
            background: rgba(15, 23, 42, 0.8);
            border: 2px solid var(--dark-border);
            border-radius: 12px;
            color: var(--text-primary);
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }
        .form-control:focus {
            background: rgba(15, 23, 42, 0.9);
            border-color: var(--royal-gold);
            box-shadow: 0 0 0 0.25rem rgba(245, 158, 11, 0.25);
            color: var(--text-primary);
        }
        .form-control::placeholder { color: var(--text-muted); }
        .btn-create {
            background: linear-gradient(135deg, var(--royal-purple) 0%, var(--royal-blue) 100%);
            border: 2px solid var(--royal-gold);
            color: white;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            border-radius: 12px;
            transition: all 0.3s ease;
        }
        .btn-create:hover {
            background: linear-gradient(135deg, #8B5CF6 0%, #3B82F6 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.4);
            color: white;
        }
        .btn-assign {
            background: rgba(245, 158, 11, 0.15);
            border: 1px solid var(--royal-gold);
            color: var(--royal-gold);
            font-weight: 600;
            padding: 0.5rem 1.25rem;
            border-radius: 10px;
            transition: all 0.3s ease;
        }
        .btn-assign:hover {
            background: rgba(245, 158, 11, 0.3);
            color: var(--royal-gold);
        }
        .batch-card {
            background: rgba(124, 58, 237, 0.05);
            border: 1px solid var(--dark-border);
            border-radius: 14px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
        }
        .batch-card:hover { border-color: var(--royal-purple); }
        .batch-name { color: var(--text-primary); font-weight: 600; font-size: 1.1rem; }
        .student-badge {
            background: rgba(124, 58, 237, 0.2);
            color: var(--text-secondary);
            border-radius: 8px;
            padding: 0.25rem 0.6rem;
            font-size: 0.8rem;
            display: inline-block;
            margin: 0.15rem;
        }
        .form-check-input {
            background-color: var(--dark-border);
            border-color: var(--text-muted);
        }
        .form-check-input:checked {
            background-color: var(--royal-purple);
            border-color: var(--royal-purple);
        }
        .form-check-label { color: var(--text-secondary); font-size: 0.9rem; }
        .alert-danger {
            background: rgba(220, 38, 38, 0.15);
            border: 1px solid rgba(220, 38, 38, 0.4);
            color: #FCA5A5;
            border-radius: 12px;
        }
        .alert-success {
            background: rgba(34, 197, 94, 0.15);
            border: 1px solid rgba(34, 197, 94, 0.4);
            color: #86EFAC;
            border-radius: 12px;
        }
        .empty-state { color: var(--text-muted); font-style: italic; }
    </style>
</head>
<body>
    <div class="page-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <h1><i class="bi bi-collection me-2"></i>Batches</h1>
                <a href="/institute/dashboard" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success" role="alert">
                <i class="bi bi-check-circle me-2"></i><%= success %>
            </div>
        <% } %>

        <!-- Create New Batch -->
        <div class="card-section">
            <div class="section-label">Create New Batch</div>
            <form method="POST" action="/institute/batches" class="d-flex gap-3 align-items-end">
                <input type="hidden" name="action" value="create">
                <div class="flex-grow-1">
                    <input type="text" class="form-control" name="name" placeholder="e.g. JEE 2026 Batch A" required>
                </div>
                <button type="submit" class="btn btn-create">
                    <i class="bi bi-plus-circle me-1"></i> Create
                </button>
            </form>
        </div>

        <!-- Existing Batches -->
        <div class="section-label mt-4">Existing Batches</div>

        <% if (batches.length === 0) { %>
            <div class="card-section">
                <p class="empty-state mb-0">No batches created yet. Create your first batch above.</p>
            </div>
        <% } else { %>
            <% batches.forEach(function(batch) { %>
                <div class="batch-card">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <span class="batch-name"><i class="bi bi-collection me-1"></i> <%= batch.name %></span>
                            <span class="student-badge ms-2"><%= batch.students.length %> student<%= batch.students.length !== 1 ? 's' : '' %></span>
                        </div>
                    </div>

                    <% if (batch.students.length > 0) { %>
                        <div class="mb-2">
                            <% batch.students.forEach(function(s) { %>
                                <span class="student-badge"><i class="bi bi-person me-1"></i><%= s.name %></span>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="empty-state mb-2" style="font-size: 0.85rem;">No students assigned yet.</p>
                    <% } %>

                    <% if (unassignedStudents.length > 0) { %>
                        <form method="POST" action="/institute/batches">
                            <input type="hidden" name="action" value="assign">
                            <input type="hidden" name="batch_id" value="<%= batch.id %>">
                            <div class="section-label" style="font-size: 0.75rem; margin-top: 0.75rem;">Assign Students</div>
                            <div class="row">
                                <% unassignedStudents.forEach(function(student) { %>
                                    <div class="col-md-4 col-sm-6">
                                        <div class="form-check mb-1">
                                            <input class="form-check-input" type="checkbox" name="student_ids" value="<%= student.id %>" id="batch<%= batch.id %>_student<%= student.id %>">
                                            <label class="form-check-label" for="batch<%= batch.id %>_student<%= student.id %>">
                                                <%= student.name %> (<%= student.email %>)
                                            </label>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                            <button type="submit" class="btn btn-assign mt-2">
                                <i class="bi bi-person-plus me-1"></i> Assign Selected
                            </button>
                        </form>
                    <% } %>
                </div>
            <% }); %>
        <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
