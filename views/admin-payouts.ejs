<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Payouts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #0F172A; color: #e2e8f0; }
        .card { background: #1E293B; border: 1px solid #334155; }
    </style>
</head>
<body>
<div class="container py-4">
    <h5 class="mb-4">💰 Payout Dashboard — This Week</h5>
    <div class="card p-3 mb-4">
        <table class="table table-dark table-hover mb-0">
            <thead><tr><th>Verifier</th><th>Approved</th><th>Rate</th><th>Amount</th></tr></thead>
            <tbody>
                <% payouts.forEach(p => { %>
                <tr>
                    <td><%= p.name %></td>
                    <td><%= p.approved_count %></td>
                    <td>₹<%= rate %></td>
                    <td><strong>₹<%= p.approved_count * rate %></strong></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <a href="/admin/verify" class="btn btn-outline-light">← Back to Queue</a>
</div>
</body>
</html>
