<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upload Questions - Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Page-specific: upload button + error table */
        .btn-upload { background: var(--gradient-purple); border: 2px solid var(--gold); color: white; font-weight: 600; padding: 0.75rem 1.5rem; border-radius: 12px; transition: var(--transition-slow); }
        .btn-upload:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(124,58,237,0.4); color: white; }
        .form-control { background: rgba(10,15,30,0.8); border: 2px solid var(--border-light); border-radius: 12px; color: var(--text); padding: 0.75rem 1rem; transition: var(--transition-slow); }
        .form-control:focus { background: rgba(10,15,30,0.9); border-color: var(--gold); box-shadow: 0 0 0 0.25rem rgba(245,158,11,0.25); color: var(--text); }
    </style>
</head>
<body class="bg-alt">
    <div class="page-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <h1><i class="bi bi-cloud-upload me-2"></i>Upload Questions</h1>
                <a href="/" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-dark-danger p-3 mb-3" role="alert"><i class="bi bi-exclamation-triangle me-2"></i><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert-dark-success p-3 mb-3" role="alert"><i class="bi bi-check-circle me-2"></i><%= success %></div>
        <% } %>

        <% if (typeof summary !== 'undefined' && summary) { %>
        <div class="card-section">
            <div class="section-label">Upload Results</div>
            <div class="summary-stat"><span class="label"><i class="bi bi-file-earmark me-2"></i>Filename</span><span class="value stat-default"><%= summary.filename %></span></div>
            <div class="summary-stat"><span class="label"><i class="bi bi-list-ol me-2"></i>Total Rows</span><span class="value stat-default"><%= summary.totalRows %></span></div>
            <div class="summary-stat"><span class="label"><i class="bi bi-check-circle me-2"></i>Successful Inserts</span><span class="value stat-green"><%= summary.processedRows %></span></div>
            <div class="summary-stat"><span class="label"><i class="bi bi-x-circle me-2"></i>Failed Rows</span><span class="value stat-red"><%= summary.failedRows %></span></div>
        </div>
        <% if (summary.errors && summary.errors.length > 0) { %>
        <div class="card-section">
            <div class="section-label">Error Details</div>
            <div style="overflow-x: auto;">
                <table class="table-dark-custom">
                    <thead><tr><th>Row</th><th>Errors</th></tr></thead>
                    <tbody>
                        <% summary.errors.forEach(function(err) { %>
                        <tr>
                            <td><strong><%= err.row %></strong></td>
                            <td><% if (Array.isArray(err.errors)) { err.errors.forEach(function(e) { %><div><i class="bi bi-dot"></i> <%= e %></div><% }); } else { %><%= err.errors %><% } %></td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>
        <% } %>

        <div class="card-section animate-in">
            <div class="section-label">Upload File</div>
            <form method="POST" action="/institute/questions/upload" enctype="multipart/form-data">
                <div class="file-input-wrapper mb-3">
                    <input type="file" class="form-control" name="file" accept=".csv,.xlsx" required>
                </div>
                <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">
                    Accepted formats: <strong>.csv</strong> and <strong>.xlsx</strong> — Max file size: 10 MB
                </p>
                <button type="submit" class="btn btn-upload"><i class="bi bi-cloud-upload me-2"></i>Upload Questions</button>
            </form>
        </div>

        <div class="card-section animate-in" style="animation-delay:0.1s">
            <div class="section-label" style="color:var(--gold);display:flex;align-items:center;gap:8px;">
                <i class="bi bi-file-earmark-pdf-fill"></i> Upload PDF (AI Extraction)
            </div>
            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">
                Upload a PDF containing MCQ questions. Our AI will extract, structure, and auto-tag each question. All extracted questions go to the review queue as "pending".
            </p>
            <form method="POST" action="/institute/questions/upload-pdf" enctype="multipart/form-data">
                <div class="file-input-wrapper mb-3">
                    <input type="file" class="form-control" name="file" accept=".pdf" required>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label style="color:var(--text-muted);font-size:0.82rem;margin-bottom:4px;display:block;">Subject (helps AI accuracy)</label>
                        <select name="pdf_subject" class="form-control">
                            <option value="">Auto-detect</option>
                            <option value="Physics">Physics</option>
                            <option value="Chemistry">Chemistry</option>
                            <option value="Mathematics">Mathematics</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label style="color:var(--text-muted);font-size:0.82rem;margin-bottom:4px;display:block;">Source label</label>
                        <input type="text" name="pdf_source" class="form-control" placeholder="e.g. Manthan Workbook Ch.3">
                    </div>
                </div>
                <button type="submit" class="btn btn-upload" style="background:linear-gradient(135deg,var(--gold),#D97706);border-color:var(--gold);">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Extract Questions from PDF
                </button>
            </form>
        </div>

        <div class="card-section animate-in" style="animation-delay:0.15s">
            <div class="section-label">Expected CSV Format</div>
            <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 0.75rem;">
                Your file should contain the following columns. Fields marked with <span style="color: var(--red-light);">*</span> are required.
            </p>
            <div class="csv-example">question_text*,option1*,option2*,option3*,option4*,correct_answer*,solution,difficulty_tier,topic_hint
"A ball is thrown at 45°...",v²sin2θ/g,v²/g,2v²/g,v²sin²θ/2g,1,"Use projectile range formula",3,projectile_motion</div>
            <div class="mt-3" style="font-size: 0.85rem; color: var(--text-muted);">
                <strong style="color: var(--text-secondary);">Column reference:</strong>
                <ul class="mt-1 mb-0" style="padding-left: 1.25rem;">
                    <li><code>question_text</code> <span style="color: var(--red-light);">*</span> — The question prompt</li>
                    <li><code>option1</code> – <code>option4</code> <span style="color: var(--red-light);">*</span> — Four answer choices</li>
                    <li><code>correct_answer</code> <span style="color: var(--red-light);">*</span> — Correct option number (1–4)</li>
                    <li><code>solution</code> — Solution explanation (optional)</li>
                    <li><code>difficulty_tier</code> — 1 (easy), 2 (medium), 3 (hard) — defaults to 2</li>
                    <li><code>topic_hint</code> — Hint for AI concept tagging (optional)</li>
                </ul>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
