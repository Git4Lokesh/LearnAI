<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diagnostic Results — Learn.ai</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        nav { background: rgba(17,24,39,0.95); border-bottom: 1px solid var(--border); padding: 0 1.5rem; height: 56px; display: flex; align-items: center; backdrop-filter: blur(12px); }
        .brand { color: var(--gold); font-weight: 700; font-size: 1.2rem; text-decoration: none; display: flex; align-items: center; gap: 8px; }
        .results-wrap { max-width: 700px; margin: 0 auto; padding: 2.5rem 1rem; }
        .results-card { background: var(--glass-bg); backdrop-filter: blur(var(--glass-blur)); border: 1px solid var(--glass-border); border-radius: var(--radius-xl); box-shadow: var(--shadow-xl); padding: 2.5rem; text-align: center; }
        .check-icon { color: var(--green); font-size: 3rem; margin-bottom: 0.75rem; }
        .results-title { color: var(--gold); font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; }
        .score-big { font-size: 3rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.25rem; }
        .score-max { font-size: 1rem; color: var(--text-muted); margin-bottom: 1.5rem; }
        .stats-row { display: flex; gap: 12px; justify-content: center; margin-bottom: 2rem; }
        .stat-box { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; text-align: center; flex: 1; min-width: 80px; }
        .stat-num { font-size: 1.5rem; font-weight: 700; }
        .stat-num.green { color: var(--green); }
        .stat-num.red { color: var(--red); }
        .stat-num.dim { color: var(--text-dim); }
        .stat-label { font-size: 0.7rem; color: var(--text-dim); margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
        /* Section breakdown table */
        .section-table { width: 100%; border-collapse: separate; border-spacing: 0; margin-bottom: 2rem; text-align: left; }
        .section-table th { background: rgba(124,58,237,0.12); color: var(--gold); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; padding: 10px 14px; }
        .section-table th:first-child { border-radius: var(--radius) 0 0 0; }
        .section-table th:last-child { border-radius: 0 var(--radius) 0 0; }
        .section-table td { padding: 10px 14px; border-bottom: 1px solid var(--border); font-size: 0.9rem; color: var(--text-secondary); }
        .section-table tr:last-child td { border-bottom: none; }
        .section-table .score-cell { font-weight: 700; }

        /* Mastery summary */
        .mastery-section { margin-bottom: 2rem; }
        .mastery-title { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem; font-weight: 600; }
        .mastery-bars { display: flex; gap: 12px; }
        .mastery-bar-item { flex: 1; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; text-align: center; }
        .mastery-bar-num { font-size: 1.3rem; font-weight: 700; }
        .mastery-bar-num.strong { color: var(--green); }
        .mastery-bar-num.developing { color: var(--gold); }
        .mastery-bar-num.weak { color: var(--red); }
        .mastery-bar-label { font-size: 0.68rem; color: var(--text-dim); margin-top: 4px; text-transform: uppercase; }

        .btn-dashboard { background: var(--gradient-purple); border: none; color: white; padding: 14px 40px; border-radius: var(--radius); font-weight: 600; font-size: 1rem; cursor: pointer; transition: var(--transition); text-decoration: none; display: inline-block; }
        .btn-dashboard:hover { opacity: 0.9; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(124,58,237,0.4); color: white; }
        .hint { color: var(--text-dim); font-size: 0.82rem; margin-bottom: 1.5rem; line-height: 1.5; }

        @media (max-width: 640px) {
            .results-card { padding: 1.5rem; }
            .stats-row { flex-wrap: wrap; }
            .mastery-bars { flex-direction: column; }
        }
    </style>
</head>
<body>
<nav><a class="brand" href="/"><i class="bi bi-diagram-3-fill"></i> Learn.ai</a></nav>

<div class="results-wrap">
    <div class="results-card">
        <div class="check-icon"><i class="bi bi-check-circle-fill"></i></div>
        <h2 class="results-title">Diagnostic Test Complete</h2>

        <div class="score-big" style="color: <%= result.totalScore >= 180 ? 'var(--green)' : result.totalScore >= 90 ? 'var(--gold)' : 'var(--red)' %>"><%= result.totalScore %></div>
        <div class="score-max">out of <%= result.maxScore %></div>

        <div class="stats-row">
            <div class="stat-box"><div class="stat-num green"><%= result.correct %></div><div class="stat-label">Correct</div></div>
            <div class="stat-box"><div class="stat-num red"><%= result.incorrect %></div><div class="stat-label">Incorrect</div></div>
            <div class="stat-box"><div class="stat-num dim"><%= result.unattempted %></div><div class="stat-label">Unattempted</div></div>
        </div>

        <table class="section-table">
            <thead>
                <tr><th>Subject</th><th>Score</th><th>Correct</th><th>Incorrect</th><th>Unattempted</th></tr>
            </thead>
            <tbody>
                <% ['Physics', 'Chemistry', 'Mathematics'].forEach(function(sec) { %>
                <tr>
                    <td><%= sec %></td>
                    <td class="score-cell" style="color: <%= result.sections[sec].score >= 60 ? 'var(--green)' : result.sections[sec].score >= 30 ? 'var(--gold)' : 'var(--red)' %>"><%= result.sections[sec].score %>/120</td>
                    <td><%= result.sections[sec].correct %></td>
                    <td><%= result.sections[sec].incorrect %></td>
                    <td><%= result.sections[sec].unattempted %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>

        <div class="mastery-section">
            <div class="mastery-title"><i class="bi bi-graph-up" style="color: var(--cyan);"></i> Knowledge Graph Initialized — <%= summary.total %> subconcepts</div>
            <div class="mastery-bars">
                <div class="mastery-bar-item"><div class="mastery-bar-num strong"><%= summary.strong %></div><div class="mastery-bar-label">Strong</div></div>
                <div class="mastery-bar-item"><div class="mastery-bar-num developing"><%= summary.developing %></div><div class="mastery-bar-label">Developing</div></div>
                <div class="mastery-bar-item"><div class="mastery-bar-num weak"><%= summary.needsWork %></div><div class="mastery-bar-label">Needs Work</div></div>
            </div>
        </div>

        <p class="hint"><i class="bi bi-info-circle" style="color: var(--cyan);"></i> Your learning path has been personalized based on your performance. Focus areas are highlighted on your knowledge graph.</p>

        <a href="/" class="btn-dashboard"><i class="bi bi-graph-up me-2"></i>Go to Dashboard</a>
    </div>
</div>
</body>
</html>
