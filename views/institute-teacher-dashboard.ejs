<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Dashboard - Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script src="https://cdn.jsdelivr.net/npm/vis-network@9.1.9/dist/vis-network.min.js"></script>
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Aliases for legacy variable names used in this page */
        :root { --royal-purple: var(--purple); --royal-blue: var(--blue); --royal-gold: var(--gold); --dark-bg: var(--bg-alt); --dark-card: var(--card); --dark-border: var(--border-light); }
        body { min-height: 100vh; }
        .dashboard-header { background: var(--gradient-header); padding: 2rem 0; border-bottom: 2px solid var(--gold); }
        .dashboard-header h1 { color: var(--gold); font-weight: 700; }
        .filter-bar { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 16px; padding: 1.25rem; margin-bottom: 1.5rem; backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur)); box-shadow: var(--shadow-sm); }
        .filter-bar select { background: var(--dark-bg); color: var(--text-primary); border: 1px solid var(--dark-border); border-radius: 8px; padding: 0.5rem 1rem; }
        .filter-bar select:focus { border-color: var(--royal-purple); box-shadow: 0 0 0 0.2rem rgba(124, 58, 237, 0.25); background: var(--dark-bg); color: var(--text-primary); }
        .filter-bar label { color: var(--text-secondary); font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; }
        .section-title { color: var(--royal-gold); font-weight: 600; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1rem; }
        .card-section { background: var(--dark-card); border: 1px solid var(--dark-border); border-radius: 16px; padding: 1.5rem; }
        .empty-state { background: var(--dark-card); border: 1px solid var(--dark-border); border-radius: 16px; padding: 3rem; text-align: center; color: var(--text-muted); }
        .empty-state i { font-size: 3rem; color: var(--royal-purple); margin-bottom: 1rem; }
        .back-link { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; }
        .back-link:hover { color: var(--royal-gold); }
        /* Graph containers */
        .graph-container { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 16px; overflow: hidden; backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur)); box-shadow: var(--shadow-md); }
        .graph-canvas { width: 100%; height: 500px; }
        .graph-header { padding: 1rem 1.25rem; border-bottom: 1px solid var(--dark-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
        .graph-header h5 { margin: 0; font-size: 0.95rem; font-weight: 600; }
        .graph-legend { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
        .legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.75rem; color: var(--text-muted); }
        .legend-dot { width: 10px; height: 10px; border-radius: 50%; }
        /* Student selector */
        .student-selector { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 16px; padding: 1.25rem; margin-bottom: 1.5rem; backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur)); box-shadow: var(--shadow-sm); }
        .student-chip { display: inline-block; padding: 6px 14px; border-radius: 20px; font-size: 0.82rem; cursor: pointer; margin: 3px; border: 1px solid var(--dark-border); background: var(--dark-bg); color: var(--text-secondary); transition: all 0.2s; }
        .student-chip:hover { border-color: var(--royal-purple); color: var(--text-primary); }
        .student-chip.active { background: var(--royal-purple); border-color: var(--royal-purple); color: white; }
        .student-chip.batch-avg { background: rgba(245, 158, 11, 0.15); border-color: var(--royal-gold); color: var(--royal-gold); }
        .student-chip.batch-avg.active { background: var(--royal-gold); color: #0F172A; }
        /* Mastery colors */
        .mastery-red { background: rgba(239, 68, 68, 0.3); color: #FCA5A5; }
        .mastery-yellow { background: rgba(245, 158, 11, 0.3); color: #FDE68A; }
        .mastery-green { background: rgba(34, 197, 94, 0.3); color: #86EFAC; }
        .mastery-cell { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 20px; font-weight: 600; font-size: 0.8rem; }
        /* View mode toggle */
        .view-mode-toggle { display: flex; gap: 4px; }
        .view-mode-btn { padding: 6px 16px; font-size: 0.8rem; border: 1px solid var(--dark-border); background: none; color: var(--text-muted); border-radius: 8px; cursor: pointer; transition: all 0.2s; }
        .view-mode-btn.active { background: var(--royal-gold); border-color: var(--royal-gold); color: #0F172A; font-weight: 600; }
        .view-mode-btn:hover:not(.active) { border-color: var(--royal-purple); color: var(--text-primary); }
        /* Breadcrumb */
        .graph-breadcrumb { padding: 0.5rem 1.25rem; background: rgba(15, 23, 42, 0.8); border-bottom: 1px solid var(--dark-border); font-size: 0.82rem; display: none; }
        .graph-breadcrumb.show { display: block; }
        .graph-breadcrumb a { color: var(--royal-purple); text-decoration: none; cursor: pointer; }
        .graph-breadcrumb a:hover { color: var(--royal-gold); }
        .graph-breadcrumb .separator { margin: 0 8px; color: var(--text-muted); }
        .graph-breadcrumb .current-chapter { color: var(--text-secondary); }
        /* Loading indicator */
        .graph-loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; color: var(--text-muted); display: none; z-index: 10; }
        .graph-loading.show { display: block; }
        .graph-loading .spinner { width: 36px; height: 36px; border: 3px solid var(--dark-border); border-top-color: var(--royal-purple); border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 0.75rem; }
        @keyframes spin { to { transform: rotate(360deg); } }
        /* Chapter info panel (absolutely positioned to avoid layout thrashing) */
        .chapter-info-panel {
            width: 300px;
            background: var(--glass-bg);
            border-left: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            z-index: 20;
            transition: transform 0.3s;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            box-shadow: var(--shadow-lg);
        }
        .chapter-info-panel.hidden { transform: translateX(100%); pointer-events: none; }
        .ch-info-header { padding: 1.25rem; border-bottom: 1px solid var(--dark-border); }
        .ch-info-header h5 { font-size: 0.95rem; font-weight: 600; margin-bottom: 4px; color: var(--text-primary); }
        .ch-info-header small { color: var(--text-muted); font-size: 0.75rem; }
        .ch-info-body { padding: 1.25rem; flex: 1; overflow-y: auto; }
        .ch-mastery-ring { text-align: center; margin-bottom: 1.25rem; }
        .ch-mastery-pct { font-size: 2rem; font-weight: 700; }
        .ch-mastery-label { font-size: 0.75rem; color: var(--text-muted); }
        .ch-stat-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--dark-border); font-size: 0.82rem; color: var(--text-primary); }
        .ch-stat-row:last-child { border-bottom: none; }
        .ch-stat-label { color: var(--text-muted); }
        .ch-concepts-preview { max-height: 300px; overflow-y: auto; }
        .ch-concept-row { display: flex; align-items: center; gap: 8px; padding: 5px 8px; border-radius: 6px; font-size: 0.78rem; color: var(--text-primary); }
        .ch-concept-row .concept-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
        .ch-concept-row .concept-name { flex: 1; line-height: 1.3; }
        .ch-concept-row .concept-pct { color: var(--text-muted); font-size: 0.72rem; flex-shrink: 0; }
        .ch-info-footer { padding: 1.25rem; border-top: 1px solid var(--dark-border); }
        .btn-enter-chapter { width: 100%; background: linear-gradient(135deg, var(--royal-purple), var(--royal-blue)); border: none; color: white; padding: 10px; border-radius: 10px; font-weight: 600; font-size: 0.9rem; cursor: pointer; transition: opacity 0.2s; }
        .btn-enter-chapter:hover { opacity: 0.9; }
        /* Syllabus toggle button in chapter info panel */
        .btn-toggle-taught { width: 100%; border: 1px solid var(--dark-border); color: var(--text-secondary); background: var(--dark-bg); padding: 8px; border-radius: 10px; font-weight: 600; font-size: 0.82rem; cursor: pointer; transition: all 0.2s; margin-bottom: 8px; }
        .btn-toggle-taught:hover { border-color: var(--royal-purple); color: var(--text-primary); }
        .btn-toggle-taught.taught { background: rgba(16, 185, 129, 0.15); border-color: #10B981; color: #10B981; }
        /* Syllabus Progress panel */
        .syllabus-progress-panel { background: var(--glass-bg); border: 1px solid var(--glass-border); border-radius: 16px; padding: 1.25rem; margin-bottom: 1.5rem; backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur)); box-shadow: var(--shadow-sm); }
        .syllabus-toggle-header { display: flex; justify-content: space-between; align-items: center; cursor: pointer; user-select: none; }
        .syllabus-toggle-header .section-title { margin-bottom: 0; }
        .syllabus-body { max-height: 300px; overflow-y: auto; margin-top: 0.75rem; }
        .syllabus-chapter-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 8px; border-radius: 8px; font-size: 0.82rem; color: var(--text-primary); }
        .syllabus-chapter-row:hover { background: rgba(124, 58, 237, 0.08); }
        .syllabus-mastery-badge { padding: 2px 10px; border-radius: 12px; font-weight: 600; font-size: 0.75rem; }
        .delta-warning-card { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 10px; padding: 10px 14px; margin-bottom: 8px; font-size: 0.8rem; }
        .delta-warning-card .warn-title { color: #FCA5A5; font-weight: 600; }
        .delta-warning-card .warn-detail { color: var(--text-muted); font-size: 0.75rem; margin-top: 2px; }
        /* Report card export button */
        .btn-report-card { background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 2px 4px; font-size: 0.78rem; transition: color 0.2s; vertical-align: middle; }
        .btn-report-card:hover { color: var(--royal-gold); }
        .btn-report-card .spinner-border { width: 12px; height: 12px; border-width: 2px; }
    </style>
</head>
<body>
    <div class="dashboard-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1><i class="bi bi-graph-up me-2"></i>Teacher Dashboard</h1>
                    <a href="/" class="back-link"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
                </div>
                <div style="display:flex;align-items:center;gap:12px;">
                    <a href="/assignments" style="padding:8px 18px;background:linear-gradient(135deg,var(--purple),var(--blue));color:#fff;border-radius:10px;text-decoration:none;font-weight:600;font-size:0.88rem;display:inline-flex;align-items:center;gap:6px;box-shadow:0 4px 12px rgba(124,58,237,0.3);transition:all 0.2s;" onmouseenter="this.style.transform='translateY(-1px)'" onmouseleave="this.style.transform=''">
                        <i class="bi bi-clipboard-data"></i> Assignments
                    </a>
                    <form method="POST" action="/logout" style="margin:0">
                        <button type="submit" class="btn btn-outline-light"><i class="bi bi-box-arrow-right me-1"></i> Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <!-- Filter Bar -->
        <div class="filter-bar animate-in">
            <form method="GET" action="/institute/dashboard/teacher" id="filterForm">
                <div class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label for="batchSelect" class="form-label">Select Batch</label>
                        <select name="batchId" id="batchSelect" class="form-select" onchange="document.getElementById('filterForm').submit()">
                            <option value="">-- Choose a batch --</option>
                            <% batches.forEach(function(batch) { %>
                                <option value="<%= batch.id %>" <%= selectedBatchId == batch.id ? 'selected' : '' %>><%= batch.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label for="subjectSelect" class="form-label">Filter by Subject</label>
                        <select name="subject" id="subjectSelect" class="form-select" onchange="document.getElementById('filterForm').submit()">
                            <option value="">All Subjects</option>
                            <% subjects.forEach(function(subj) { %>
                                <option value="<%= subj %>" <%= selectedSubject === subj ? 'selected' : '' %>><%= subj %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
            </form>
        </div>

        <% if (!selectedBatchId) { %>
            <div class="empty-state">
                <i class="bi bi-grid-3x3-gap d-block"></i>
                <h5>Select a Batch</h5>
                <p>Choose a batch from the dropdown above to view the knowledge graph.</p>
            </div>
        <% } else if (heatmapData && heatmapData.students.length === 0) { %>
            <div class="empty-state">
                <i class="bi bi-people d-block"></i>
                <h5>No Students Found</h5>
                <p>This batch has no students assigned yet.</p>
            </div>
        <% } else if (heatmapData && heatmapData.concepts.length === 0) { %>
            <div class="empty-state">
                <i class="bi bi-book d-block"></i>
                <h5>No Concepts Found</h5>
                <p>No concepts match the selected filter.</p>
            </div>
        <% } else if (heatmapData) { %>
            <!-- Student Selector -->
            <div class="student-selector animate-in" style="animation-delay:0.05s">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="section-title mb-0"><i class="bi bi-people me-2"></i>View Knowledge Graph For</div>
                    <div class="view-mode-toggle">
                        <button class="view-mode-btn active" data-view="chapters" onclick="switchViewMode('chapters')">
                            <i class="bi bi-grid-3x3-gap me-1"></i>Chapters
                        </button>
                        <button class="view-mode-btn" data-view="concepts" onclick="switchViewMode('concepts')">
                            <i class="bi bi-diagram-3 me-1"></i>Concepts
                        </button>
                    </div>
                </div>
                <span class="student-chip batch-avg active" data-student="batch-avg" onclick="selectStudent('batch-avg')">
                    <i class="bi bi-bar-chart me-1"></i>Batch Average
                </span>
                <% heatmapData.students.forEach(function(student) { %>
                    <span class="student-chip" data-student="<%= student.id %>" onclick="selectStudent('<%= student.id %>')">
                        <%= student.name %>
                    </span><button class="btn-report-card" title="Export Report Card" onclick="event.stopPropagation(); exportReportCard(this, '<%= student.id %>')"><i class="bi bi-file-earmark-pdf"></i></button>
                <% }); %>
            </div>

            <% if (selectedBatchId) { %>
            <!-- Syllabus Progress Panel -->
            <div class="syllabus-progress-panel animate-in" style="animation-delay:0.07s" id="syllabusProgressPanel">
                <div class="syllabus-toggle-header" onclick="toggleSyllabusBody()">
                    <div class="section-title"><i class="bi bi-journal-check me-2"></i>Syllabus Progress</div>
                    <i class="bi bi-chevron-down" id="syllabusChevron" style="color:var(--text-muted);transition:transform 0.2s;"></i>
                </div>
                <div id="syllabusBody" style="display:none;">
                    <div class="mt-2 mb-2">
                        <div class="d-flex justify-content-between align-items-center mb-1" style="font-size:0.82rem;">
                            <span id="syllabusCountLabel" style="color:var(--text-secondary);">0 / 0 chapters taught</span>
                            <span id="syllabusCountPct" style="color:var(--text-muted);font-size:0.75rem;">0%</span>
                        </div>
                        <div class="progress" style="height:6px;background:var(--dark-bg);border-radius:4px;">
                            <div class="progress-bar" id="syllabusProgressBar" role="progressbar" style="width:0%;background:var(--royal-purple);border-radius:4px;"></div>
                        </div>
                    </div>
                    <!-- Delta Warnings -->
                    <div id="deltaWarnings"></div>
                    <!-- Taught chapters list -->
                    <div class="syllabus-body" id="taughtChaptersList"></div>
                </div>
            </div>
            <% } %>

            <!-- Knowledge Graph -->
            <div class="graph-container animate-in" style="position: relative; animation-delay:0.1s">
                <div class="graph-header">
                    <h5 id="graphTitle"><i class="bi bi-grid-3x3-gap me-2"></i>Batch Average — Chapter Overview</h5>
                    <div class="graph-legend">
                        <div class="legend-item"><div class="legend-dot" style="background:#22D3EE"></div> Start Here</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#10B981"></div> Mastered (≥80%)</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#F59E0B"></div> In Progress (50-80%)</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#EF4444"></div> Weak (&lt;50%)</div>
                        <div class="legend-item"><div class="legend-dot" style="background:#6B7280"></div> No Data</div>
                        <div class="legend-item"><div style="width:24px;height:2px;border-top:2px dashed #A855F7;flex-shrink:0"></div> Cross-Chapter Dep.</div>
                    </div>
                </div>
                <div class="graph-breadcrumb" id="graphBreadcrumb">
                    <a onclick="navigateBackToMacro()">All Chapters</a>
                    <span class="separator">›</span>
                    <span class="current-chapter" id="breadcrumbChapterName">—</span>
                </div>
                <div class="graph-loading" id="graphLoading">
                    <div class="spinner"></div>
                    <div>Loading graph data...</div>
                </div>
                <!-- Chapter Info Panel (absolutely positioned) -->
                <div class="chapter-info-panel hidden" id="chapterInfoPanel">
                    <div class="ch-info-header">
                        <h5 id="chapterInfoName">—</h5>
                        <small id="chapterInfoSubject">—</small>
                    </div>
                    <div class="ch-info-body">
                        <div class="ch-mastery-ring">
                            <div class="ch-mastery-pct" id="chapterInfoMastery">—</div>
                            <div class="ch-mastery-label">Unit Mastery</div>
                        </div>
                        <div class="ch-stat-row"><span class="ch-stat-label">Subconcepts</span><span id="chapterInfoConceptCount">—</span></div>
                        <div class="ch-stat-row"><span class="ch-stat-label">Mastered</span><span id="chapterInfoMasteredCount">—</span></div>
                        <div class="ch-concepts-preview" id="chapterConceptsPreview">
                            <h6 style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);margin:1rem 0 0.5rem">Subconcepts</h6>
                            <div id="chapterConceptsList"></div>
                        </div>
                    </div>
                    <div class="ch-info-footer">
                        <button class="btn-toggle-taught" id="btnToggleTaught" onclick="toggleChapterTaught()" style="display:none;">
                            <i class="bi bi-check-circle me-1"></i><span>Mark as Taught</span>
                        </button>
                        <button class="btn-enter-chapter" id="btnEnterChapter" onclick="enterSelectedChapter()">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Enter Unit
                        </button>
                    </div>
                </div>
                <div class="graph-canvas" id="macroGraphCanvas"></div>
                <div class="graph-canvas" id="microGraphCanvas" style="display:none;"></div>
                <div class="graph-canvas" id="knowledgeGraph" style="display:none;"></div>
            </div>
        <% } %>

        <!-- Stuck Students Panel -->
        <% if (stuckStudents && stuckStudents.length > 0) { %>
        <div class="card-section mt-4 animate-in" style="animation-delay:0.15s" id="stuck-students-panel">
            <div class="section-title"><i class="bi bi-exclamation-triangle me-2"></i>Stuck Students</div>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: separate; border-spacing: 0;">
                    <thead>
                        <tr>
                            <% ['Student','Concept','Mastery','Questions Answered','Correct Answers'].forEach(function(h) { %>
                            <th style="background: var(--dark-bg); color: var(--text-secondary); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.75rem 1rem; border-bottom: 1px solid var(--dark-border);"><%= h %></th>
                            <% }); %>
                        </tr>
                    </thead>
                    <tbody>
                        <% stuckStudents.forEach(function(s) { %>
                            <tr>
                                <td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--dark-border);">
                                    <a href="/institute/dashboard/teacher/gaps/<%= s.user_id %>/<%= s.concept_id %>" style="color: var(--royal-purple); text-decoration: none; font-weight: 500;"><%= s.name %></a>
                                </td>
                                <td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--dark-border);"><%= s.concept_name %></td>
                                <td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--dark-border);">
                                    <span class="mastery-cell" data-mastery="<%= parseFloat(s.mastery).toFixed(2) %>"><%= Math.round(parseFloat(s.mastery) * 100) %>%</span>
                                </td>
                                <td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--dark-border);"><%= s.questions_answered %></td>
                                <td style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--dark-border);"><%= s.correct_answers %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Color-code mastery cells
        document.querySelectorAll('.mastery-cell').forEach(function(cell) {
            var m = parseFloat(cell.getAttribute('data-mastery'));
            if (isNaN(m)) return;
            cell.classList.add(m < 0.4 ? 'mastery-red' : m < 0.7 ? 'mastery-yellow' : 'mastery-green');
        });

        // Data from server
        const heatmapData = <%- JSON.stringify(heatmapData || null) %>;
        const prereqs = <%- JSON.stringify(prereqs || []) %>;
        const selectedBatchId = '<%= selectedBatchId || "" %>';
        const selectedSubject = '<%= selectedSubject || "" %>';

        let macroNetwork = null;
        let microNetwork = null;
        let conceptNetwork = null;
        let currentStudentView = 'batch-avg';
        let currentViewMode = 'chapters'; // 'chapters' or 'concepts'
        let currentDrillChapter = null;

        // Cached data for macro graph
        let cachedChaptersData = null;
        let cachedBatchMastery = null;
        let cachedUserMasteryMap = {}; // userId -> mastery data
        let selectedChapterId = null; // Currently selected chapter in macro view
        let cachedChapterPrereqs = []; // Chapter-level prerequisites from last macro render
        let cachedChapterMastery = {}; // Chapter-level mastery map from last macro render

        // ===== Color helpers =====
        function chapterMasteryColor(m, isStartingPoint) {
            if (m === null || m === undefined) return isStartingPoint ? '#22D3EE' : '#6B7280'; // Cyan for entry points, gray for others
            if (m >= 0.8) return '#10B981';
            if (m >= 0.5) return '#F59E0B';
            return '#EF4444';
        }

        function conceptMasteryColor(m) {
            if (m >= 0.7) return '#10B981';
            if (m >= 0.4) return '#F59E0B';
            return '#EF4444';
        }

        // ===== Loading indicator =====
        function showGraphLoading() {
            const el = document.getElementById('graphLoading');
            if (el) el.classList.add('show');
        }
        function hideGraphLoading() {
            const el = document.getElementById('graphLoading');
            if (el) el.classList.remove('show');
        }

        // ===== View mode switching =====
        function switchViewMode(mode) {
            currentViewMode = mode;
            document.querySelectorAll('.view-mode-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.view === mode);
            });

            // Reset drill-down state
            currentDrillChapter = null;
            selectedChapterId = null;
            document.getElementById('graphBreadcrumb').classList.remove('show');
            document.getElementById('chapterInfoPanel').classList.add('hidden');

            if (mode === 'chapters') {
                document.getElementById('macroGraphCanvas').style.display = 'block';
                document.getElementById('microGraphCanvas').style.display = 'none';
                document.getElementById('knowledgeGraph').style.display = 'none';
                renderTeacherMacroGraph();
            } else {
                document.getElementById('macroGraphCanvas').style.display = 'none';
                document.getElementById('microGraphCanvas').style.display = 'none';
                document.getElementById('knowledgeGraph').style.display = 'block';
                renderConceptGraph();
            }
        }

        // ===== Student selection =====
        function selectStudent(studentId) {
            currentStudentView = studentId;
            document.querySelectorAll('.student-chip').forEach(chip => {
                chip.classList.toggle('active', chip.dataset.student === studentId);
            });

            if (!heatmapData) return;

            if (currentViewMode === 'chapters') {
                // Reset to macro view when switching students
                currentDrillChapter = null;
                selectedChapterId = null;
                document.getElementById('graphBreadcrumb').classList.remove('show');
                document.getElementById('chapterInfoPanel').classList.add('hidden');
                document.getElementById('macroGraphCanvas').style.display = 'block';
                document.getElementById('microGraphCanvas').style.display = 'none';
                renderTeacherMacroGraph();
            } else {
                renderConceptGraph();
            }
        }

        // ===== Macro Graph (Chapter-level) =====
        async function fetchChaptersData() {
            if (cachedChaptersData) return cachedChaptersData;
            const response = await fetch('/api/chapters');
            if (!response.ok) throw new Error('Failed to fetch chapters');
            cachedChaptersData = await response.json();
            return cachedChaptersData;
        }

        async function fetchBatchChapterMastery(batchId) {
            const response = await fetch(`/api/batch/${batchId}/chapter-mastery`);
            if (!response.ok) throw new Error('Failed to fetch batch chapter mastery');
            return await response.json();
        }

        async function fetchUserChapterMastery(userId) {
            if (cachedUserMasteryMap[userId]) return cachedUserMasteryMap[userId];
            const response = await fetch(`/api/user/${userId}/chapter-mastery`);
            if (!response.ok) throw new Error('Failed to fetch user chapter mastery');
            const data = await response.json();
            cachedUserMasteryMap[userId] = data;
            return data;
        }

        async function renderTeacherMacroGraph() {
            if (!selectedBatchId) return;
            showGraphLoading();

            try {
                // Check if vis-network loaded successfully
                if (typeof vis === 'undefined' || typeof vis.Network === 'undefined') {
                    hideGraphLoading();
                    const container = document.getElementById('macroGraphCanvas');
                    container.innerHTML = '<div style="text-align:center;padding:3rem;color:var(--text-muted);">' +
                        '<i class="bi bi-exclamation-triangle" style="font-size:2rem;display:block;margin-bottom:0.5rem;"></i>' +
                        'Graph visualization unavailable. Please refresh the page or check your internet connection.</div>';
                    return;
                }
                
                const chaptersData = await fetchChaptersData();

                // Get mastery data based on current student selection with BKT unavailability handling
                let masteryMap = {};
                let titlePrefix = '';
                let bktWarning = false;

                if (currentStudentView === 'batch-avg') {
                    try {
                        const batchMastery = await fetchBatchChapterMastery(selectedBatchId);
                        cachedBatchMastery = batchMastery;
                        (batchMastery.chapterMastery || []).forEach(m => {
                            masteryMap[m.chapter_id] = m.avg_mastery !== undefined ? m.avg_mastery : m.mastery;
                        });
                    } catch (masteryError) {
                        console.warn('BKT service may be unavailable:', masteryError);
                        bktWarning = true;
                        if (cachedBatchMastery) {
                            (cachedBatchMastery.chapterMastery || []).forEach(m => {
                                masteryMap[m.chapter_id] = m.avg_mastery !== undefined ? m.avg_mastery : m.mastery;
                            });
                        }
                    }
                    titlePrefix = 'Batch Average';
                } else {
                    try {
                        const userMastery = await fetchUserChapterMastery(currentStudentView);
                        (userMastery.chapterMastery || []).forEach(m => {
                            masteryMap[m.chapter_id] = m.mastery;
                        });
                    } catch (masteryError) {
                        console.warn('BKT service may be unavailable:', masteryError);
                        bktWarning = true;
                    }
                    const student = heatmapData.students.find(s => String(s.id) === String(currentStudentView));
                    titlePrefix = student ? student.name : 'Student';
                }
                
                // Check if there's any mastery data
                const hasMasteryData = Object.keys(masteryMap).length > 0;

                // Filter chapters by subject
                const filteredChapters = chaptersData.chapters.filter(c => {
                    if (!selectedSubject) return true;
                    if (selectedSubject === 'Physics') return c.subject.startsWith('Physics');
                    if (selectedSubject === 'Mathematics' || selectedSubject === 'Maths') return c.subject.startsWith('Mathematics');
                    if (selectedSubject === 'Chemistry') return c.subject.startsWith('Chemistry');
                    return c.subject === selectedSubject || c.subject.startsWith(selectedSubject);
                });

                // Build nodes
                const chapterIds = new Set(filteredChapters.map(c => c.id));
                
                // Track which chapters have prereqs (for starting point detection)
                const hasPrereqInFilter = new Set();
                chaptersData.prerequisites
                    .filter(p => chapterIds.has(p.chapter_id) && chapterIds.has(p.prereq_id))
                    .forEach(p => hasPrereqInFilter.add(p.chapter_id));
                
                // Cache prereqs and mastery for info panel
                cachedChapterPrereqs = chaptersData.prerequisites;
                cachedChapterMastery = masteryMap;
                
                const nodes = filteredChapters.map(chapter => {
                    const mastery = masteryMap[chapter.id] !== undefined ? masteryMap[chapter.id] : null;
                    const isStartingPoint = !hasPrereqInFilter.has(chapter.id);
                    const color = chapterMasteryColor(mastery, isStartingPoint);
                    const size = 20 + (mastery !== null ? Math.round(mastery * 15) : 0);
                    const pct = mastery !== null ? Math.round(mastery * 100) + '%' : 'No data';

                    return {
                        id: chapter.id,
                        label: chapter.name,
                        title: chapter.name + ' — ' + pct,
                        color: { background: color, border: color, highlight: { background: color, border: '#F59E0B' } },
                        font: { color: '#F1F5F9', size: 12, face: 'Inter, system-ui, sans-serif' },
                        shape: 'dot',
                        size: size,
                        mastery: mastery,
                        chapterData: chapter
                    };
                });

                // Build edges (only between visible chapters)
                const prerequisiteEdges = chaptersData.prerequisites
                    .filter(p => chapterIds.has(p.chapter_id) && chapterIds.has(p.prereq_id))
                    .map(p => ({
                        from: p.prereq_id,
                        to: p.chapter_id,
                        arrows: 'to',
                        color: { color: '#374151', highlight: '#7C3AED' },
                        width: 2,
                        smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 }
                    }));

                // Add bridge edges (cross-chapter concept dependencies) with distinct styling
                const bridgeEdgeSet = new Set(prerequisiteEdges.map(e => e.from + '->' + e.to));
                const bridgeEdges = (chaptersData.bridgeEdges || [])
                    .filter(b => chapterIds.has(b.from_chapter) && chapterIds.has(b.to_chapter))
                    .filter(b => !bridgeEdgeSet.has(b.from_chapter + '->' + b.to_chapter))
                    .map(b => ({
                        from: b.from_chapter,
                        to: b.to_chapter,
                        arrows: 'to',
                        color: { color: '#A855F7', highlight: '#C084FC' },
                        width: 1.5,
                        dashes: [8, 4],
                        title: b.concept_count + ' cross-chapter concept ' + (b.concept_count === 1 ? 'dependency' : 'dependencies'),
                        smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 }
                    }));

                const edges = [...prerequisiteEdges, ...bridgeEdges];

                // Render
                const container = document.getElementById('macroGraphCanvas');
                if (macroNetwork) macroNetwork.destroy();

                macroNetwork = new vis.Network(container, {
                    nodes: new vis.DataSet(nodes),
                    edges: new vis.DataSet(edges)
                }, {
                    layout: {
                        hierarchical: {
                            enabled: true,
                            direction: 'LR',
                            sortMethod: 'directed',
                            levelSeparation: 200,
                            nodeSpacing: 100,
                            treeSpacing: 150,
                            blockShifting: true,
                            edgeMinimization: true
                        }
                    },
                    physics: false,
                    interaction: { hover: true, tooltipDelay: 200, zoomView: true, dragView: true },
                    nodes: { borderWidth: 2 },
                    edges: { smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 } }
                });

                // Double-click to drill down directly
                macroNetwork.on('doubleClick', params => {
                    if (params.nodes.length > 0) {
                        document.getElementById('chapterInfoPanel').classList.add('hidden');
                        drillDownToChapter(params.nodes[0]);
                    }
                });

                // Single-click: show chapter info or dismiss panel on empty area
                macroNetwork.on('click', params => {
                    if (params.nodes.length > 0) {
                        showChapterInfo(params.nodes[0]);
                    } else {
                        document.getElementById('chapterInfoPanel').classList.add('hidden');
                        selectedChapterId = null;
                    }
                });

                document.getElementById('graphTitle').innerHTML =
                    '<i class="bi bi-grid-3x3-gap me-2"></i>' + titlePrefix + ' — Chapter Overview';

                // Show overlay for no mastery data
                if (!hasMasteryData) {
                    const overlay = document.createElement('div');
                    overlay.style.cssText = 'position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;background:rgba(15,23,42,0.85);padding:1.5rem 2rem;border-radius:12px;border:1px solid var(--dark-border);z-index:5;pointer-events:none;';
                    overlay.innerHTML = '<i class="bi bi-lightbulb" style="font-size:2rem;color:var(--royal-gold);display:block;margin-bottom:0.5rem;"></i>' +
                        '<div style="color:var(--text-primary);font-size:0.9rem;font-weight:600;margin-bottom:0.25rem;">No mastery data yet</div>' +
                        '<div style="color:var(--text-muted);font-size:0.8rem;">Students need to start practicing to see progress here</div>';
                    container.style.position = 'relative';
                    container.appendChild(overlay);
                }
                
                // Show BKT service warning if applicable
                if (bktWarning) {
                    const warning = document.createElement('div');
                    warning.style.cssText = 'position:absolute;top:8px;right:8px;background:rgba(245,158,11,0.15);border:1px solid var(--royal-gold);padding:6px 12px;border-radius:8px;font-size:0.75rem;color:var(--royal-gold);z-index:5;display:flex;align-items:center;gap:6px;';
                    warning.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Using cached mastery data';
                    container.style.position = 'relative';
                    container.appendChild(warning);
                }

                hideGraphLoading();
                // Apply taught chapter badges
                applyTaughtBadges();
            } catch (error) {
                console.error('Failed to render macro graph:', error);
                hideGraphLoading();
                const container = document.getElementById('macroGraphCanvas');
                container.innerHTML = '<div style="text-align:center;padding:3rem;color:var(--text-muted);">' +
                    '<i class="bi bi-exclamation-triangle" style="font-size:2rem;display:block;margin-bottom:0.5rem;"></i>' +
                    'Unable to load chapter graph. Please refresh the page.</div>';
            }
        }

        // ===== Micro Graph (Drill-down into a chapter) =====
        async function drillDownToChapter(chapterId) {
            currentDrillChapter = chapterId;
            selectedChapterId = null;
            document.getElementById('chapterInfoPanel').classList.add('hidden');
            showGraphLoading();

            // Switch canvases
            document.getElementById('macroGraphCanvas').style.display = 'none';
            document.getElementById('microGraphCanvas').style.display = 'block';
            document.getElementById('knowledgeGraph').style.display = 'none';

            try {
                // Fetch chapter concepts
                let url = `/api/chapters/${chapterId}/concepts`;
                if (currentStudentView !== 'batch-avg') {
                    url += `?userId=${currentStudentView}`;
                }
                const response = await fetch(url);
                if (!response.ok) throw new Error('Failed to fetch chapter concepts');
                const data = await response.json();

                // Update breadcrumb
                document.getElementById('breadcrumbChapterName').textContent = data.chapter.name;
                document.getElementById('graphBreadcrumb').classList.add('show');

                // Update title
                const titlePrefix = currentStudentView === 'batch-avg' ? 'Batch Average' :
                    (heatmapData.students.find(s => String(s.id) === String(currentStudentView))?.name || 'Student');
                document.getElementById('graphTitle').innerHTML =
                    '<i class="bi bi-diagram-3 me-2"></i>' + titlePrefix + ' — ' + data.chapter.name;

                renderMicroGraph(data);
                hideGraphLoading();
            } catch (error) {
                console.error('Failed to drill down:', error);
                hideGraphLoading();
                const container = document.getElementById('microGraphCanvas');
                container.innerHTML = '<div style="text-align:center;padding:3rem;color:var(--text-muted);">' +
                    '<i class="bi bi-exclamation-triangle" style="font-size:2rem;display:block;margin-bottom:0.5rem;"></i>' +
                    'Unable to load chapter concepts. Please try again.</div>';
            }
        }

        function renderMicroGraph(data) {
            const container = document.getElementById('microGraphCanvas');

            // Check if vis-network loaded successfully
            if (typeof vis === 'undefined' || typeof vis.Network === 'undefined') {
                container.innerHTML = '<div style="text-align:center;padding:3rem;color:var(--text-muted);">' +
                    '<i class="bi bi-exclamation-triangle" style="font-size:2rem;display:block;margin-bottom:0.5rem;"></i>' +
                    'Graph visualization unavailable. Please refresh the page or check your internet connection.</div>';
                return;
            }

            if (microNetwork) microNetwork.destroy();

            if (!data.concepts || data.concepts.length === 0) {
                container.innerHTML = '<div style="text-align:center;padding:3rem;color:var(--text-muted);">' +
                    '<i class="bi bi-inbox" style="font-size:2rem;display:block;margin-bottom:0.5rem;"></i>' +
                    'No concepts available for this chapter</div>';
                return;
            }

            // Build mastery map from heatmapData if available
            let masteryMap = {};
            if (currentStudentView === 'batch-avg' && heatmapData) {
                masteryMap = heatmapData.batchAverages || {};
            } else if (heatmapData) {
                const student = heatmapData.students.find(s => String(s.id) === String(currentStudentView));
                if (student) masteryMap = student.masteries || {};
            }

            // Build regular concept nodes
            const nodes = data.concepts.map(c => {
                const m = masteryMap[c.id] !== undefined ? masteryMap[c.id] : 0.2;
                const color = conceptMasteryColor(m);
                return {
                    id: c.id,
                    label: c.name.length > 22 ? c.name.substring(0, 20) + '…' : c.name,
                    title: c.name + ' — ' + Math.round(m * 100) + '% mastery',
                    color: { background: color, border: color, highlight: { background: color, border: '#F59E0B' } },
                    font: { color: '#F1F5F9', size: 11, face: 'Inter, system-ui, sans-serif' },
                    shape: 'dot',
                    size: 16 + Math.round(m * 16),
                    isGhost: false
                };
            });

            // Add ghost nodes
            const ghostNodes = (data.ghostNodes || []).map(g => {
                const m = masteryMap[g.id] !== undefined ? masteryMap[g.id] : 0.2;
                return {
                    id: g.id,
                    label: g.name + '\n(' + g.chapter_name + ')',
                    title: g.name + ' (' + g.chapter_name + ') — ' + Math.round(m * 100) + '%',
                    color: { background: '#6B7280', border: '#9CA3AF' },
                    font: { color: '#F1F5F9', size: 10, face: 'Inter, system-ui, sans-serif' },
                    shape: 'dot',
                    size: 14,
                    borderWidth: 2,
                    borderWidthSelected: 3,
                    shapeProperties: { borderDashes: [5, 5] },
                    isGhost: true,
                    sourceChapterId: g.chapter_id
                };
            });

            const allNodes = [...nodes, ...ghostNodes];

            // Build edges
            const edges = (data.prerequisites || []).map(p => ({
                from: p.prereq_id,
                to: p.concept_id,
                arrows: 'to',
                color: { color: '#374151', highlight: '#7C3AED' },
                width: 1.5,
                smooth: { type: 'curvedCW', roundness: 0.2 }
            }));

            microNetwork = new vis.Network(container, {
                nodes: new vis.DataSet(allNodes),
                edges: new vis.DataSet(edges)
            }, {
                layout: {
                    hierarchical: {
                        enabled: true,
                        direction: 'LR',
                        sortMethod: 'directed',
                        levelSeparation: 220,
                        nodeSpacing: 90,
                        treeSpacing: 140,
                        blockShifting: true,
                        edgeMinimization: true
                    }
                },
                physics: false,
                interaction: { hover: true, tooltipDelay: 200, zoomView: true, dragView: true },
                nodes: { borderWidth: 2 },
                edges: { smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 } }
            });

            // Click handler: ghost nodes navigate to their source chapter
            microNetwork.on('click', params => {
                if (params.nodes.length > 0) {
                    const nodeId = params.nodes[0];
                    const nodeData = allNodes.find(n => n.id === nodeId);
                    if (nodeData && nodeData.isGhost && nodeData.sourceChapterId) {
                        drillDownToChapter(nodeData.sourceChapterId);
                    }
                }
            });
        }

        // ===== Chapter Info Panel =====
        async function showChapterInfo(chapterId) {
            selectedChapterId = chapterId;

            document.getElementById('chapterInfoPanel').classList.remove('hidden');

            // Update taught toggle button
            updateTaughtButton(chapterId);

            // Zoom into the clicked chapter node
            if (macroNetwork) {
                macroNetwork.focus(chapterId, { scale: 1.5, animation: { duration: 400 } });
            }

            // Find chapter data from the network node
            let chapterLabel = chapterId;
            let chapterSubject = '';
            const chapterNode = macroNetwork?.body?.data?.nodes?.get(chapterId);
            if (chapterNode) {
                chapterLabel = chapterNode.label || chapterId;
                chapterSubject = chapterNode.chapterData?.subject || '';
            }

            const mastery = cachedChapterMastery[chapterId];
            const isStartingPoint = !cachedChapterPrereqs.some(p => p.chapter_id === chapterId);

            // Populate header
            document.getElementById('chapterInfoName').textContent = chapterLabel;
            document.getElementById('chapterInfoSubject').textContent = chapterSubject;

            // Populate mastery
            if (mastery !== null && mastery !== undefined) {
                document.getElementById('chapterInfoMastery').textContent = Math.round(mastery * 100) + '%';
                document.getElementById('chapterInfoMastery').style.color = chapterMasteryColor(mastery, isStartingPoint);
            } else {
                document.getElementById('chapterInfoMastery').textContent = '—';
                document.getElementById('chapterInfoMastery').style.color = chapterMasteryColor(null, isStartingPoint);
            }

            // Set loading state for subconcepts
            document.getElementById('chapterInfoConceptCount').textContent = '…';
            document.getElementById('chapterInfoMasteredCount').textContent = '…';
            document.getElementById('chapterConceptsList').innerHTML = '<div style="color:var(--text-muted);font-size:0.8rem;padding:8px;">Loading…</div>';

            // Fetch subconcepts for this chapter
            try {
                let url = `/api/chapters/${chapterId}/concepts`;
                if (currentStudentView !== 'batch-avg') {
                    url += `?userId=${currentStudentView}`;
                }
                const response = await fetch(url);
                // Stale-request guard
                if (selectedChapterId !== chapterId) return;
                if (!response.ok) throw new Error('Failed to fetch');
                const data = await response.json();

                document.getElementById('chapterInfoConceptCount').textContent = data.concepts.length;

                // Build mastery map from heatmapData
                let mMap = {};
                if (currentStudentView === 'batch-avg' && heatmapData) {
                    mMap = heatmapData.batchAverages || {};
                } else if (heatmapData) {
                    const student = heatmapData.students.find(s => String(s.id) === String(currentStudentView));
                    if (student) mMap = student.masteries || {};
                }

                const masteredCount = data.concepts.filter(c => (mMap[c.id] || 0) >= 0.8).length;
                document.getElementById('chapterInfoMasteredCount').textContent = masteredCount + ' / ' + data.concepts.length;

                // Render subconcept list
                const listEl = document.getElementById('chapterConceptsList');
                listEl.innerHTML = '';
                data.concepts.forEach(c => {
                    const m = mMap[c.id] !== undefined ? mMap[c.id] : 0;
                    const color = conceptMasteryColor(m);
                    const row = document.createElement('div');
                    row.className = 'ch-concept-row';
                    row.innerHTML = `<div class="concept-dot" style="background:${color}"></div><span class="concept-name">${c.name}</span><span class="concept-pct">${m > 0 ? Math.round(m*100)+'%' : '—'}</span>`;
                    listEl.appendChild(row);
                });
            } catch (err) {
                if (selectedChapterId !== chapterId) return;
                console.error('Failed to load chapter concepts for info panel:', err);
                document.getElementById('chapterInfoConceptCount').textContent = '?';
                document.getElementById('chapterInfoMasteredCount').textContent = '?';
                document.getElementById('chapterConceptsList').innerHTML = '<div style="color:var(--text-muted);font-size:0.8rem;padding:8px;">Unable to load subconcepts</div>';
            }
        }

        function enterSelectedChapter() {
            if (selectedChapterId) {
                document.getElementById('chapterInfoPanel').classList.add('hidden');
                drillDownToChapter(selectedChapterId);
            }
        }

        // ===== Navigate back to macro graph =====
        function navigateBackToMacro() {
            currentDrillChapter = null;
            selectedChapterId = null;
            document.getElementById('graphBreadcrumb').classList.remove('show');
            document.getElementById('chapterInfoPanel').classList.add('hidden');
            document.getElementById('macroGraphCanvas').style.display = 'block';
            document.getElementById('microGraphCanvas').style.display = 'none';

            const titlePrefix = currentStudentView === 'batch-avg' ? 'Batch Average' :
                (heatmapData.students.find(s => String(s.id) === String(currentStudentView))?.name || 'Student');
            document.getElementById('graphTitle').innerHTML =
                '<i class="bi bi-grid-3x3-gap me-2"></i>' + titlePrefix + ' — Chapter Overview';

            // Re-render macro graph if needed
            if (!macroNetwork) {
                renderTeacherMacroGraph();
            }
        }

        // ===== Concept-level graph (existing behavior) =====
        function renderConceptGraph() {
            if (!heatmapData) return;

            // Check if vis-network loaded successfully
            if (typeof vis === 'undefined' || typeof vis.Network === 'undefined') {
                const container = document.getElementById('knowledgeGraph');
                if (container) {
                    container.innerHTML = '<div style="text-align:center;padding:3rem;color:var(--text-muted);">' +
                        '<i class="bi bi-exclamation-triangle" style="font-size:2rem;display:block;margin-bottom:0.5rem;"></i>' +
                        'Graph visualization unavailable. Please refresh the page or check your internet connection.</div>';
                }
                return;
            }

            let masteryMap = {};
            let title = '';

            if (currentStudentView === 'batch-avg') {
                masteryMap = heatmapData.batchAverages;
                title = 'Batch Average — Concept Graph';
            } else {
                const student = heatmapData.students.find(s => String(s.id) === String(currentStudentView));
                if (student) {
                    masteryMap = student.masteries;
                    title = student.name + ' — Concept Graph';
                }
            }

            const container = document.getElementById('knowledgeGraph');
            if (!container) return;

            const conceptIds = new Set(heatmapData.concepts.map(c => c.id));

            const nodes = heatmapData.concepts.map(c => {
                const m = masteryMap[c.id] !== undefined ? masteryMap[c.id] : 0.2;
                const color = conceptMasteryColor(m);
                return {
                    id: c.id,
                    label: c.name.length > 22 ? c.name.substring(0, 20) + '…' : c.name,
                    title: c.name + ' — ' + Math.round(m * 100) + '% mastery',
                    color: { background: color, border: color, highlight: { background: color, border: '#F59E0B' } },
                    font: { color: '#F1F5F9', size: 11, face: 'Inter, system-ui, sans-serif' },
                    shape: 'dot',
                    size: 16 + Math.round(m * 16),
                    mastery: m
                };
            });

            const edges = prereqs
                .filter(p => conceptIds.has(p.concept_id) && conceptIds.has(p.prereq_id))
                .map(p => ({
                    from: p.prereq_id,
                    to: p.concept_id,
                    arrows: 'to',
                    color: { color: '#374151', highlight: '#7C3AED' },
                    width: 1.5,
                    smooth: { type: 'curvedCW', roundness: 0.2 }
                }));

            if (conceptNetwork) conceptNetwork.destroy();

            // Topological level assignment
            const inDegree = {};
            const adjList = {};
            nodes.forEach(n => { inDegree[n.id] = 0; adjList[n.id] = []; });
            edges.forEach(e => {
                inDegree[e.to] = (inDegree[e.to] || 0) + 1;
                if (adjList[e.from]) adjList[e.from].push(e.to);
            });
            const levelMap = {};
            const queue = nodes.filter(n => inDegree[n.id] === 0).map(n => n.id);
            queue.forEach(id => { levelMap[id] = 0; });
            let head = 0;
            while (head < queue.length) {
                const cur = queue[head++];
                (adjList[cur] || []).forEach(next => {
                    levelMap[next] = Math.max(levelMap[next] || 0, levelMap[cur] + 1);
                    inDegree[next]--;
                    if (inDegree[next] === 0) queue.push(next);
                });
            }
            const leveledNodes = nodes.map(n => ({ ...n, level: levelMap[n.id] ?? 0 }));

            conceptNetwork = new vis.Network(container, {
                nodes: new vis.DataSet(leveledNodes),
                edges: new vis.DataSet(edges)
            }, {
                layout: {
                    hierarchical: {
                        enabled: true,
                        direction: 'LR',
                        sortMethod: 'directed',
                        levelSeparation: 200,
                        nodeSpacing: 80,
                        treeSpacing: 120,
                        blockShifting: true,
                        edgeMinimization: true
                    }
                },
                physics: false,
                interaction: { hover: true, tooltipDelay: 200, zoomView: true, dragView: true },
                nodes: { borderWidth: 2 },
                edges: { smooth: { type: 'cubicBezier', forceDirection: 'horizontal', roundness: 0.4 } }
            });

            document.getElementById('graphTitle').innerHTML = '<i class="bi bi-diagram-3 me-2"></i>' + title;
        }

        // ===== Keyboard navigation =====
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (document.getElementById('chapterInfoPanel') && !document.getElementById('chapterInfoPanel').classList.contains('hidden')) {
                    document.getElementById('chapterInfoPanel').classList.add('hidden');
                    selectedChapterId = null;
                } else if (currentDrillChapter && currentViewMode === 'chapters') {
                    navigateBackToMacro();
                }
            }
        });

        // ===== Syllabus Tracker State =====
        let taughtChapters = new Set();

        // Fetch teaching status on load
        async function fetchTeachingStatus() {
            if (!selectedBatchId) return;
            try {
                const res = await fetch('/api/syllabus/status/' + selectedBatchId);
                if (!res.ok) return;
                const data = await res.json();
                taughtChapters = new Set((data.statuses || []).map(s => s.chapter_id));
            } catch (e) { console.warn('Failed to fetch teaching status:', e); }
        }

        // Apply taught badges to macro graph nodes
        function applyTaughtBadges() {
            if (!macroNetwork) return;
            const ds = macroNetwork.body.data.nodes;
            const ids = ds.getIds();
            const updates = [];
            ids.forEach(id => {
                const node = ds.get(id);
                if (!node) return;
                const baseLabel = (node.label || '').replace(/ ✓$/, '');
                const isTaught = taughtChapters.has(id);
                updates.push({
                    id: id,
                    label: isTaught ? baseLabel + ' ✓' : baseLabel,
                    borderWidth: isTaught ? 4 : 2,
                    color: Object.assign({}, node.color, {
                        border: isTaught ? '#10B981' : (node.color?.background || '#6B7280')
                    })
                });
            });
            ds.update(updates);
        }

        // Toggle taught status for selected chapter
        async function toggleChapterTaught() {
            if (!selectedChapterId || !selectedBatchId) return;
            const btn = document.getElementById('btnToggleTaught');
            const isTaught = taughtChapters.has(selectedChapterId);
            btn.disabled = true;
            try {
                if (isTaught) {
                    const res = await fetch('/api/syllabus/unmark', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ chapterId: selectedChapterId, batchId: parseInt(selectedBatchId) })
                    });
                    if (res.ok) taughtChapters.delete(selectedChapterId);
                } else {
                    const res = await fetch('/api/syllabus/mark', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ chapterId: selectedChapterId, batchId: parseInt(selectedBatchId) })
                    });
                    if (res.ok || res.status === 409) taughtChapters.add(selectedChapterId);
                }
                updateTaughtButton(selectedChapterId);
                applyTaughtBadges();
                refreshSyllabusProgress();
            } catch (e) { console.error('Toggle taught failed:', e); }
            btn.disabled = false;
        }

        // Update the taught toggle button state
        function updateTaughtButton(chapterId) {
            const btn = document.getElementById('btnToggleTaught');
            if (!selectedBatchId) { btn.style.display = 'none'; return; }
            btn.style.display = 'block';
            const isTaught = taughtChapters.has(chapterId);
            btn.classList.toggle('taught', isTaught);
            btn.innerHTML = isTaught
                ? '<i class="bi bi-check-circle-fill me-1"></i><span>Taught — Click to Unmark</span>'
                : '<i class="bi bi-check-circle me-1"></i><span>Mark as Taught</span>';
        }

        // ===== Syllabus Progress Panel =====
        function toggleSyllabusBody() {
            const body = document.getElementById('syllabusBody');
            const chevron = document.getElementById('syllabusChevron');
            const isHidden = body.style.display === 'none';
            body.style.display = isHidden ? 'block' : 'none';
            chevron.style.transform = isHidden ? 'rotate(180deg)' : '';
        }

        function masteryColorClass(m) {
            if (m >= 0.8) return 'mastery-green';
            if (m >= 0.5) return 'mastery-yellow';
            return 'mastery-red';
        }

        async function refreshSyllabusProgress() {
            if (!selectedBatchId) return;
            try {
                const res = await fetch('/api/syllabus/delta/' + selectedBatchId);
                if (!res.ok) return;
                const data = await res.json();

                // Update progress bar
                const count = data.taughtCount || 0;
                const total = data.totalChapters || 0;
                const pct = total > 0 ? Math.round((count / total) * 100) : 0;
                document.getElementById('syllabusCountLabel').textContent = count + ' / ' + total + ' chapters taught';
                document.getElementById('syllabusCountPct').textContent = pct + '%';
                document.getElementById('syllabusProgressBar').style.width = pct + '%';

                // Delta warnings (Task 6.3)
                const warningsEl = document.getElementById('deltaWarnings');
                const warnings = (data.taughtChapters || []).filter(c => c.is_warning);
                if (warnings.length > 0) {
                    warningsEl.innerHTML = warnings.map(w =>
                        '<div class="delta-warning-card">' +
                        '<div class="warn-title"><i class="bi bi-exclamation-triangle-fill me-1"></i>' + w.chapter_name + '</div>' +
                        '<div class="warn-detail">' + Math.round((w.students_below_50 || 0) * 100) + '% of students below 50% mastery · Batch avg: ' + Math.round((w.batch_mastery || 0) * 100) + '%</div>' +
                        '</div>'
                    ).join('');
                } else {
                    warningsEl.innerHTML = '';
                }

                // Taught chapters list sorted by ascending mastery
                const listEl = document.getElementById('taughtChaptersList');
                const chapters = data.taughtChapters || [];
                if (chapters.length === 0) {
                    listEl.innerHTML = '<div style="color:var(--text-muted);font-size:0.8rem;padding:8px;text-align:center;">No chapters marked as taught yet</div>';
                } else {
                    listEl.innerHTML = chapters.map(c => {
                        const m = c.batch_mastery || 0;
                        const colorCls = masteryColorClass(m);
                        return '<div class="syllabus-chapter-row">' +
                            '<span>' + c.chapter_name + '</span>' +
                            '<span class="syllabus-mastery-badge ' + colorCls + '">' + Math.round(m * 100) + '%</span>' +
                            '</div>';
                    }).join('');
                }
            } catch (e) { console.warn('Failed to refresh syllabus progress:', e); }
        }

        // ===== Report Card Export (Task 7.1) =====
        function exportReportCard(btn, studentId) {
            if (!selectedBatchId) return;
            const icon = btn.querySelector('i');
            const origClass = icon.className;
            icon.className = 'spinner-border spinner-border-sm';
            btn.disabled = true;
            const url = '/api/report-card/' + studentId + '?batchId=' + selectedBatchId;
            window.open(url, '_blank');
            // Restore button after a short delay (PDF opens in new tab)
            setTimeout(() => {
                icon.className = origClass;
                btn.disabled = false;
            }, 2000);
        }

        // ===== Initialize =====
        if (heatmapData && heatmapData.concepts && heatmapData.concepts.length >= 0 && selectedBatchId) {
            // Fetch teaching status then render
            fetchTeachingStatus().then(() => {
                switchViewMode('chapters');
                // Apply badges after macro graph renders
                setTimeout(() => applyTaughtBadges(), 500);
                refreshSyllabusProgress();
            });
        }
    </script>
</body>
</html>
