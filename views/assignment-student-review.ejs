<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= submission.student_name %> — <%= assignment.title %> — Learn.ai</title>
    <link rel="stylesheet" href="/css/theme.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <script>
    window.MathJax = {
      tex: { inlineMath: [['$','$'],['\\(','\\)']], displayMath: [['$$','$$'],['\\[','\\]']], processEscapes: true },
      options: { renderActions: { addMenu: [] } }
    };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <style>
        .page-wrap { max-width: 900px; margin: 0 auto; padding: 2rem 1rem; }
        .page-title { font-size: 1.4rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem; }
        .page-subtitle { color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem; }
        .btn-back { color: var(--text-muted); text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 4px; margin-bottom: 1rem; }
        .btn-back:hover { color: var(--text-secondary); }

        .score-card {
            background: var(--glass-bg); backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur));
            border: 1px solid var(--glass-border); border-radius: var(--radius-xl);
            padding: 1.5rem 2rem; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
            box-shadow: var(--shadow-md); position: relative; overflow: hidden;
        }
        .score-card::before {
            content: ''; position: absolute; top: -30%; right: -15%; width: 50%; height: 50%;
            background: radial-gradient(circle, rgba(245,158,11,0.06) 0%, transparent 70%);
            pointer-events: none;
        }
        .score-left { display: flex; align-items: center; gap: 1.5rem; }
        .score-big { font-size: 2.5rem; font-weight: 700; color: var(--gold); }
        .score-max { font-size: 1rem; color: var(--text-muted); }
        .score-stats { display: flex; gap: 1.5rem; font-size: 0.85rem; }
        .stat { text-align: center; }
        .stat-val { font-size: 1.1rem; font-weight: 700; }
        .stat-val.correct { color: var(--green); }
        .stat-val.incorrect { color: var(--red); }
        .stat-val.unanswered { color: var(--text-muted); }
        .stat-label { font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; margin-top: 2px; }
        .student-info { font-size: 0.9rem; color: var(--text-secondary); }
        .student-info .name { font-weight: 600; color: var(--text-primary); font-size: 1rem; }
        .time-info { color: var(--text-muted); font-size: 0.82rem; }

        .answer-list { display: flex; flex-direction: column; gap: 1rem; }
        .answer-card { background: var(--glass-bg); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid var(--glass-border); border-radius: var(--radius); padding: 1.25rem; transition: var(--transition-slow); position: relative; overflow: hidden; }
        .answer-card::before {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(circle at 80% 20%, rgba(245,158,11,0.04) 0%, transparent 60%);
            opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
        }
        .answer-card:hover::before { opacity: 1; }
        .answer-card:hover { border-color: rgba(245,158,11,0.2); box-shadow: var(--shadow-md), var(--shadow-glow-gold); transform: translateY(-2px); }
        .answer-card.correct-card { border-left: 4px solid var(--green); }
        .answer-card.wrong-card { border-left: 4px solid var(--red); }
        .answer-card.unanswered-card { border-left: 4px solid var(--text-dim); }
        .answer-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
        .answer-q-num { font-weight: 700; color: var(--text-primary); font-size: 0.9rem; }
        .answer-badge { font-size: 0.7rem; font-weight: 600; padding: 3px 8px; border-radius: var(--radius-pill); }
        .answer-badge.correct { background: rgba(16,185,129,0.15); color: var(--green); }
        .answer-badge.wrong { background: rgba(239,68,68,0.15); color: var(--red); }
        .answer-badge.skip { background: rgba(255,255,255,0.05); color: var(--text-dim); }
        .answer-q-text { font-size: 0.92rem; color: var(--text); line-height: 1.6; margin-bottom: 0.75rem; }
        .options-grid { display: flex; flex-direction: column; gap: 6px; margin-bottom: 0.5rem; }
        .opt-row { display: flex; align-items: flex-start; gap: 8px; padding: 6px 10px; border-radius: var(--radius-sm); font-size: 0.85rem; border: 1px solid transparent; }
        .opt-row.is-correct { background: rgba(16,185,129,0.08); border-color: rgba(16,185,129,0.25); }
        .opt-row.is-selected-wrong { background: rgba(239,68,68,0.08); border-color: rgba(239,68,68,0.25); }
        .opt-letter { width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.72rem; flex-shrink: 0; background: var(--surface); border: 1px solid var(--border); color: var(--text-secondary); }
        .opt-row.is-correct .opt-letter { background: var(--green); border-color: var(--green); color: #fff; }
        .opt-row.is-selected-wrong .opt-letter { background: var(--red); border-color: var(--red); color: #fff; }
        .opt-text { line-height: 1.5; color: var(--text); }
        .opt-tag { font-size: 0.65rem; font-weight: 600; margin-left: auto; flex-shrink: 0; padding: 2px 6px; border-radius: 4px; }
        .opt-tag.correct-tag { background: rgba(16,185,129,0.15); color: var(--green); }
        .opt-tag.selected-tag { background: rgba(239,68,68,0.15); color: var(--red); }
        .answer-meta { font-size: 0.78rem; color: var(--text-dim); margin-top: 4px; }
    </style>
</head>
<body>
<div class="page-wrap">
    <a href="/assignments/<%= assignment.id %>/submissions" class="btn-back"><i class="bi bi-arrow-left"></i> Back to Submissions</a>
    <h1 class="page-title"><%= assignment.title %></h1>
    <p class="page-subtitle"><%= assignment.batch_name %> · Submitted <%= new Date(submission.submitted_at).toLocaleString() %></p>

    <div class="score-card">
        <div class="score-left">
            <div>
                <div class="score-big"><%= submission.score %></div>
                <div class="score-max">out of <%= submission.max_score %></div>
            </div>
            <%
                const correctCount = answers.filter(a => a.is_correct).length;
                const wrongCount = answers.filter(a => a.selected_option && !a.is_correct).length;
                const unansweredCount = answers.filter(a => !a.selected_option).length;
            %>
            <div class="score-stats">
                <div class="stat"><div class="stat-val correct"><%= correctCount %></div><div class="stat-label">Correct</div></div>
                <div class="stat"><div class="stat-val incorrect"><%= wrongCount %></div><div class="stat-label">Wrong</div></div>
                <div class="stat"><div class="stat-val unanswered"><%= unansweredCount %></div><div class="stat-label">Skipped</div></div>
            </div>
        </div>
        <div style="text-align:right;">
            <div class="student-info">
                <div class="name"><i class="bi bi-person-circle"></i> <%= submission.student_name %></div>
                <div><%= submission.student_email %></div>
            </div>
            <% if (submission.time_taken_seconds) { %>
                <div class="time-info" style="margin-top:4px;">
                    <i class="bi bi-clock"></i> <%= Math.floor(submission.time_taken_seconds / 60) %>m <%= submission.time_taken_seconds % 60 %>s
                </div>
            <% } %>
        </div>
    </div>

    <h2 style="font-size:1.05rem;font-weight:600;color:var(--text-primary);margin-bottom:1rem;">Question-by-Question Review</h2>
    <div class="answer-list">
        <% const optionLabels = { option1: 'A', option2: 'B', option3: 'C', option4: 'D' };
           const optionKeys = ['option1', 'option2', 'option3', 'option4'];
           answers.forEach((a, i) => {
            let cardClass = 'unanswered-card';
            let badgeClass = 'skip'; let badgeText = 'Unanswered (0)';
            if (a.selected_option && a.is_correct) { cardClass = 'correct-card'; badgeClass = 'correct'; badgeText = 'Correct (+4)'; }
            else if (a.selected_option && !a.is_correct) { cardClass = 'wrong-card'; badgeClass = 'wrong'; badgeText = 'Wrong (−1)'; }
        %>
            <div class="answer-card <%= cardClass %>">
                <div class="answer-header">
                    <span class="answer-q-num">Q.<%= a.question_order %></span>
                    <span class="answer-badge <%= badgeClass %>"><%= badgeText %></span>
                </div>
                <div class="answer-q-text"><%- a.question_text %></div>
                <div class="options-grid">
                    <% optionKeys.forEach(optKey => {
                        const letter = optionLabels[optKey];
                        const isCorrectOpt = (optKey === a.correct_answer);
                        const isSelectedWrong = (optKey === a.selected_option && !a.is_correct);
                        let rowClass = '';
                        if (isCorrectOpt) rowClass = 'is-correct';
                        else if (isSelectedWrong) rowClass = 'is-selected-wrong';
                    %>
                        <div class="opt-row <%= rowClass %>">
                            <span class="opt-letter"><%= letter %></span>
                            <span class="opt-text"><%- a[optKey] %></span>
                            <% if (isCorrectOpt) { %><span class="opt-tag correct-tag"><i class="bi bi-check"></i> Correct</span><% } %>
                            <% if (isSelectedWrong) { %><span class="opt-tag selected-tag"><i class="bi bi-x"></i> Selected</span><% } %>
                            <% if (optKey === a.selected_option && a.is_correct) { %><span class="opt-tag correct-tag"><i class="bi bi-check"></i> Selected</span><% } %>
                        </div>
                    <% }); %>
                </div>
                <div class="answer-meta">
                    <% if (a.concept_name) { %><i class="bi bi-diagram-3"></i> <%= a.concept_name %> · <% } %>
                    Difficulty: <%= a.difficulty_tier === 1 ? 'Easy' : a.difficulty_tier === 3 ? 'Hard' : 'Medium' %>
                </div>
            </div>
        <% }); %>
    </div>
</div>
</body>
</html>
