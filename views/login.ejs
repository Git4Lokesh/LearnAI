<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learn.ai — Adaptive JEE Prep</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --bg: #0A0F1E;
            --surface: #111827;
            --card: #1E293B;
            --border: #1F2937;
            --purple: #7C3AED;
            --blue: #2563EB;
            --gold: #F59E0B;
            --cyan: #22D3EE;
            --green: #10B981;
            --text: #F1F5F9;
            --muted: #94A3B8;
            --dim: #64748B;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { background: var(--bg); min-height: 100vh; font-family: 'Inter', system-ui, sans-serif; color: var(--text); }

        .auth-wrap { min-height: 100vh; display: flex; }

        /* Left — form */
        .auth-left {
            flex: 1; display: flex; align-items: center; justify-content: center;
            padding: 2rem; background: rgba(17,24,39,0.85); backdrop-filter: blur(20px);
        }
        .auth-card {
            background: var(--card); border: 1px solid var(--border); border-radius: 20px;
            padding: 2.5rem; width: 100%; max-width: 420px;
            box-shadow: 0 16px 48px rgba(0,0,0,0.4);
        }
        .auth-brand { display: flex; align-items: center; gap: 10px; justify-content: center; margin-bottom: 1.5rem; }
        .auth-brand i { color: var(--gold); font-size: 1.6rem; }
        .auth-brand span { color: var(--gold); font-weight: 700; font-size: 1.4rem; }

        /* Role tabs */
        .role-tabs { display: flex; gap: 6px; margin-bottom: 1.5rem; }
        .role-tab {
            flex: 1; padding: 10px 0; font-size: 0.8rem; font-weight: 600;
            border: 1px solid var(--border); background: none; color: var(--muted);
            border-radius: 10px; cursor: pointer; transition: all 0.2s; text-align: center;
        }
        .role-tab:hover { border-color: var(--purple); color: var(--text); }
        .role-tab.active { background: var(--purple); border-color: var(--purple); color: white; }
        .role-tab .tab-icon { display: block; font-size: 1.2rem; margin-bottom: 2px; }

        .form-floating { margin-bottom: 0.75rem; }
        .form-floating label { color: var(--muted); }
        .form-control {
            background: rgba(10,15,30,0.8); border: 1px solid var(--border); border-radius: 10px;
            color: var(--text); font-size: 0.95rem; transition: border-color 0.2s;
        }
        .form-control:focus { background: rgba(10,15,30,0.9); border-color: var(--gold); box-shadow: 0 0 0 3px rgba(245,158,11,0.15); color: var(--text); }
        .form-control::placeholder { color: var(--dim); }

        .btn-auth {
            width: 100%; padding: 12px; border: none; border-radius: 10px;
            font-weight: 600; font-size: 1rem; cursor: pointer; transition: all 0.2s;
            background: linear-gradient(135deg, var(--purple), var(--blue)); color: white;
        }
        .btn-auth:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 8px 24px rgba(124,58,237,0.4); }

        .btn-google {
            width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 10px;
            background: rgba(255,255,255,0.05); color: var(--text); font-weight: 500; font-size: 0.95rem;
            cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px;
        }
        .btn-google:hover { border-color: var(--gold); background: rgba(255,255,255,0.08); transform: translateY(-1px); color: var(--text); }

        .divider { text-align: center; margin: 1rem 0; position: relative; color: var(--dim); font-size: 0.85rem; }
        .divider::before { content: ''; position: absolute; top: 50%; left: 0; right: 0; height: 1px; background: var(--border); }
        .divider span { background: var(--card); padding: 0 0.75rem; position: relative; }

        .auth-footer { text-align: center; margin-top: 1.25rem; font-size: 0.85rem; color: var(--muted); }
        .auth-footer a { color: var(--gold); text-decoration: none; font-weight: 500; }
        .auth-footer a:hover { color: #FCD34D; }

        .error-msg { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3); color: #F87171; border-radius: 8px; padding: 8px 12px; font-size: 0.82rem; margin-bottom: 1rem; text-align: center; }

        /* Right — product info */
        .auth-right {
            flex: 1; display: flex; align-items: center; justify-content: center;
            padding: 3rem; background: linear-gradient(135deg, #0F172A 0%, #312E81 50%, #7C3AED 100%);
            position: relative; overflow: hidden;
        }
        .auth-right::before {
            content: ''; position: absolute; inset: 0;
            background: radial-gradient(circle at 30% 70%, rgba(124,58,237,0.3) 0%, transparent 60%),
                        radial-gradient(circle at 70% 30%, rgba(34,211,238,0.15) 0%, transparent 50%);
        }
        .product-info { max-width: 480px; position: relative; z-index: 1; }
        .product-hero { margin-bottom: 2.5rem; }
        .product-hero h2 { font-size: 2.2rem; font-weight: 700; color: var(--gold); margin-bottom: 0.75rem; line-height: 1.2; }
        .product-hero p { font-size: 1.1rem; color: var(--muted); line-height: 1.6; }

        .feature-grid { display: flex; flex-direction: column; gap: 1rem; }
        .feat {
            display: flex; gap: 14px; align-items: flex-start;
            background: rgba(30,41,59,0.5); border: 1px solid rgba(124,58,237,0.3);
            border-radius: 14px; padding: 1.25rem; backdrop-filter: blur(8px); transition: all 0.2s;
        }
        .feat:hover { border-color: var(--gold); transform: translateY(-2px); }
        .feat-icon {
            width: 42px; height: 42px; border-radius: 10px; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
        }
        .feat h4 { font-size: 0.95rem; font-weight: 600; color: var(--text); margin-bottom: 4px; }
        .feat p { font-size: 0.82rem; color: var(--muted); margin: 0; line-height: 1.4; }

        @media (max-width: 768px) {
            .auth-wrap { flex-direction: column; }
            .auth-right { display: none; }
            .auth-left { min-height: 100vh; }
        }
    </style>
</head>
<body>
<div class="auth-wrap">
    <div class="auth-left">
        <div class="auth-card">
            <div class="auth-brand"><i class="bi bi-diagram-3-fill"></i><span>Learn.ai</span></div>

            <!-- Role tabs -->
            <div class="role-tabs">
                <button class="role-tab active" data-role="student" onclick="switchRole('student')">
                    <span class="tab-icon"><i class="bi bi-mortarboard"></i></span>Student
                </button>
                <button class="role-tab" data-role="teacher" onclick="switchRole('teacher')">
                    <span class="tab-icon"><i class="bi bi-person-workspace"></i></span>Teacher
                </button>
                <button class="role-tab" data-role="admin" onclick="switchRole('admin')">
                    <span class="tab-icon"><i class="bi bi-building"></i></span>Institute
                </button>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-msg"><i class="bi bi-exclamation-circle me-1"></i><%= error %></div>
            <% } %>

            <!-- Login form (all roles) -->
            <form method="POST" action="/login" id="loginForm">
                <input type="hidden" name="role" id="loginRole" value="student">
                <div class="form-floating">
                    <input type="email" class="form-control" id="email" name="email" placeholder="you@example.com" required>
                    <label for="email">Email address</label>
                </div>
                <div class="form-floating">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Password" required>
                    <label for="password">Password</label>
                </div>
                <button type="submit" class="btn-auth mt-2" id="loginBtn">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>

            <div class="divider" id="googleDivider"><span>or</span></div>
            <a href="/auth/google" class="btn-google" id="googleBtn"><i class="bi bi-google"></i> Continue with Google</a>

            <div class="auth-footer" id="authFooter">
                <p>Don't have an account? <a href="/signup">Sign up as Student</a></p>
                <p id="instituteLink" style="margin-top:6px;display:none;">
                    Want to register your institute? <a href="/institute/register">Register here</a>
                </p>
            </div>
        </div>
    </div>

    <!-- Right — product showcase -->
    <div class="auth-right">
        <div class="product-info">
            <div class="product-hero">
                <h2>Adaptive JEE Prep,<br>Powered by AI</h2>
                <p>Learn.ai maps every JEE concept into a knowledge graph, tracks mastery with Bayesian Knowledge Tracing, and gives each student a personalized learning path.</p>
            </div>
            <div class="feature-grid">
                <div class="feat">
                    <div class="feat-icon" style="background:rgba(124,58,237,0.2);color:#A78BFA;"><i class="bi bi-diagram-3"></i></div>
                    <div><h4>Knowledge Graph</h4><p>54 NTA units and 220+ subconcepts mapped with prerequisite dependencies across Physics, Chemistry, and Maths</p></div>
                </div>
                <div class="feat">
                    <div class="feat-icon" style="background:rgba(34,211,238,0.15);color:#22D3EE;"><i class="bi bi-graph-up-arrow"></i></div>
                    <div><h4>BKT Mastery Tracking</h4><p>Bayesian Knowledge Tracing adapts to each student, showing exactly what to study next</p></div>
                </div>
                <div class="feat">
                    <div class="feat-icon" style="background:rgba(245,158,11,0.15);color:#F59E0B;"><i class="bi bi-building"></i></div>
                    <div><h4>Built for Coaching Centers</h4><p>Multi-tenant B2B platform — batch management, teacher dashboards, and prerequisite gap analysis</p></div>
                </div>
                <div class="feat">
                    <div class="feat-icon" style="background:rgba(16,185,129,0.15);color:#10B981;"><i class="bi bi-robot"></i></div>
                    <div><h4>AI-Powered Content</h4><p>Generate quizzes, flashcards, and study notes from any topic or uploaded PDF using Gemini AI</p></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function switchRole(role) {
    document.querySelectorAll('.role-tab').forEach(t => t.classList.toggle('active', t.dataset.role === role));
    document.getElementById('loginRole').value = role;

    const googleDiv = document.getElementById('googleDivider');
    const googleBtn = document.getElementById('googleBtn');
    const footer = document.getElementById('authFooter');
    const instLink = document.getElementById('instituteLink');
    const loginBtn = document.getElementById('loginBtn');

    if (role === 'admin') {
        googleDiv.style.display = 'none';
        googleBtn.style.display = 'none';
        instLink.style.display = 'block';
        loginBtn.innerHTML = '<i class="bi bi-building me-2"></i>Sign In as Admin';
        footer.querySelector('p:first-child').innerHTML = 'Don\'t have an account? <a href="/institute/register">Register Institute</a>';
    } else if (role === 'teacher') {
        googleDiv.style.display = 'none';
        googleBtn.style.display = 'none';
        instLink.style.display = 'none';
        loginBtn.innerHTML = '<i class="bi bi-person-workspace me-2"></i>Sign In as Teacher';
        footer.querySelector('p:first-child').innerHTML = 'Teachers are added by institute admins';
    } else {
        googleDiv.style.display = '';
        googleBtn.style.display = '';
        instLink.style.display = 'none';
        loginBtn.innerHTML = '<i class="bi bi-box-arrow-in-right me-2"></i>Sign In';
        footer.querySelector('p:first-child').innerHTML = 'Don\'t have an account? <a href="/signup">Sign up as Student</a>';
    }
}
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
