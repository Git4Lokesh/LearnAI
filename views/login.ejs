<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Learn.ai — Adaptive JEE Prep</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Page-specific: login form spacing */
        .form-floating { margin-bottom: 0.75rem; }
        .form-control { background: rgba(10,15,30,0.8); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 0.95rem; transition: border-color 0.2s; }
        .form-control:focus { background: rgba(10,15,30,0.9); border-color: var(--gold); box-shadow: 0 0 0 3px rgba(245,158,11,0.15); color: var(--text); }
        .form-control::placeholder { color: var(--text-dim); }
    </style>
</head>
<body>
<div class="auth-wrap">
    <div class="auth-left">
        <div class="auth-card">
            <div class="auth-brand"><i class="bi bi-diagram-3-fill"></i><span>Learn.ai</span></div>

            <!-- Role tabs -->
            <div class="role-tabs">
                <button class="role-tab active" data-role="student" onclick="switchRole('student')">
                    <span class="tab-icon"><i class="bi bi-mortarboard"></i></span>Student
                </button>
                <button class="role-tab" data-role="teacher" onclick="switchRole('teacher')">
                    <span class="tab-icon"><i class="bi bi-person-workspace"></i></span>Teacher
                </button>
                <button class="role-tab" data-role="admin" onclick="switchRole('admin')">
                    <span class="tab-icon"><i class="bi bi-building"></i></span>Institute
                </button>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-msg"><i class="bi bi-exclamation-circle me-1"></i><%= error %></div>
            <% } %>

            <!-- Login form (all roles) -->
            <form method="POST" action="/login" id="loginForm">
                <input type="hidden" name="role" id="loginRole" value="student">
                <div class="form-floating">
                    <input type="email" class="form-control" id="email" name="email" placeholder="you@example.com" required>
                    <label for="email">Email address</label>
                </div>
                <div class="form-floating">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Password" required>
                    <label for="password">Password</label>
                </div>
                <button type="submit" class="btn-auth mt-2" id="loginBtn">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>

            <div class="divider" id="googleDivider"><span>or</span></div>
            <a href="/auth/google" class="btn-google" id="googleBtn"><i class="bi bi-google"></i> Continue with Google</a>

            <div class="auth-footer" id="authFooter">
                <p>Don't have an account? <a href="/signup">Sign up as Student</a></p>
                <p id="instituteLink" style="margin-top:6px;display:none;">
                    Want to register your institute? <a href="/institute/register">Register here</a>
                </p>
            </div>
        </div>
    </div>

    <!-- Right — product showcase -->
    <div class="auth-right">
        <div class="product-info">
            <div class="product-hero">
                <h2>Adaptive JEE Prep,<br>Powered by AI</h2>
                <p>Learn.ai maps every JEE concept into a knowledge graph, tracks mastery with Bayesian Knowledge Tracing, and gives each student a personalized learning path.</p>
            </div>
            <div class="feature-grid">
                <div class="feat">
                    <div class="feat-icon" style="background:rgba(124,58,237,0.2);color:#A78BFA;"><i class="bi bi-diagram-3"></i></div>
                    <div><h4>Knowledge Graph</h4><p>54 NTA units and 220+ subconcepts mapped with prerequisite dependencies across Physics, Chemistry, and Maths</p></div>
                </div>
                <div class="feat">
                    <div class="feat-icon" style="background:rgba(34,211,238,0.15);color:#22D3EE;"><i class="bi bi-graph-up-arrow"></i></div>
                    <div><h4>BKT Mastery Tracking</h4><p>Bayesian Knowledge Tracing adapts to each student, showing exactly what to study next</p></div>
                </div>
                <div class="feat">
                    <div class="feat-icon" style="background:rgba(245,158,11,0.15);color:#F59E0B;"><i class="bi bi-building"></i></div>
                    <div><h4>Built for Coaching Centers</h4><p>Multi-tenant B2B platform — batch management, teacher dashboards, and prerequisite gap analysis</p></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function switchRole(role) {
    document.querySelectorAll('.role-tab').forEach(t => t.classList.toggle('active', t.dataset.role === role));
    document.getElementById('loginRole').value = role;

    const googleDiv = document.getElementById('googleDivider');
    const googleBtn = document.getElementById('googleBtn');
    const footer = document.getElementById('authFooter');
    const instLink = document.getElementById('instituteLink');
    const loginBtn = document.getElementById('loginBtn');

    if (role === 'admin') {
        googleDiv.style.display = 'none';
        googleBtn.style.display = 'none';
        instLink.style.display = 'block';
        loginBtn.innerHTML = '<i class="bi bi-building me-2"></i>Sign In as Admin';
        footer.querySelector('p:first-child').innerHTML = 'Don\'t have an account? <a href="/institute/register">Register Institute</a>';
    } else if (role === 'teacher') {
        googleDiv.style.display = 'none';
        googleBtn.style.display = 'none';
        instLink.style.display = 'none';
        loginBtn.innerHTML = '<i class="bi bi-person-workspace me-2"></i>Sign In as Teacher';
        footer.querySelector('p:first-child').innerHTML = 'Teachers are added by institute admins';
    } else {
        googleDiv.style.display = '';
        googleBtn.style.display = '';
        instLink.style.display = 'none';
        loginBtn.innerHTML = '<i class="bi bi-box-arrow-in-right me-2"></i>Sign In';
        footer.querySelector('p:first-child').innerHTML = 'Don\'t have an account? <a href="/signup">Sign up as Student</a>';
    }
}
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
