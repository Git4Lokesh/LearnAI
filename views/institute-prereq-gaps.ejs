<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prerequisite Gap Analysis - Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Page-specific: gap table, path steps */
        .gap-table { width: 100%; border-collapse: separate; border-spacing: 0; }
        .gap-table th { background: var(--bg-alt); color: var(--text-secondary); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); }
        .gap-table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); font-size: 0.9rem; }
        .back-link { color: var(--text-secondary); text-decoration: none; font-size: 0.9rem; }
        .back-link:hover { color: var(--gold); }
    </style>
</head>
<body class="bg-alt">
    <div class="page-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1><i class="bi bi-diagram-3 me-2"></i>Prerequisite Gap Analysis</h1>
                    <span class="subtitle"><%= studentName %> — <%= conceptName %></span>
                </div>
            </div>
            <a href="/" class="back-link mt-2 d-inline-block"><i class="bi bi-arrow-left me-1"></i>Back to Dashboard</a>
        </div>
    </div>

    <div class="container py-4">
        <div class="card-section animate-in">
            <div class="section-title"><i class="bi bi-exclamation-triangle me-2"></i>Prerequisite Gaps</div>
            <% if (gaps.length === 0) { %>
                <div class="empty-state">
                    <i class="bi bi-check-circle d-block"></i>
                    <h5>No Prerequisite Gaps</h5>
                    <p>This student has mastered all prerequisites for <%= conceptName %>.</p>
                </div>
            <% } else { %>
            <table class="gap-table">
                <thead><tr><th>Concept</th><th>Mastery</th><th>Depth</th></tr></thead>
                <tbody>
                    <% gaps.slice().sort((a, b) => b.depth - a.depth).forEach(function(gap) { %>
                    <tr>
                        <td><%= gap.name %></td>
                        <td><span class="mastery-badge <%= parseFloat(gap.mastery) < 0.7 ? 'mastery-gap' : 'mastery-ok' %>"><%= Math.round(parseFloat(gap.mastery) * 100) %>%</span></td>
                        <td><%= gap.depth %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } %>
        </div>

        <div class="card-section animate-in" style="animation-delay:0.1s">
            <div class="section-title"><i class="bi bi-signpost-split me-2"></i>Recommended Learning Path</div>
            <% if (learningPath.length === 0) { %>
                <div class="empty-state"><i class="bi bi-check-circle d-block"></i><p>No remediation path needed.</p></div>
            <% } else { %>
            <div class="d-flex flex-wrap align-items-center">
                <% learningPath.forEach(function(step, index) { %>
                    <span class="path-step-badge"><%= index + 1 %>. <%= step.name %></span>
                    <% if (index < learningPath.length - 1) { %><span class="path-arrow"><i class="bi bi-arrow-right"></i></span><% } %>
                <% }); %>
            </div>
            <% } %>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
