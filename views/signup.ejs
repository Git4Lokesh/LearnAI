<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up — Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .form-floating { margin-bottom: 0.75rem; }
        .form-control { background: rgba(10,15,30,0.8); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 0.95rem; transition: border-color 0.2s; }
        .form-control:focus { background: rgba(10,15,30,0.9); border-color: var(--gold); box-shadow: 0 0 0 3px rgba(245,158,11,0.15); color: var(--text); }
        .form-control::placeholder { color: var(--text-dim); }

        /* Journey timeline */
        .journey { position: relative; z-index: 1; max-width: 400px; }
        .journey-title { font-size: 2rem; font-weight: 700; margin-bottom: 0.5rem; line-height: 1.2; }
        .journey-sub { font-size: 1.05rem; color: var(--text-muted); margin-bottom: 2.5rem; line-height: 1.5; }
        .timeline { position: relative; padding-left: 2.5rem; }
        .timeline::before {
            content: '';
            position: absolute;
            left: 15px;
            top: 8px;
            bottom: 8px;
            width: 2px;
            background: linear-gradient(to bottom, var(--purple), var(--cyan), var(--gold));
            border-radius: 1px;
        }
        .tl-step { position: relative; margin-bottom: 2rem; }
        .tl-step:last-child { margin-bottom: 0; }
        .tl-dot {
            position: absolute;
            left: -2.5rem;
            top: 2px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            border: 2px solid;
        }
        .tl-step:nth-child(1) .tl-dot { background: rgba(124,58,237,0.15); border-color: var(--purple); color: var(--purple-light); }
        .tl-step:nth-child(2) .tl-dot { background: rgba(34,211,238,0.1); border-color: var(--cyan); color: var(--cyan); }
        .tl-step:nth-child(3) .tl-dot { background: rgba(16,185,129,0.1); border-color: var(--green); color: var(--green); }
        .tl-step:nth-child(4) .tl-dot { background: rgba(245,158,11,0.1); border-color: var(--gold); color: var(--gold); }
        .tl-label { font-weight: 600; font-size: 0.95rem; color: var(--text); margin-bottom: 2px; }
        .tl-desc { font-size: 0.82rem; color: var(--text-muted); line-height: 1.4; }
    </style>
</head>
<body>
<div class="auth-wrap">
    <div class="auth-left">
        <div class="auth-card auth-card--bordered">
            <div class="auth-brand"><i class="bi bi-diagram-3-fill"></i><span>Learn.ai</span></div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-msg"><i class="bi bi-exclamation-circle me-1"></i><%= error %></div>
            <% } %>

            <form method="POST" action="/signup">
                <div class="form-floating">
                    <input type="text" class="form-control" id="fullName" name="fullName" placeholder="Your Name" required>
                    <label for="fullName">Full Name</label>
                </div>
                <div class="form-floating">
                    <input type="email" class="form-control" id="email" name="email" placeholder="you@example.com" required>
                    <label for="email">Email address</label>
                </div>
                <div class="form-floating">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Password" required minlength="6">
                    <label for="password">Password</label>
                </div>
                <button type="submit" class="btn-auth btn-auth--gold-border mt-2">
                    <i class="bi bi-person-plus me-2"></i>Join Learn.ai
                </button>
            </form>

            <div class="divider"><span>or</span></div>
            <a href="/auth/google" class="btn-google"><i class="bi bi-google"></i> Continue with Google</a>

            <div class="auth-footer">
                <p>Already have an account? <a href="/login">Sign in</a></p>
            </div>
        </div>
    </div>

    <div class="auth-right">
        <div class="journey">
            <div class="journey-title text-gradient">Journey to Mastery</div>
            <p class="journey-sub">Learn.ai maps your path through every JEE concept, adapting to your pace with AI-powered mastery tracking.</p>
            <div class="timeline">
                <div class="tl-step">
                    <div class="tl-dot"><i class="bi bi-search"></i></div>
                    <div class="tl-label">Diagnostic</div>
                    <div class="tl-desc">Quick assessment finds your starting point across Physics, Chemistry, and Maths</div>
                </div>
                <div class="tl-step">
                    <div class="tl-dot"><i class="bi bi-diagram-3"></i></div>
                    <div class="tl-label">Find Gaps</div>
                    <div class="tl-desc">Knowledge graph reveals prerequisite gaps blocking your progress</div>
                </div>
                <div class="tl-step">
                    <div class="tl-dot"><i class="bi bi-graph-up-arrow"></i></div>
                    <div class="tl-label">Adaptive Practice</div>
                    <div class="tl-desc">BKT-powered questions adapt difficulty in real-time as you improve</div>
                </div>
                <div class="tl-step">
                    <div class="tl-dot"><i class="bi bi-trophy"></i></div>
                    <div class="tl-label">Master JEE</div>
                    <div class="tl-desc">Unlock every concept node and conquer the full NTA syllabus</div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
