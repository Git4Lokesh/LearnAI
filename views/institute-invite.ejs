<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invite Users - Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        /* Page-specific: invite card centered layout */
        .invite-card {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-xl);
            padding: 2.5rem;
            max-width: 520px;
            margin: 2rem auto;
            backdrop-filter: blur(var(--glass-blur));
            -webkit-backdrop-filter: blur(var(--glass-blur));
            box-shadow: var(--shadow-xl), var(--shadow-glow-purple);
        }
        .form-control, .form-select { background: rgba(10,15,30,0.8); border: 2px solid var(--border-light); border-radius: 12px; color: var(--text); font-size: 1rem; padding: 1rem; transition: var(--transition-slow); }
        .form-control:focus, .form-select:focus { background: rgba(10,15,30,0.9); border-color: var(--gold); box-shadow: 0 0 0 0.25rem rgba(245,158,11,0.25); color: var(--text); }
        .form-control::placeholder { color: var(--text-muted); }
        .form-select option { background: var(--card); color: var(--text); }
    </style>
</head>
<body class="bg-alt">
    <div class="page-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <h1><i class="bi bi-person-plus me-2"></i>Invite Users</h1>
                <a href="/" class="btn btn-outline-light"><i class="bi bi-arrow-left me-1"></i> Dashboard</a>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="invite-card animate-in">
            <div class="section-label">Add a Teacher or Student</div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert-dark-danger p-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
                </div>
            <% } %>
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert-dark-success p-3 mb-3" role="alert">
                    <i class="bi bi-check-circle me-2"></i><%= success %>
                </div>
            <% } %>

            <form method="POST" action="/institute/invite">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="name" name="name" placeholder="Full Name" required>
                    <label for="name">Full Name</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="email" class="form-control" id="email" name="email" placeholder="user@example.com" required>
                    <label for="email">Email Address</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Temporary Password" required minlength="6">
                    <label for="password">Temporary Password</label>
                </div>
                <div class="form-floating mb-4">
                    <select class="form-select" id="role" name="role" required>
                        <option value="teacher">Teacher</option>
                        <option value="student">Student</option>
                    </select>
                    <label for="role">Role</label>
                </div>
                <button type="submit" class="btn-auth btn-auth--gold-border">
                    <i class="bi bi-send me-2"></i>Create User
                </button>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
