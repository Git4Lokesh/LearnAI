<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Institute Dashboard - AI Study Generator</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root {
            --royal-purple: #7C3AED;
            --royal-blue: #2563EB;
            --royal-gold: #F59E0B;
            --dark-bg: #0F172A;
            --dark-card: #1E293B;
            --dark-border: #334155;
            --text-primary: #F8FAFC;
            --text-secondary: #CBD5E1;
            --text-muted: #94A3B8;
        }
        body {
            background: var(--dark-bg);
            color: var(--text-primary);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
        }
        .dashboard-header {
            background: linear-gradient(135deg, #312E81 0%, #7C3AED 100%);
            padding: 2rem 0;
            border-bottom: 2px solid var(--royal-gold);
        }
        .dashboard-header h1 { color: var(--royal-gold); font-weight: 700; }
        .badge-status {
            background: rgba(245, 158, 11, 0.2);
            color: var(--royal-gold);
            border: 1px solid var(--royal-gold);
            font-size: 0.85rem;
            padding: 0.4rem 0.8rem;
            border-radius: 8px;
        }
        .stat-card {
            background: var(--dark-card);
            border: 1px solid var(--dark-border);
            border-radius: 16px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
        }
        .stat-card:hover {
            border-color: var(--royal-purple);
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.2);
        }
        .stat-card .stat-value { font-size: 2.5rem; font-weight: 700; color: var(--royal-gold); }
        .stat-card .stat-label { color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.25rem; }
        .stat-card i { font-size: 1.5rem; color: var(--royal-purple); margin-bottom: 0.5rem; }
        .nav-card {
            background: var(--dark-card);
            border: 1px solid var(--dark-border);
            border-radius: 16px;
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            text-decoration: none;
            color: var(--text-primary);
            transition: all 0.3s ease;
        }
        .nav-card:hover {
            border-color: var(--royal-gold);
            background: rgba(124, 58, 237, 0.1);
            color: var(--text-primary);
            transform: translateY(-2px);
        }
        .nav-card i { font-size: 1.5rem; color: var(--royal-gold); }
        .nav-card .nav-label { font-weight: 600; }
        .nav-card .nav-desc { font-size: 0.85rem; color: var(--text-muted); }
        .section-title {
            color: var(--royal-gold);
            font-weight: 600;
            font-size: 1.1rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 1rem;
            margin-top: 2rem;
        }
    </style>
</head>
<body>
    <div class="dashboard-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1><i class="bi bi-building me-2"></i><%= instituteName %></h1>
                    <span class="badge-status"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> <%= subscriptionStatus %></span>
                </div>
                <a href="/" class="btn btn-outline-light"><i class="bi bi-house me-1"></i> Home</a>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <div class="section-title">Overview</div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-person-workspace d-block"></i>
                    <div class="stat-value"><%= teacherCount %></div>
                    <div class="stat-label">Teachers</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-mortarboard d-block"></i>
                    <div class="stat-value"><%= studentCount %></div>
                    <div class="stat-label">Students</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <i class="bi bi-patch-check d-block"></i>
                    <div class="stat-value"><%= approvedQuestionCount %></div>
                    <div class="stat-label">Approved Questions</div>
                </div>
            </div>
        </div>

        <div class="section-title">Manage</div>
        <div class="row g-3">
            <div class="col-md-6">
                <a href="/institute/invite" class="nav-card">
                    <i class="bi bi-person-plus"></i>
                    <div>
                        <div class="nav-label">Invite Users</div>
                        <div class="nav-desc">Add teachers and students to your institute</div>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="/institute/batches" class="nav-card">
                    <i class="bi bi-collection"></i>
                    <div>
                        <div class="nav-label">Batches</div>
                        <div class="nav-desc">Create and manage student batches</div>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="/institute/questions/upload" class="nav-card">
                    <i class="bi bi-cloud-upload"></i>
                    <div>
                        <div class="nav-label">Upload Questions</div>
                        <div class="nav-desc">Bulk upload questions via CSV or Excel</div>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="/institute/questions/review" class="nav-card">
                    <i class="bi bi-clipboard-check"></i>
                    <div>
                        <div class="nav-label">Review Questions</div>
                        <div class="nav-desc">Review and approve uploaded questions</div>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="/institute/dashboard/teacher" class="nav-card">
                    <i class="bi bi-graph-up"></i>
                    <div>
                        <div class="nav-label">Teacher Dashboard</div>
                        <div class="nav-desc">Mastery heatmaps and stuck student detection</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
