<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Institute Dashboard - Learn.ai</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="bg-alt">
    <div class="page-header">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1><i class="bi bi-building me-2"></i><%= instituteName %></h1>
                    <span class="badge-status"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> <%= subscriptionStatus %></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="/" class="btn btn-outline-light"><i class="bi bi-house me-1"></i> Home</a>
                    <form method="POST" action="/logout" style="margin:0">
                        <button type="submit" class="btn btn-outline-light"><i class="bi bi-box-arrow-right me-1"></i> Sign out</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <div class="section-title">Overview</div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="stat-card animate-in" style="animation-delay: 0.05s">
                    <i class="bi bi-person-workspace d-block"></i>
                    <div class="stat-value"><%= teacherCount %></div>
                    <div class="stat-label">Teachers</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card animate-in" style="animation-delay: 0.1s">
                    <i class="bi bi-mortarboard d-block"></i>
                    <div class="stat-value"><%= studentCount %></div>
                    <div class="stat-label">Students</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card animate-in" style="animation-delay: 0.15s">
                    <i class="bi bi-patch-check d-block"></i>
                    <div class="stat-value"><%= approvedQuestionCount %></div>
                    <div class="stat-label">Approved Questions</div>
                </div>
            </div>
        </div>

        <div class="section-title">Manage</div>
        <div class="row g-3">
            <div class="col-md-6">
                <a href="/institute/invite" class="nav-card animate-in" style="animation-delay: 0.2s">
                    <i class="bi bi-person-plus"></i>
                    <div><div class="nav-label">Invite Users</div><div class="nav-desc">Add teachers and students to your institute</div></div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="/institute/batches" class="nav-card animate-in" style="animation-delay: 0.25s">
                    <i class="bi bi-collection"></i>
                    <div><div class="nav-label">Batches</div><div class="nav-desc">Create and manage student batches</div></div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="/institute/questions/upload" class="nav-card animate-in" style="animation-delay: 0.3s">
                    <i class="bi bi-cloud-upload"></i>
                    <div><div class="nav-label">Upload Questions</div><div class="nav-desc">Bulk upload questions via CSV or Excel</div></div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="/institute/questions/review" class="nav-card animate-in" style="animation-delay: 0.35s">
                    <i class="bi bi-clipboard-check"></i>
                    <div><div class="nav-label">Review Questions</div><div class="nav-desc">Review and approve uploaded questions</div></div>
                </a>
            </div>
            <div class="col-md-6">
                <a href="/institute/dashboard/teacher" class="nav-card animate-in" style="animation-delay: 0.4s">
                    <i class="bi bi-graph-up"></i>
                    <div><div class="nav-label">Teacher Dashboard</div><div class="nav-desc">Mastery heatmaps and stuck student detection</div></div>
                </a>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
